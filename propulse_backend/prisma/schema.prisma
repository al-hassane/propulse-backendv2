model PlayerCertification {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Étape 1 : Informations d'identité (Tous paliers)
  realFullName    String
  birthDate       String
  idCardNumber    String?
  idCardPhoto     String?      // Photo d'identité (S3/CloudFront)

  //Nouveaux justificatifs selon le palier demandé
  clubProofPhoto  String?      // Requis pour GOLD (Licence, attestation)
  proContractPhoto String?     // Requis pour ELITE (Contrat pro, sélection)

  // Étape 2 : Configuration du palier et état
  tier            CertifTier   @default(PREMIUM) //Palier demandé (PREMIUM, GOLD, ELITE)
  status          CertifStatus @default(INCOMPLETE) // État du dossier sécurisé par l'Enum
  reason          String?      @db.Text          // Motif si rejeté

  // Étape 3 : Informations de paiement et passerelle
  paymentStatus   Boolean      @default(false)
  paymentMethod   String?      // "WAVE", "ORANGE_MONEY", "APPLE_IAP"
  paymentGateway  String?      // "PAYTECH" ou "APPLE_IAP"
  transactionId   String?      @unique // ID Wave/OM ou Token de reçu Apple
  originalTransactionId String? @unique // Utile pour le renouvellement automatique iOS
  paymentDate     DateTime?
  
  amount          Float        @default(1000)
  expiryDate      DateTime?    // Date d'expiration (renouvelable chaque mois)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}



model Duel {
