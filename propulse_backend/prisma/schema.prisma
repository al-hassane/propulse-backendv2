  logo        String?  @default("https://d21bhgmu32o7ny.cloudfront.net/propulse_app/chatgpt_image_2.png")  // Logo par défaut
  banner      String?  @default("https://d21bhgmu32o7ny.cloudfront.net/propulse_app/chatgpt_image_1.png") // Couverture par défaut
