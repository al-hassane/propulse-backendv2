// ==========================================
// STRUCTURE TOURNOIS (eSPORT HUB)
// ==========================================

model Tournament {
  id              Int          @id @default(autoincrement())
  title           String       // Nom du tournoi (ex: "Champions ProPulse Sénégal")
  description     String?      @db.Text
  
  // Jeu sélectionné
  game            String       // "eFootball", "FC_MOBILE", "FREE_FIRE", "COD_MOBILE", "PUBG_MOBILE"
  
  // Règles posées librement par le créateur
  rules           String       @db.Text
  
  prizePool       String?      // Cash prize ou récompenses (ex: "50 000 FCFA", "Médaille")
  maxParticipants Int          @default(16)
  
  isFree          Boolean      @default(true)
  entryFee        Float?       @default(0) // Frais d'inscription si payant
  
  // Système de modération / États
  status          String       @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, ACTIVE, FINISHED
  rejectionReason String?      @db.Text

  // Le créateur (Manager, Coach ou Admin - PAS JOUEUR)
  creatorId       Int
  creator         User         @relation("TournamentCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  // Les joueurs inscrits
  participants    TournamentParticipant[]
  matches         TournamentMatch[]

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

 
  // Ajoute ou vérifie cette ligne
  liveStream      LiveStream? @relation("TournamentLive") 

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model TournamentParticipant {
  id            Int        @id @default(autoincrement())
  tournamentId  Int
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  
  userId        Int
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status        String     @default("PENDING") // PENDING (en attente), ACCEPTED (validé), DECLINED (refusé)
  createdAt     DateTime   @default(now())

  @@unique([tournamentId, userId]) // Empêche un joueur de s'inscrire deux fois
}


model TournamentMatch {
  id            Int              @id @default(autoincrement())
  tournamentId  Int
  tournament    Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  round         Int              // 0 = premier tour, 1 = suivant, etc.
  position      Int              // position dans le round (sert à reconstituer l'arbre)

  playerAId     Int?
  playerA       User?            @relation("TournamentMatchPlayerA", fields: [playerAId], references: [id])
  playerBId     Int?
  playerB       User?            @relation("TournamentMatchPlayerB", fields: [playerBId], references: [id])


  youtubeVideoId String?

  scoreA        Int?
  scoreB        Int?

  winnerId      Int?
  winner        User?            @relation("TournamentMatchWinner", fields: [winnerId], references: [id])

  scheduledAt   DateTime?
  status        String           @default("PENDING") // PENDING, SCHEDULED, LIVE, DONE

  // Lien vers le match du round suivant où le vainqueur avancera
  nextMatchId     Int?
  nextMatch       TournamentMatch?  @relation("TournamentMatchProgression", fields: [nextMatchId], references: [id])
  previousMatches TournamentMatch[] @relation("TournamentMatchProgression")
  comments TournamentMatchComment[]

  liveStream    LiveStream?      @relation("MatchLive")

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([tournamentId, round, position])
}


// ==========================================
// SYSTÈME DE LIVE STREAMING (eSPORT)
// ==========================================

model LiveStream {
  id              Int      @id @default(autoincrement())
  title           String
  ingestEndpoint  String
  streamKey       String
  playbackUrl     String
  isLive          Boolean  @default(false)
  viewerCount     Int      @default(0)
  
  // LIEN VERS LE MATCH (Corrigé)
  matchId         Int?     @unique
  match           TournamentMatch? @relation("MatchLive", fields: [matchId], references: [id], onDelete: Cascade)

  // LIEN VERS LE TOURNOI (Corrigé - si tu veux un live global au tournoi)
  tournamentId    Int?     @unique
  tournament      Tournament?      @relation("TournamentLive", fields: [tournamentId], references: [id], onDelete: Cascade)

  streamerId      Int
  streamer        User     @relation(fields: [streamerId], references: [id])

  replayUrl       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model TournamentMatchComment {
  id        Int             @id @default(autoincrement())
  matchId   Int
  match     TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    Int
  user      User            @relation("TournamentMatchCommentAuthor", fields: [userId], references: [id])
  text      String
  createdAt DateTime        @default(now())
}



// --- NOUVEAU MODÈLE POUR LES ORGANISATEURS DE TOURNOIS ---

model Organization {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text

  logo        String?
  banner      String?

  sportCategory String?  // "football", "basketball", "volleyball", "handball", "autre"

  // Contact
  email       String?
  phone       String?
  address     String?
  country     String?

  // Détails
  objectives  String?  @db.Text
  rules       String?  @db.Text
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String? @db.Text

  members     User[]   @relation("OrganizationMembers")

  requests    OrganizationRequest[]
  invitations OrganizationInvitation[]

   posts              OrganizationPost[]
  followers          OrganizationFollow[]

  mutedBy MutedOrganization[]

  website     String?
  facebook    String?
  instagram   String?
  twitter     String?
  youtube     String?
  tiktok      String?

  privacy     String   @default("PUBLIC") // PUBLIC, COMMUNITY, PRIVATE

  ownerId     Int

  owner       User     @relation("OwnedOrganizations", fields: [ownerId], references: [id], onDelete: Cascade)

  tournaments Tournament[]
  notifications Notification[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reports     Report[]
}


// Demandes : Joueur -> Organisation (Le joueur veut entrer)
model OrganizationRequest {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  status         String       @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt      DateTime     @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// Invitations : Organisation -> Joueur (L'organisation veut le joueur)
model OrganizationInvitation {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         Int
  status         String       @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}


// --- HUB ORGANISATIONS : POSTS & INTERACTIONS AJUE---

model OrganizationPost {
  id             Int      @id @default(autoincrement())
  text           String?  @db.Text
  mediaUrl       String?
  thumbnailUrl   String?  // AJOUTE CETTE LIGNE ICI
  mediaType      String?  // "image", "video", "gif"
  audience       String   @default("everyone") // everyone, followers, mentioned
  views          Int      @default(0) // AJOUTE CETTE LIGNE
  
  // Relations
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  authorId       Int
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes          OrganizationPostLike[]
  comments       OrganizationPostComment[]

  savedBy        SavedOrganizationPost[]
  hiddenBy       HiddenOrganizationPost[]

  votes OrganizationPostVote[]

  reports        Report[]

   notifications  Notification[]
   reactions OrganizationPostReaction[]
  sharedMessages Message[] @relation("SharedOrgPosts") // Ajoutez ceci 
  
  // Sondage (Stocké en JSON pour la simplicité ou via une table)
  pollOptions    Json?    // ["Option A", "Option B"]
   pollEndsAt     DateTime?   //AJOUTE CETTE LIGNE
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model OrganizationPostLike {
  id        Int              @id @default(autoincrement())
  postId    Int
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model OrganizationPostComment {
  id        Int              @id @default(autoincrement())
  text      String           @db.Text
  postId    Int
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  // AJOUT POUR LES RÉPONSES (HIÉRARCHIE)
  parentId  Int?
  parent    OrganizationPostComment?  @relation("OrgCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   OrganizationPostComment[] @relation("OrgCommentReplies")

  // AJOUT POUR LES LIKES DE COMMENTAIRES
  likes     OrganizationCommentLike[]
}

// Table pour suivre les organisations
model OrganizationFollow {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model OrganizationCommentLike {
  id        Int                     @id @default(autoincrement())
  commentId Int
  comment   OrganizationPostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime                @default(now())

  @@unique([commentId, userId])
}

model OrganizationPostReaction {
  id        Int      @id @default(autoincrement())
  emoji     String   // Stocke l'emoji
  
  // Relations
  postId    Int
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  //TRÈS IMPORTANT : Empêche un utilisateur d'avoir 2 réactions sur le même post
  // C'est ce qui permet au "upsert" de fonctionner
  @@unique([postId, userId])
}


//Pour enregistrer les posts du Hub
model SavedOrganizationPost {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, postId])
}

// Pour masquer les posts du Hub
model HiddenOrganizationPost {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    Int
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, postId])
}



model MutedOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}


model OrganizationPostVote {
  id        Int              @id @default(autoincrement())
  postId    Int
  post      OrganizationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    Int              // L index de l option choisie (0 ou 1)
  createdAt DateTime         @default(now())

  @@unique([postId, userId]) // Un vote par personne
}

// --- AJOUTER LES RELATIONS DANS LES MODÈLES EXISTANTS ---



model ManagerCertification {
  id              Int          @id @default(autoincrement())
  userId          Int          @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Infos du dossier (Auto-remplissage)
  fullName        String?
  phoneNumber     String?
  clubName        String?
  cityRegion      String?
  position        String?
  email           String?

  tier            CertifTier   @default(PREMIUM)
  status          CertifStatus @default(INCOMPLETE)
  
  // Paiement
  paymentStatus   Boolean      @default(false)
  transactionId   String?      @unique
  paymentMethod   String?      // "PAYTECH", "WAVE", etc.
  amount          Int?
  
  // Dates de validité (Abonnement Annuel)
  expiryDate      DateTime?    
  lastReminderSent DateTime?   // Pour ne pas envoyer l'alerte 10j plusieurs fois
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}


model Stadium {
  id          Int      @id @default(autoincrement())
  osmId       String?  @unique
  name        String
  address     String?
  city        String?
  country     String?
  latitude    Float
  longitude   Float
  sport       String   @default("football")
  imageUrl    String?
  wikipedia   String?
  operator    String?
  capacity    String?
  surface     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}



// ==========================================
// MESSAGES DE CONTACT (Formulaire /contact)
// ==========================================
model ContactMessage {
  id          Int      @id @default(autoincrement())
  
  // Type de sujet : support, partner, press, jobs
  type        String   @default("support")
  
  // Expéditeur (peut être un user inscrit OU un visiteur anonyme)
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  fullName    String
  email       String
  phone       String?  // Optionnel
  
  subject     String?  // Rempli dynamiquement selon le type (company, media, role...)
  message     String   @db.Text
  
  // Gestion côté admin
  status      String   @default("NEW") // NEW, READ, REPLIED, ARCHIVED
  adminReply  String?  @db.Text
  repliedAt   DateTime?
  
  // Métadonnées utiles
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([type])
}

model BlogPost {
  id          Int      @id @default(autoincrement())
  slug        String   @unique       // url-friendly (ex: "propulse-v2")
  title       String
  subtitle    String?  @db.Text
  content     String   @db.Text       // markdown ou HTML
  coverImage  String?
  tag         String   @default("Actualité")
  readTime    Int      @default(5)
  authorName  String
  authorRole  String?
  authorBio   String?  @db.Text
  authorAvatar String?
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, publishedAt(sort: Desc)])
}


// ==========================================
// ACHATS DE KUDOS (Paiement via PayTech)
// ==========================================
model KudosPurchase {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  packId        String   // "pack_10", "pack_30", etc.
  kudosAmount   Int      // Combien de Kudos seront crédités
  amountXof     Int      // Prix en FCFA
  
  refCommand    String   @unique // Référence unique PayTech (anti-doublon IPN)
  token         String?  // Jeton PayTech (retour API)
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED
  paymentMethod String?  // "WAVE", "ORANGE_MONEY", "CARD"
  paidAt        DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

// ==========================================
// CONVERSIONS KUDOS verts ARGENT
// ==========================================
model KudosConversion {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Montants de base
  kudosConverted  Int      // Nombre de Kudos convertis (ex: 1500)
  amountFcfaBrut  Int      // Valeur brute en FCFA (ex: 30000)
  commissionPct   Int      @default(50)  // Commission ProPulse en % (ex: 50)
  commissionFcfa  Int      // Part ProPulse (ex: 15000)
  amountNetFcfa   Int      // Part créateur (ex: 15000)
  
  // Devise de sortie
  currency        String   // "XOF", "EUR", "USD"
  amountNetLocal  Float    // Montant dans la devise choisie (ex: 26.0)
  exchangeRate    Float    // Taux appliqué (ex: 577.0 pour USD)
  
  // Paiement
  paymentMethod   String?  // "WAVE", "ORANGE_MONEY", "BANK", "PAYPAL"
  paymentDetails  String?  // JSON stringifié (numéro, IBAN, email PayPal)
  
  // Statut
  status          String   @default("PENDING")  // PENDING, PROCESSING, PAID, FAILED, CANCELLED
  refCommand      String   @unique              // Référence unique (anti-doublon)
  
  // Admin
  adminNote       String?  // Motif si FAILED/CANCELLED, ou note interne
  processedAt     DateTime?
  paidAt          DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([createdAt])
}