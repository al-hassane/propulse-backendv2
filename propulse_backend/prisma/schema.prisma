// ==========================================
// PROPULSE ADD (PUBLICITÉ INTERNE)
// ==========================================

model PropulseAd {
  id          Int      @id @default(autoincrement())
  title       String   // "Offre Premium 50"
  description String?  @db.Text  // Description courte
  mediaUrl    String?  // Image ou vidéo (CloudFront)
  ctaText     String   // "J'en profite", "Découvrir", "S'inscrire"
  ctaLink     String   // deep link: propulse://shop ou /premium
  
  // Ciblage
  targetRole  String   @default("ALL")  // 'ALL', 'joueur', 'coach', 'manager'
  targetSport String   @default("ALL")  // 'ALL', 'football', 'basketball'...
  
  // Priorité et dates
  priority    Int      @default(5)      // 1 à 10 (1 = le plus visible)
  startDate   DateTime @default(now())
  endDate     DateTime
  
  // Statistiques
  impressions Int      @default(0)      // Compteur de vues
  clicks      Int      @default(0)      // Compteur de clics
  
