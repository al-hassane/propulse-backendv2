  storyId Int

  // --- AJOUTE CETTE LIGNE ---
  createdAt DateTime @default(now()) 
  // --------------------------

  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story   Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  @@unique([userId, storyId])
