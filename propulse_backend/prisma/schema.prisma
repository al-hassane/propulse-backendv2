  pollId    Int
  poll      StoryPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  // AJOUTER CES DEUX LIGNES (Relation avec l'utilisateur) :
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

