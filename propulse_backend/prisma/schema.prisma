  notifications Notification[]
  // ------------------------------

  savedBy SavedStory[]
  reports Report[]
  poll    StoryPoll? // AJOUTÉ : sondage optionnel lié à cette story

  slider  StorySlider? // Correct : pointe vers le modèle StorySlider
}

model StoryLike {
  id      Int   @id @default(autoincrement())
  userId  Int
  storyId Int
