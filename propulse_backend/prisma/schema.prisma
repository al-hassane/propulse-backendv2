  subject   String
  message   String   @db.Text
  status    String   @default("OPEN") // OPEN, PENDING, CLOSED
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}




model Story {
  id          Int      @id @default(autoincrement())
  mediaUrl    String?   // Image ou Vidéo
  type        String   // "IMAGE" ou "VIDEO"
  content     String?  @db.Text // Le texte à afficher
  background  String?  // Contiendra soit "#color" soit "#color1,#color2"
  fontStyle   String?  // <--- AJOUTE CETTE LIGNE ABSOLUMENT
  textColor String? @default("#FFFFFF")
  stickerStyle Int @default(0)
  createdAt   DateTime @default(now())
  expiresAt   DateTime // Date de fin (24h après)

  sharedInMessages Message[] @relation("SharedStories")

  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

   // --- NOUVEAUX CHAMPS CTO ---
  sharedPostId Int?     // Optionnel : ID du post si c'est un partage
  sharedPost   Post?    @relation("SharedPosts", fields: [sharedPostId], references: [id], onDelete: SetNull)
  
  mentions     StoryMention[] // Liste des personnes taguées
  // ---------------------------

  // REMPLACE audioUrl/audioDuration par une vraie relation :
  storyAudioId  Int?
  storyAudio    StoryAudio? @relation(fields: [storyAudioId], references: [id], onDelete: SetNull)


