  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  targetPostId Int?    // Sur quel post
  targetUserId Int?    // Sur quel profil
 
  actionType  String   // "VIEW_DURATION", "PROFILE_VISIT", "SEARCH_CLICK", "REPLAY"
  value       Float?   // Ex: 15.5 (secondes de vue)
 
  sport       String?  // Sport concerné pour faciliter le tri IA
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([actionType])
}






// ==========================================
//  STRUCTURE COMPÉTITION (NAVÉTANE ÉLITE)
// ==========================================

model Competition {
  id          Int      @id @default(autoincrement())
  name        String   // ex: "Navétane ProPulse"
  year        String  
  season      String  
  regions     Region[]
  createdAt   DateTime @default(now())
}

model Region {
  id            Int          @id @default(autoincrement())
  name          String      
  departments   Department[]
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id])
}

model Department {
  id       Int    @id @default(autoincrement())
  name     String
  regionId Int
  region   Region @relation(fields: [regionId], references: [id])
  zones    Zone[]
}

model Zone {
  id           Int        @id @default(autoincrement())
  name         String    
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  ascs         Asc[]      
  matches      Match[]    
  standings    Standing[]
}

model Asc {
  id          Int       @id @default(autoincrement())
  name        String    
  logo        String?
  formation   String    @default("4-4-2") // <--- AJOUTE CETTE LIGN  
  zoneId      Int
  zone        Zone      @relation(fields: [zoneId], references: [id])
 
  homeMatches Match[]   @relation("HomeTeam")
  awayMatches Match[]   @relation("AwayTeam")
  players     User[]    @relation("PlayerAsc")
  standings   Standing[]
  createdAt   DateTime @default(now())
}

model Match {
