// --- E-COMMERCE / SHOPPING ---

// 1. La Boutique (Une par utilisateur)
model Shop {
  id          Int      @id @default(autoincrement())
  name        String   // Nom de la boutique (ex: "CR7 Store", "Dakar Sport")
  description String?  @db.Text
  logo        String?  // Logo de la boutique
  cover       String?  // Image de couverture stylée
  
  // Contact spécifique pour la vente (WhatsApp, Tel)
  whatsapp    String?  
  address     String?
  city        String?

  isActive    Boolean  @default(true) // Le vendeur peut mettre sa boutique en vacances
  createdAt   DateTime @default(now())

  // --- NOUVEAUX CHAMPS PREMIUM ---
  isPremium       Boolean  @default(false) // Si true = Badge Jaune + Illimité
  premiumUntil    DateTime? // Date d'expiration de l'abonnement

  // Relation avec le propriétaire (User)
  ownerId     Int      @unique // Un user = Une boutique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  mainBrand String? // "nike" | "adidas" | "puma" | "jordan" | "other" ..

  products    Product[]
  orders      Order[]
  shopLikes   ShopLike[] 

  // Membres de la boutique (Employés/Vendeurs)
  members         ShopMember[]
  
  // Certification
  certification   ShopCertification?
}


model ShopMember {
  id        Int      @id @default(autoincrement())
  shopId    Int
  shop      Shop     @relation(fields: [shopId], references: id, onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: id)
  role      String   @default("vendeur") // vendeur, manager, etc.
  
  createdAt DateTime @default(now())
}

model ShopCertification {
  id             Int      @id @default(autoincrement())
  shopId         Int      @unique
  shop           Shop     @relation(fields: [shopId], references: id, onDelete: Cascade)
  status         String   @default("PENDING_PAYMENT") // PENDING_PAYMENT, WAITING_APPROVAL, APPROVED, REJECTED
  transactionId  String?  @unique
  paymentMethod  String?  // WAVE, ORANGE_MONEY
  expiryDate     DateTime?

  //AJOUTE CETTE LIGNE ICI
  reason         String?  @db.Text 
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// 2. Les Produits
model Product {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  price       Float
  oldPrice    Float?   // Pour faire des promos (prix barré)
  
  category    String   // "CHAUSSURES", "MAILLOTS", "EQUIPEMENTS", "ACCESSOIRES"
  condition   String   // "NEUF", "TRÈS_BON_ETAT", "BON_ETAT", "SATISFAISANT"
  
  size        String?  // "42", "L", "M"
  brand       String?  // "Nike", "Adidas"...

  // --- AJOUTE CETTE LIGNE ---
  views       Int      @default(0) // Compteur de vues, commence à 0
  // --------------------------

  discount    Int      @default(0) // Pourcentage de réduction (ex: 15 pour -15%)

  isSold      Boolean  @default(false) // Si vendu, on ne l'affiche plus ou on met un badge "VENDU"
  createdAt   DateTime @default(now())

  shopId      Int
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  images      ProductImage[] // Plusieurs images par produit
  likes       ProductLike[]  // Les gens peuvent liker un produit
  
  // Pour les commandes
  orderItems  OrderItem[]
  savedBy     SavedProduct[] 
}

// 3. Images des produits (Car un produit a besoin de plusieurs angles)
model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 4. Système de Likes pour les produits (Favoris)
model ProductLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// 5. Commandes (Optionnel pour V1, mais bien pour l'historique)
model Order {
  id          Int      @id @default(autoincrement())
  buyerId     Int      // Qui achète
  shopId      Int      // Chez qui
  total       Float
  status      String   @default("PENDING") // PENDING, CONFIRMED, DELIVERED, CANCELLED
  createdAt   DateTime @default(now())

  buyer       User     @relation(fields: [buyerId], references: [id])
  shop        Shop     @relation(fields: [shopId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  price     Float   // Prix au moment de l'achat
  
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}



// --- GESTION DES SUGGESTIONS ---
model SuggestionDismiss {
  id        Int      @id @default(autoincrement())
  userId    Int      // Celui qui refuse
  targetId  Int      // Celui qui est refusé
  createdAt DateTime @default(now())

  user      User     @relation("DismissingUser", fields: [userId], references: [id], onDelete: Cascade)
  target    User     @relation("DismissedTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId]) // On ne refuse qu'une fois
}

model AdminNotification {
  id        Int      @id @default(autoincrement())
  type      String   // "NEW_SHOP", "NEW_PRODUCT", "SHOP_UPDATE"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}


model NewsArticle {
  id          Int      @id @default(autoincrement())
  title       String
  content     String   @db.Text
  imageUrl    String   // Image de couverture
  source      String?  // Source de l'info (ex: "APS", "Wiwsport")
  category    String   // "football", "basketball", "handball", "volleyball", "manager"
  
  views       Int      @default(0)
  
  // Système de réactions (Like/Dislike)
  likes       NewsReaction[]
   // --- AJOUTEZ CES DEUX LIGNES ---
  savedBy   SavedNews[]
  notifications Notification[] // Relation inverse
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NewsReaction {
  id        Int         @id @default(autoincrement())
  type      String      // "LIKE" ou "DISLIKE"
  userId    Int
  newsId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  news      NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId]) // Un utilisateur ne peut réagir qu'une fois par article
}




model SavedNews {
  id        Int         @id @default(autoincrement())
  userId    Int
  newsId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  news      NewsArticle @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([userId, newsId]) // Empêche de doubler l'enregistrement
}


// 1. Nouveau modèle pour enregistrer les stories
model SavedStory {
  id        Int      @id @default(autoincrement())
  userId    Int
  storyId   Int
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId]) // On ne peut enregistrer qu'une fois
}

model SystemConfig {
  id                Int     @id @default(1)
  isCertifEnabled   Boolean @default(true)

  // Nouveaux champs dynamiques
  playerPrice       Int     @default(1000)      // Prix joueur
  clubPrice         Int     @default(100000)    // Prix club
  shopPrice         Int     @default(5000)    
  waveNumber        String  @default("77 000 00 00")
  orangeMoneyNumber String  @default("77 111 11 11")
}

model Broadcast {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  targetRole  String   @default("ALL") // ALL, joueur, manager
  createdAt   DateTime @default(now())

