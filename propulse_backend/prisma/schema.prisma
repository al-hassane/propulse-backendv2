  createdAt DateTime @default(now())
}



// 1. Pour définir le type de contenu dans un message
enum MediaType {
  TEXT
  IMAGE
  VIDEO
  PDF
  SHARED_POST
  AUDIO //AJOUTE CETTE LIGNE 
  SHARED_AUDIO
  SHARED_ORG_POST // Ajoutez ceci
  SHARED_STORY 
}

// 2. La "boîte" qui contient la discussion entre deux personnes
model Conversation {
  id            Int       @id @default(autoincrement())
  user1Id       Int
  user2Id       Int
  // Relations avec les utilisateurs
  user1         User      @relation("User1Conv", fields: [user1Id], references: [id], onDelete: Cascade)
  user2         User      @relation("User2Conv", fields: [user2Id], references: [id], onDelete: Cascade)
  
  messages      Message[]
  // AJOUTE CETTE LIGNE :
  chatTabs      ChatTab[] 
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt // Changera à chaque nouveau message

  // AJOUTE CETTE LIGNE
  isPinned      Boolean   @default(false)  // Pour l'utilisateur1
  isPinnedForUser2 Boolean @default(false) // Pour l'utilisateur2

  // AJOUTE CES DEUX LIGNES
  isArchivedForUser1 Boolean @default(false)
  isArchivedForUser2 Boolean @default(false)

  // Empêche d'avoir deux conversations entre les deux mêmes personnes
  @@unique([user1Id, user2Id])
}

// 3. Le message lui-même
model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  text           String?      @db.Text
  mediaUrl       String?      // Pour S3 (Image, Vidéo, PDF)
  mediaType      MediaType    @default(TEXT)
  duration       Int?

  sharedPostId   Int?
  sharedPost     Post?        @relation(fields: [sharedPostId], references: [id], onDelete: SetNull)

  sharedOrgPostId Int?    // Ajoutez ceci
  sharedOrgPost   OrganizationPost? @relation("SharedOrgPosts", fields: [sharedOrgPostId], references: [id], onDelete: SetNull) //Ajoutez ceci

  sharedAudioId  Int?
  sharedAudio    StoryAudio?  @relation("SharedAudios", fields: [sharedAudioId], references: [id], onDelete: SetNull)
  
  isRead         Boolean      @default(false)
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false) // Pour cacher un message sans le supprimer
  
  createdAt      DateTime     @default(now())

  // NOUVEAU : Contexte de la story partagée
  sharedStoryId Int?
  sharedStory   Story?  @relation("SharedStories", fields: [sharedStoryId], references: [id], onDelete: SetNull)
  
  //  NOUVEAU : Snapshot JSON des données de la story au moment du partage
  // (permet d'afficher le texte même si la story est supprimée plus tard)
  storySnapshot Json?


  //AJOUTE CES 3 LIGNES :
  replyToId      Int?         // ID du message auquel on répond
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]    @relation("MessageReplies")
  
  // Pour le signalement spam
  reports        MessageReport[]
  deletions      MessageDeletion[]
  reactions    MessageReaction[]

  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
}

// 4. Pour les signalements
model MessageReport {
  id         Int      @id @default(autoincrement())
  messageId  Int
  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  createdAt  DateTime @default(now())
}


// 4. Pour la suppression personnalisée (Supprimer pour moi)
model MessageDeletion {
  id        Int      @id @default(autoincrement())
  userId    Int
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId]) // Empêche les doublons
}




// Types de réactions possibles
enum ReactionType {
  LIKE      
  LOVE      
  LAUGH     
  SURPRISED 
  SAD       
  ANGRY     
}

// Table des réactions aux messages
model MessageReaction {
  id           Int          @id @default(autoincrement())
  messageId    Int
  userId       Int
  reactionType ReactionType
  createdAt    DateTime     @default(now())
  
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([messageId, userId]) // Un utilisateur = une réaction par message
  @@index([messageId])
  @@index([userId])
}






