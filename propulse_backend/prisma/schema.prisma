  impressionsLog PropulseAdImpression[]
  clicksLog      PropulseAdClick[]
  //NOUVEAU : Images multiples (max 10)
  images      PropulseAdImage[]

  @@index([isActive, startDate, endDate])
  @@index([targetRole, targetSport])
  @@index([priority])
}

