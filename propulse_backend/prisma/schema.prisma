generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum CertifTier {
  NONE
  PREMIUM
  GOLD
  ELITE
}

enum CertifStatus {
  INCOMPLETE
  PENDING_DOCS
  WAITING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
}



model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  // --- NOUVEAUX CHAMPS ÉLITE CV ---
  firstName       String?
  lastName        String?
  ovr             Int       @default(60) // La note globale (Calculée par l'IA ou le serveur)
  
  // sportAttributes stockera tout le "plus" spécifique (ex: { "vitesse": 90, "detente": 80 })
  sportAttributes Json?     @default("{}") 
  city            String?
  cityBackfillAttempts      Int      @default(0)  //Compteur d'échecs de reverse geocoding
  country         String?   @default("Sénégal")
  nationalities   String[]  // Spécifique PostgreSQL : permet de stocker ["Sénégal", "France"]
  
  cvCompleted     Boolean   @default(false) // Pour savoir s'il a fini de remplir son CV
  eliteCV   Json?
  // ---------------------------------
  // AJOUT DU CHAMP USERNAME (UNIQUE)
  username  String?  @unique 
  nameUpdatedAt     DateTime? // Enregistre la date du dernier changement de nom
  email           String?  @unique // Devient optionnel car on peut s'inscrire par téléphone
  phoneNumber     String?  @unique // AJOUTE CETTE LIGNE
  phoneCountryCode String?  
  password  String
  role      String   
  isVerified Boolean @default(false)
  certifTier      CertifTier       @default(NONE) //Nouveau : Palier de certification actif

  acceptedTermsAt DateTime? // Enregistre quand l'utilisateur a accepté

  // --- AJOUTE CE CHAMP POUR LA MODÉRATION ---
  suspendedUntil DateTime? 

  // --- AJOUTE CE CHAMP ---
  sport     String?  // Nullable car un manager ou un admin n'en a pas forcément
  
  // Stats
  position    String?
  club        String?
  strongFoot  String?
  height      Int?
  weight      Int?
  birthDate   DateTime?
  bio         String?  @db.Text
  
  // --- IMAGES DE PROFIL (C'est ce qu'il manquait !) ---
  coverUrl    String?  // <--- AJOUTE ÇA

  // Ajoute ou modifie cette ligne :
  avatarUrl String? @default("https://d21bhgmu32o7ny.cloudfront.net/propulse_app/default-avatar.png")
  eliteCardUrl  String?  // NOUVEAU : Photo spécifique pour le CV Elite
  eliteCardUrlLight String?  // Image mode clair (upload par l'admin)
  
  createdAt DateTime @default(now())

  // --- NOUVEAUX CHAMPS DASHBOARD ---
  xp              Int      @default(0)    // Points totaux
  level           Int      @default(1)    // Niveau (ex: Rookie, Espoir, Pro, Élite)

  // --- STREAK DE PUBLICATION (Feature #1) ---
  postStreakCount     Int       @default(0)      // Nombre de jours consécutifs avec un post
  postStreakLastDate  DateTime?                  // Date du dernier post
  postStreakMax       Int       @default(0)      // Meilleur streak jamais atteint
  postStreakBadge     String?   @default("none") // none, bronze, silver, gold, legend


  // Relations
  posts     Post[]
  likes     Like[]
  ratings   Rating[]

  // --- AJOUTE CETTE LIGNE ICI ---
  events    Event[]
  eventTicketPayments EventTicketPayment[] @relation("EventTicketBuyer")  
  
  // Système de Follow
  followedBy Follow[] @relation("following")
  following  Follow[] @relation("follower")

  // Système de Partage (Messages reçus/envoyés)
  sharesSent     Share[] @relation("sender")
  sharesReceived Share[] @relation("receiver")

  // --- AJOUTE CES 3 LIGNES ---
  savedPosts  SavedPost[]
  reports     Report[]
  hiddenPosts HiddenPost[]

 tournamentMatchesAsPlayerA  TournamentMatch[]  @relation("TournamentMatchPlayerA")
  tournamentMatchesAsPlayerB  TournamentMatch[]  @relation("TournamentMatchPlayerB")
  tournamentMatchesWon        TournamentMatch[]  @relation("TournamentMatchWinner")
  ownedOrganizations Organization[] @relation("OwnedOrganizations")
  memberOfOrganizations Organization[] @relation("OrganizationMembers")

  eventPayouts    EventPayout[] @relation("ManagerPayouts")

  reactions OrganizationPostReaction[]

  orgPostVotes OrganizationPostVote[]



  orgPosts           OrganizationPost[]
  orgPostLikes       OrganizationPostLike[]
  orgPostComments    OrganizationPostComment[]
  followedOrgs       OrganizationFollow[]

  organizationRequests    OrganizationRequest[]
  organizationInvitations OrganizationInvitation[]

  savedOrgPosts    SavedOrganizationPost[]
  hiddenOrgPosts   HiddenOrganizationPost[]

  orgCommentLikes OrganizationCommentLike[]

  mutedOrganizations MutedOrganization[] 

  // --- AJOUTE CETTE LIGNE ---
  broadcastViews    BroadcastView[]
  storyAudios   StoryAudio[]   // Tous les sons créés par ce user
  storyAudioLikes StoryAudioLike[]

  // --- AJOUTE CES 3 LIGNES POUR LA CONFIDENTIALITÉ ---
  isPrivateProfile Boolean @default(false)      // Profil privé ?
  allowMessages    String  @default("EVERYONE") // Qui peut m'écrire ? (EVERYONE, FOLLOWERS, NONE)
  showOnlineStatus Boolean @default(true)       // Montrer "En ligne" ?
  allowRatings     String  @default("EVERYONE") // AJOUTÉ : Qui peut m'évaluer ? (EVERYONE, FOLLOWERS, NONE)

  // Relation pour les bloqués
  blockedUsers     Block[] @relation("blocker")
  blockedBy        Block[] @relation("blocked")

  // --- AJOUTE CES 2 LIGNES ---
  notificationsReceived Notification[] @relation("NotifReceiver")
  notificationsSent     Notification[] @relation("NotifSender")

  // --- CHAMPS SPÉCIFIQUES MANAGER ---
  managerType         String?  // "CLUB", "ACADEMY", "SELECTION", "OTHER"
  managerOtherDetail  String?  // Si "Autre", on stocke le détail ici
  
  // Documents de vérification (Chemins des fichiers)
  verificationSelfie  String?
  verificationDocType String?  // "ID_CARD" ou "DIPLOMA"
  verificationDocFront String?
  verificationDocBack  String?
  eliteCardUpdatedAt  DateTime? // Pour suivre la dernière modification de la Pro Card
  eliteCvValidated Boolean @default(false) // Nouveau champ dédié au CV
  elitePackOpened Boolean @default(false) // Savoir si l'animation a déjà été vue
  
  // Statut
  isManagerVerified   Boolean @default(false) // Deviendra true après validation par admin
  managerRequestDate  DateTime? // Date de la demande

  managerCertification ManagerCertification?

  eventParticipations EventParticipant[]

  targets    TargetPlayer[] @relation("ManagerTargets")
  targetedBy TargetPlayer[] @relation("PlayerCible")

  ownedCommunities Community[] @relation("OwnedCommunity")
  memberOf         Community[] @relation("CommunityMembers")
  // --- AJOUTEZ CETTE LIGNE ---
  communityRequests CommunityRequest[]

  certification PlayerCertification?
  certifPayments  CertificationPayment[] //Nouveau : Lien vers l'historique des paiements de certif 

  duelVotes DuelVote[]

  ratingLikes RatingLike[]

  supportTickets SupportTicket[]
  contactMessages ContactMessage[]

  // --- AJOUTE CES LIGNES POUR LES STORIES ---
  stories        Story[]
  storyLikes     StoryLike[]
  storyComments  StoryComment[]
  storyViews     StoryView[]
  storyFlames    StoryFlame[]
  storyPollVotes StoryPollVote[]
  // --- AJOUTE CETTE LIGNE ICI ---
  pollVotes PollVote[]
  newsReactions NewsReaction[]
  savedNews SavedNews[]
  savedStories SavedStory[]
  isApplePrivateRelay Boolean @default(false) 
  // ------------------------------------------

  careerSteps CareerStep[]
  trophies   Trophy[]

  storyMentions StoryMention[]
  postMentions PostMention[]

  shopLikes       ShopLike[]
  savedProducts   SavedProduct[]
  searches SearchHistory[]

  chatTabs ChatTab[]


  mutedUsers Mute[] @relation("UserMutes")
  mutedBy    Mute[] @relation("UserMutedBy")

  viewsGiven    ProfileView[] @relation("ViewerRelation")
  viewsReceived ProfileView[] @relation("OwnerRelation")

   showProfileViews  Boolean  @default(true) 
   isDefaultStarter Boolean @default(false) // AJOUTE CETTE LIGNE
   tacticalRole     String? // <--- AJOUTE CETTE LIGNE (Ex: "GK", "DC", "MC", "ATT")
   jerseyNumber     Int?     // Numéro de maillot du joueur


  shop          Shop?          // Un user peut avoir une boutique (optionnel)
  productLikes  ProductLike[]  // Un user peut liker plein de produits
  orders        Order[]        // Un user peut passer plein de commandes
  shopMemberships  ShopMember[] 

  createdTournaments    Tournament[] @relation("TournamentCreator")
  tournamentParticipations TournamentParticipant[]

  tournamentMatchComments TournamentMatchComment[] @relation("TournamentMatchCommentAuthor")

  // --- AJOUTE CES 2 LIGNES ---
  isEmailVerified   Boolean @default(false)
  verificationToken String? @db.Text // Token temporaire pour le lien
  verificationTokenExpiresAt DateTime?
  // ---------------------------


  liveStreams LiveStream[]

  // --- AJOUTE CE CHAMP ---
  pushToken String?  // Le token Expo pour les notifs

  dismissedSuggestions SuggestionDismiss[] @relation("DismissingUser")
  dismissedBy          SuggestionDismiss[] @relation("DismissedTarget")

  // AJOUTS POUR LE PARRAINAGE
  referralCode    String?   @unique  // Son propre code (ex: MOUSSA123)
  referredById    Int?                          // L'ID de celui qui l'a parrainé
  referredBy      User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]   @relation("UserReferrals")

  behaviors UserBehavior[]
   // ... tes champs actuels
  aiProScore      Float?    @default(0)   // Note de 0 à 100 calculée par l'IA
  aiTalentGroup   String?   // "TOP_ESPOIR", "SOLIDE", "EN_PROGRESSION"
  trustIndex      Float     @default(1.0) // Indice de confiance (pour le Predictive Rating)

  ascId   Int?
  asc     Asc?   @relation("PlayerAsc", fields: [ascId], references: [id])
  matchComments MatchComment[]

  latitude        Float?    // Position Nord/Sud
  longitude       Float?    // Position Est/Ouest
  lastLocUpdate   DateTime? // Pour savoir si le joueur est toujours dans cette zone
  lastActiveAt    DateTime?   //  NOUVEAU : Dernière connexion/action
  proximityRadius Int     @default(10)  //  Rayon de recherche en km (10 par défaut)
  batteryLevel    Int?      
  
  // NOUVELLES RELATIONS
  proximityAlertsSent   ProximityAlert[] @relation("ProximitySender")
  proximityAlertsReceived ProximityAlert[] @relation("ProximityReceiver")

  careerInteractions CareerTeaserInteraction[]

  sentMessages       Message[]
  messageReports     MessageReport[]
  conversationsAsU1  Conversation[]  @relation("User1Conv")
  conversationsAsU2  Conversation[]  @relation("User2Conv")
  messageReactions  MessageReaction[]


  trainingSessions TrainingSession[]
  trainingFeedbacks TrainingFeedback[] @relation("ReviewerRelation")
  targetedInSessions TrainingTarget[] @relation("TargetRelation")
  trainingStreak    Int @default(0)
  lastTrainingAt    DateTime?

  postViews UserPostView[]
  trainingReactions TrainingReaction[]

  referralProcessed Boolean  @default(false) //AJOUTE BIEN CETTE LIGNE

  cvPayments CVPayment[]  // AJOUTE CETTE LIGNE

  // AJOUTE ICI AVANT LA DERNIÈRE ACCOLADE
  propulseAdImpressions PropulseAdImpression[]
  propulseAdClicks      PropulseAdClick[]

  // AJOUTER CETTE LIGNE (Relation vers la table de sessions) :
  userSessions UserSession[]

  // STREAK KUDOS (connexion quotidienne)
  kudosStreakCount      Int       @default(0)   // Nombre de jours consécutifs
  kudosStreakLastAt     DateTime?              // Dernière connexion qui a donné un Kudos
  kudosStreakMax        Int       @default(0)   // Meilleur streak jamais atteint


  kudosPurchases    KudosPurchase[]
  kudosConversions  KudosConversion[]
  kudosReceivedBalance  Int  @default(0)  //Solde de Kudos REÇUS (à convertir en argent)

  storySliderVotes StorySliderVote[] // AJOUTÉ
  kudosGiven    Kudos[]
  kudosBalance      Int      @default(15)
  lastDailyKudosAt  DateTime @default(now())

}


model Post {
  id          Int      @id @default(autoincrement())
  imageUrl    String?
  thumbnailUrl String?
  media       PostMedia[]
  description String?  @db.Text

  width       Int?
  height      Int?

  views       Int      @default(0)

  sport          String?

  location    String?
  tags        String?
  aiTags String?

  createdAt   DateTime @default(now())

  isArchived       Boolean @default(false)
  commentsDisabled Boolean @default(false)

  // NOUVEAU CHAMP : type de média, calculé une seule fois à la création
  mediaType   MediaType @default(IMAGE)

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  likes       Like[]
  ratings     Rating[]
  shares      Share[]

  savedBy     SavedPost[]
  reports     Report[]
  hiddenBy    HiddenPost[]

  notifications Notification[]
  mentions PostMention[]

  storiesWithThisPost Story[] @relation("SharedPosts")

  communityId Int?
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  duelsAsPost1 Duel[] @relation("DuelPost1")
  duelsAsPost2 Duel[] @relation("DuelPost2")

  hasPoll        Boolean   @default(false)
  pollQuestion   String?
  votes          PollVote[]
  hideAiTags Boolean @default(false)

  viewedBy UserPostView[]
  sharedMessages Message[]
  kudos    Kudos[]

  audioId     Int?
  audio       StoryAudio? @relation(fields: [audioId], references: [id], onDelete: SetNull)

  // NOUVEL INDEX : couvre exactement le filtre de GET /users/:id/posts
  @@index([userId, isArchived, communityId, mediaType, createdAt])
}

model PostMedia {
  id     Int    @id @default(autoincrement())
  url    String
  postId Int
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}

// 2. Nouveau modèle pour enregistrer les votes des Reels
model PollVote {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  option    String   // "YES" / "NO" ou "P1" / "P2"
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId]) // Un utilisateur ne vote qu'une fois par Reel
}


// --- NOUVELLES TABLES ---

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId]) // Un user ne peut liker qu'une seule fois un post
}


model Kudos {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  tier      String?  // "lion", "flamme", "or"... (null pour les anciens Kudos)
  cost      Int      @default(0) // coût payé (0 pour les anciens)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId, createdAt])
}

model Rating {
  id        Int      @id @default(autoincrement())
  score     Int      // Note sur 10
  comment   String?  @db.Text
  userId    Int
  postId    Int

  // ... champs existants
  likes         RatingLike[] // Relation avec les likes de commentaires
  // ...


  // --- AJOUT POUR LES RÉPONSES ---
  parentId  Int?     // Si rempli, c'est une réponse
  parent    Rating?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Rating[] @relation("CommentReplies")
  // -------------------------------

  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  // --- AJOUTE CETTE LIGNE ---
  notifications Notification[]
}

model RatingLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  ratingId  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, ratingId]) // Un utilisateur ne like qu'une fois
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
   
  //AJOUTE CETTE LIGNE :
  notifLevel  String   @default("CUSTOM") // ALL, CUSTOM, NONE
  // --- AJOUTE CETTE LIGNE ---
  status      String   @default("ACCEPTED") // Valeurs: "ACCEPTED" ou "PENDING"
  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// Pour partager un post à un ami dans l'app
model Share {
  id         Int      @id @default(autoincrement())
  postId     Int
  senderId   Int
  receiverId Int
  message    String?
  
  post       Post     @relation(fields: [postId], references: [id])
  sender     User     @relation("sender", fields: [senderId], references: [id])
  receiver   User     @relation("receiver", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}


// Ajoute ça à la fin de ton fichier schema.prisma

// 1. Pour les posts enregistrés
model SavedPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId]) // Un user ne peut sauvegarder qu'une fois le même post
}

// 2. MODIFIER le modèle Report existant (ajoute storyId)
model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  postId     Int?     // Devient optionnel
  storyId    Int?     // AJOUT : Optionnel pour les stories
   // AJOUTE CETTE LIGNE POUR LES PROFILS :
  targetUserId Int? 
   organizationId Int?  

   //AJOUTE CES DEUX LIGNES
  organizationPostId Int?             
  organizationPost   OrganizationPost? @relation(fields: [organizationPostId], references: [id])


  reason     String
  details    String?  @db.Text
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())

  reporter   User     @relation(fields: [reporterId], references: [id])
  post       Post?    @relation(fields: [postId], references: [id])
  story      Story?   @relation(fields: [storyId], references: [id]) // AJOUT
  organization Organization? @relation(fields: [organizationId], references: [id])
}

// 3. Pour "Ça ne m'intéresse pas" (Posts masqués)
model HiddenPost {
  id        Int      @id @default(autoincrement())
  userId    Int
  postId    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

// --- AJOUTE CETTE TABLE À LA FIN DU FICHIER ---
model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker   User     @relation("blocker", fields: [blockerId], references: [id])
  blocked   User     @relation("blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  message       String?  @db.Text

  receiverId Int
  receiver   User @relation("NotifReceiver", fields: [receiverId], references: [id])

  senderId   Int
  sender     User @relation("NotifSender", fields: [senderId], references: [id])

  postId     Int?
  post       Post? @relation(fields: [postId], references: [id])

  eventId   Int?
  event     Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  orgPostId     Int?
  orgPost       OrganizationPost? @relation(fields: [orgPostId], references: [id], onDelete: Cascade)

  ratingId   Int?     
  rating     Rating?  @relation(fields: [ratingId], references: [id])

  requestStatus String @default("PENDING")

  communityId   Int?
  community     Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  storyId       Int?
  story         Story?   @relation(fields: [storyId], references: [id], onDelete: Cascade)

  newsId    Int?
  news      NewsArticle? @relation(fields: [newsId], references: [id], onDelete: Cascade)

  trainingId   Int?
  training     TrainingSession? @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  //  CES 3 LIGNES SONT LE FIX
  @@index([receiverId, createdAt(sort: Desc)])
  @@index([receiverId, type])
  @@index([receiverId, isRead])
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  description String?  @db.Text
  
  // VÉRIFIE QUE CES LIGNES SONT BIEN LÀ :
  date        DateTime // <--- C'EST CA QUI BLOQUE
  ageCategory String?
  isFree      Boolean  @default(true)
  price       Float?
  currency    String?
  country     String?
  city        String?
  location    String
  imageUrl    String?
  
  status      String   @default("UPCOMING")
  createdAt   DateTime @default(now())

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  //AJOUT Relation avec la communauté/club
  communityId Int?     
  community   Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)

   payout        EventPayout?
   ticketPayments  EventTicketPayment[]

  participants EventParticipant[]
  notifications Notification[]
}

//NOUVEAU : Informations de payout pour un événement payant
model EventPayout {
  id              Int      @id @default(autoincrement())
  
  // Relation 1-1 avec l'événement
  eventId         Int      @unique
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  // Manager qui reçoit l'argent
  managerId       Int
  manager         User     @relation("ManagerPayouts", fields: [managerId], references: [id], onDelete: Cascade)
  
  // Méthode choisie : "WAVE", "ORANGE_MONEY", "CARD"
  paymentMethod   String
  
  // Pour Wave / Orange Money
  payoutPhone     String?  // Ex: "771234567"
  payoutFullName  String?  // Nom complet du titulaire
  
  // Pour Carte bancaire ( on stocke UNIQUEMENT un token, jamais les données brutes)
  cardToken       String?  // Token PayTech/Stripe (jamais le numéro)
  cardLast4       String?  // "4242" pour affichage
  cardBrand       String?  // "visa", "mastercard"
  
  // Métadonnées
  isVerified      Boolean  @default(false) // Vérifié par PayTech/Stripe ?
  isActive        Boolean  @default(true)  // Actif pour les prochains events ?
  saveForNext     Boolean  @default(false) // Sauvegarder pour les prochains événements ?
  
  // Statistiques
  totalReceived   Float    @default(0)     // Total reçu (via IPN)
  totalPayouts    Float    @default(0)     // Total versé au manager
  platformFee     Float    @default(0)     // Commission ProPulse
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([managerId])
  @@index([paymentMethod])
}

model EventTicketPayment {
  id              Int      @id @default(autoincrement())
  buyerId         Int
  buyer           User     @relation("EventTicketBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  eventId         Int
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  amountXof       Int
  currency        String   @default("XOF")
  platformFeePct  Int      @default(10)
  platformFeeXof  Int      @default(0)
  netForManager   Int      @default(0)
  refCommand      String   @unique
  token           String?
  status          String   @default("PENDING")
  paymentMethod   String?
  paidAt          DateTime?
  payoutStatus    String   @default("PENDING")
  payoutRef       String?
  payoutAt        DateTime?
  payoutError     String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([buyerId, eventId])
  @@index([status, paidAt])
  @@index([eventId, status])
}

// Ajoute cette table pour lier les joueurs aux événements
model EventParticipant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  createdAt DateTime @default(now())

