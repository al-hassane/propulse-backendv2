// 🚀 ROUTE PROXIMITÉ ALERTE (CTO VERSION FINALE : DISTANCE + ANTI-SPAM)
// ==========================================
app.post('/ai/proximity-alert', async (req, res) => {
  const { new_user_id, new_user_sport, lat, lng } = req.body;
  
  if (!new_user_id || lat === undefined || lng === undefined) {
    return res.status(400).json({ action: "NO_ACTION", reason: "missing_parameters" });
  }

  const senderId = parseInt(new_user_id);
  const senderSport = (new_user_sport || "football").toLowerCase().trim();
  
  try {
    const myLat = parseFloat(lat);
    const myLng = parseFloat(lng);
    const maxDistance = 10; 
    
    // 1. RÉCUPÉRER TOUS LES JOUEURS (AVEC TOUS LES CHAMPS NÉCESSAIRES)
    const allUsers = await prisma.user.findMany({
      where: {
        latitude: { not: null },
        longitude: { not: null },
        id: { not: senderId }, 
        role: 'joueur',
        OR: [
          { suspendedUntil: null },
          { suspendedUntil: { lt: new Date() } }
        ]
      },
      select: {
        id: true,
        fullName: true,
        avatarUrl: true,
        sport: true,
        latitude: true,  // 🟢 Gardé pour le calcul
        longitude: true, // 🟢 Gardé pour le calcul
        lastActiveAt: true,
        pushToken: true,
        certification: { select: { status: true } }
      }
    });
    
    const toRad = (value) => (value * Math.PI) / 180;
    const R = 6371; 
    const twelveHoursAgo = new Date(Date.now() - 12 * 60 * 60 * 1000);
    const activeThreshold = new Date(Date.now() - 15 * 60 * 1000); // 15min
    
    const compatibleTargets = [];
    
    for (const user of allUsers) {
      // A. CALCUL DISTANCE (Ta méthode qui fonctionne)
      const userLat = parseFloat(user.latitude);
      const userLng = parseFloat(user.longitude);
      if (isNaN(userLat) || isNaN(userLng)) continue;
      
      const dLat = toRad(userLat - myLat);
      const dLon = toRad(userLng - myLng);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(toRad(myLat)) * Math.cos(toRad(userLat)) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const distance = R * c;
      
      // B. FILTRE DISTANCE ET SPORT
      if (distance > maxDistance) continue;
      
      const userSport = (user.sport || "football").toLowerCase().trim();
      if (userSport !== senderSport) continue;

      // 🛡️ C. VÉRIFICATION COOLDOWN 12H (ANTI-SPAM)
      const recentAlert = await prisma.proximityAlert.findFirst({
        where: {
          senderId: senderId,
          receiverId: user.id,
          createdAt: { gt: twelveHoursAgo } // Est-ce qu'on l'a déjà prévenu il y a moins de 12h ?
        }
      });
      
      if (recentAlert) continue; // Si oui, on passe au suivant sans rien envoyer
      
      // 🟢 D. LE FIX MAGIQUE : UPSERT (Met à jour la date si existe, sinon crée)
      // Cela réinitialise le timer de 12h à MAINTENANT.
      await prisma.proximityAlert.upsert({
        where: { senderId_receiverId: { senderId, receiverId: user.id } },
        update: { createdAt: new Date() },
        create: { senderId, receiverId: user.id }
      }).catch(e => console.log("Doublon géré"));

      const isActive = user.lastActiveAt && new Date(user.lastActiveAt) > activeThreshold;
      compatibleTargets.push({
        ...user,
        distance: parseFloat(distance.toFixed(2)),
        isActive
      });
    }
    
    if (compatibleTargets.length === 0) {
      return res.json({ action: "NO_ACTION", reason: "no_new_targets" });
    }
    
    // 3. ENVOI DES PUSH ET NOTIFS
    let pushMessages = [];
    for (const target of compatibleTargets) {
      // Notif In-App
      await prisma.notification.create({
        data: {
          type: "PROXIMITY_ALERT",
          receiverId: target.id,
          senderId: senderId,
          message: `Un talent ${senderSport} est à ${target.distance}km de vous ! 📍`,
        }
      }).catch(e => {});

      // Notif Push
      if (target.pushToken && Expo.isExpoPushToken(target.pushToken)) {
        pushMessages.push({
          to: target.pushToken,
          sound: 'default',
          title: target.isActive ? '🎯 Talent à proximité !' : '📍 Talent proche',
          body: `Un talent ${senderSport} est à ${target.distance}km de vous ! 📍`,
          data: { type: "PROXIMITY_ALERT", senderId: senderId },
          priority: target.isActive ? 'high' : 'normal'
        });
      }
    }
    
    const chunks = expo.chunkPushNotifications(pushMessages);
    for (const chunk of chunks) {
      try { await expo.sendPushNotificationsAsync(chunk); } catch (e) {}
    }
    
    return res.json({ action: "SEND_PUSH", count: compatibleTargets.length });
    
  } catch (error) {
    console.error("❌ Erreur Proximité Alert:", error);
    return res.status(500).json({ action: "ERROR" });
  }
});




