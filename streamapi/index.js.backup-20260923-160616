// ✅ CORRECTIF CTO : Rejoindre un club avec Notification au proprio
app.post('/communities/:id/join', async (req, res) => {
  const { userId } = req.body;
  const clubId = parseInt(req.params.id);

  try {
    const user = await prisma.user.findUnique({ where: { id: parseInt(userId) } });
    
    if (!user) {
      return res.status(404).json({ error: "Utilisateur non trouvé" });
    }

    // 🛡️ MODIFICATION : On bloque UNIQUEMENT les managers
    // Tous les autres rôles (joueur, coach, gaming, créateur, etc.) peuvent rejoindre
    if (user.role === 'manager') {
        return res.status(403).json({ error: "Les managers ne peuvent pas rejoindre un club en tant que membre." });
    }

    const club = await prisma.community.findUnique({ where: { id: clubId } });
    
    if (!club) {
      return res.status(404).json({ error: "Club introuvable" });
    }

    if (club.isPrivate) {
      // 1. On crée la demande dans la base de données
      await prisma.communityRequest.create({
        data: { communityId: clubId, userId: parseInt(userId) }
      });

      // 🟢 2. NOTIFICATION POUR LE PROPRIÉTAIRE (Propulse Official)
      await createNotification(
        "REQUEST", 
        userId,           // L'expéditeur
        club.ownerId,     // Le destinataire (le proprio du club)
        null,             // postId
        null,             // ratingId
        null,             // eventId
        `souhaite rejoindre votre club "${club.name}" 🏟️`, // Le message
        null,             // storyId
        null,             // newsId
        clubId            // communityId (pour rediriger vers le club)
      );

      return res.json({ status: "PENDING", message: "Demande envoyée" });
    } else {
      // Cas public : On connecte direct
      await prisma.community.update({
        where: { id: clubId },
        data: { members: { connect: { id: parseInt(userId) } } }
      });
      return res.json({ status: "ACCEPTED", message: "Bienvenue !" });
    }
  } catch (error) {
    console.error("Erreur Join Club:", error);
    res.status(400).json({ error: "Vous avez déjà une demande en attente ou une erreur est survenue." });
  }
});

