// 🛡️ FONCTION VERROU PARRAINAGE (PRO)
async function grantReferralBonus(userId) {
  try {
    const user = await prisma.user.findUnique({
      where: { id: userId }
    });

    // On ne paie que si : 
    // 1. Il y a un parrain
    // 2. On n'a pas déjà payé (verrou referralProcessed)
    // 3. L'email est vérifié
    if (user && user.referredById && !user.referralProcessed && user.isEmailVerified) {
      
      // Sécurité supplémentaire : Si c'est un Joueur ou Coach, il DOIT avoir choisi son sport
      const isProRole = user.role === 'joueur' || user.role === 'coach';
      if (isProRole && !user.sport) {
        console.log(`⏳ Bonus en attente pour l'user ${userId} (Sport non choisi)`);
        return; 
      }

      // 🏆 TOUT EST OK : On libère les points dans une transaction sécurisée
      await prisma.$transaction([
        // A. Donner l'XP au parrain
        prisma.user.update({
          where: { id: user.referredById },
          data: { xp: { increment: 100 } }
        }),
        // B. Verrouiller le bonus pour cet invité (ne plus jamais le payer)
        prisma.user.update({
          where: { id: user.id },
          data: { referralProcessed: true }
        })
      ]);

      // C. Notifier le parrain
      await createNotification(
        "ADMIN", user.id, user.referredById, null, null, null, 
        `Félicitations ! Ton ami ${user.fullName} a activé son compte. Tu gagnes +100 XP ! 🏆`
      );

      console.log(`💰 Bonus 100 XP payé au parrain ${user.referredById}`);
    }
  } catch (e) {
    console.error("❌ Erreur grantReferralBonus:", e);
  }
}

