app.get('/products/recommendations/:userId', async (req, res) => {
  const userId = parseInt(req.params.userId);

  try {
    // 1. Récupérer les 5 derniers mots recherchés par l'utilisateur
    const lastSearches = await prisma.searchHistory.findMany({
      where: { userId },
      orderBy: { createdAt: 'desc' },
      take: 5,
      select: { query: true }
    });

    if (lastSearches.length === 0) {
      // Si pas d'historique, on renvoie les produits les plus likés ou récents par défaut
      const fallbacks = await prisma.product.findMany({
        where: { isSold: false },
        take: 20,
        include: { images: true, shop: true },
        orderBy: { views: 'desc' }
      });
      return res.json(fallbacks);
    }

    // 2. Créer une condition de recherche basée sur ces mots
    const queries = lastSearches.map(s => s.query);
    
    const recommended = await prisma.product.findMany({
      where: {
        isSold: false,
        OR: queries.map(q => ({
          OR: [
            { title: { contains: q, mode: 'insensitive' } },
            { description: { contains: q, mode: 'insensitive' } },
            { category: { contains: q, mode: 'insensitive' } },
            { brand: { contains: q, mode: 'insensitive' } }
          ]
        }))
      },
      include: { images: true, shop: true },
      take: 30,
      orderBy: { createdAt: 'desc' }
    });

    res.json(recommended);
  } catch (e) {
