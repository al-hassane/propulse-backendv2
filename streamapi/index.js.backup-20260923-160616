app.get('/users', async (req, res) => {
  const currentUserId = req.query.userId ? parseInt(req.query.userId) : null;
  const search = req.query.search ? req.query.search.trim() : "";
  const sportQuery = req.query.sport;
  const roleQuery = req.query.role;
  
  // 🟢 PAGINATION : Seulement si page est explicitement fourni
  const page = req.query.page ? parseInt(req.query.page) : null;
  const limit = req.query.limit ? parseInt(req.query.limit) : 20;
  
  const usePagination = page !== null && !isNaN(page);
  const skip = usePagination ? (page - 1) * limit : 0;

  try {
    // 1. CONDITION DE BASE : Sécurité (Blocages)
    let whereCondition = {
      AND: [
        { role: { not: 'admin' } }
      ]
    };

    // FILTRE PAR RÔLE
    if (roleQuery && roleQuery !== 'ALL') { 
      whereCondition.AND.push({ role: { equals: roleQuery, mode: 'insensitive' } }); 
    }

    // FILTRE PAR SPORT
    if (sportQuery && sportQuery !== 'Tous') {
      whereCondition.AND.push({ sport: { equals: sportQuery, mode: 'insensitive' } });
    }

    if (currentUserId) {
      whereCondition.AND.push({
        blockedBy: { none: { blockerId: currentUserId } },
        blockedUsers: { none: { blockedId: currentUserId } }
      });
    }

    // 2. LOGIQUE DE RECHERCHE SÉMANTIQUE
    if (search !== "") {
      const searchLower = search.toLowerCase();

      const smartMapping = {
        'attaquant': 'football', 'milieu': 'football', 'defenseur': 'football', 'défenseur': 'football', 'gardien': 'football',
        'meneur': 'basketball', 'arriere': 'basketball', 'arrière': 'basketball', 'ailier': 'basketball', 'ailier fort': 'basketball', 'pivot': 'basketball',
        'demi-centre': 'handball', 'demi centre': 'handball',
        'passeur': 'volleyball', 'receptionneur': 'volleyball', 'réceptionneur': 'volleyball', 'pointu': 'volleyball', 'central': 'volleyball', 'libero': 'volleyball', 'libéro': 'volleyball'
      };

      const detectedSport = smartMapping[searchLower];

      if (detectedSport) {
        whereCondition.AND.push({
          OR: [
            { position: { contains: search, mode: 'insensitive' } },
            { fullName: { contains: search, mode: 'insensitive' } }
          ]
        });
      } else {
        whereCondition.AND.push({
          OR: [
            { fullName: { contains: search, mode: 'insensitive' } },
            { sport: { contains: search, mode: 'insensitive' } },
            { position: { contains: search, mode: 'insensitive' } },
            { club: { contains: search, mode: 'insensitive' } }
          ]
        });
      }
    }

    // 🟢 COMPTER LE TOTAL (seulement si pagination)
    const totalCount = usePagination ? await prisma.user.count({ where: whereCondition }) : 0;

    // 🟢 RÉCUPÉRER LES DONNÉES
    const users = await prisma.user.findMany({
      where: whereCondition,
      take: usePagination ? limit : undefined,
      skip: usePagination ? skip : undefined,
      include: {
        certification: true,
        posts: {
          where: { isArchived: false },
          include: { ratings: true },
          take: usePagination ? 5 : undefined
        }
      },
      orderBy: [
        { isVerified: 'desc' },
        { isManagerVerified: 'desc' },
        { createdAt: 'desc' },
        { level: 'desc' },
        { xp: 'desc' }
      ]
    });

    // 4. CALCUL DES SCORES
    const usersWithStats = users.map(user => {
      let totalScore = 0;
      let totalRatingsCount = 0;

      user.posts.forEach(post => {
        post.ratings.forEach(rating => {
          if (rating.score > 0) { 
            totalScore += rating.score;
            totalRatingsCount++;
          }
        });
      });

      const avg = totalRatingsCount > 0 
        ? parseFloat((totalScore / totalRatingsCount).toFixed(1)) 
        : 0;

      const isElite = (
        user.certification?.status === 'APPROVED' ||
        user.isManagerVerified === true ||
        user.isVerified === true
      ) ? 1 : 0;

      return {
        id: user.id,
        fullName: user.fullName,
        avatarUrl: user.avatarUrl,
        coverUrl: user.coverUrl,
        role: user.role,
        level: user.level,
        xp: user.xp,
        position: user.position,
        club: user.club,
        sport: user.sport,
        averageRating: avg,
        isElite: isElite,
        timestamp: new Date(user.createdAt).getTime(),
        certification: user.certification,
        isVerified: user.isVerified,
         certifTier: user.certifTier, // 🟢 Ajoute cette ligne
        isManagerVerified: user.isManagerVerified,
        managerType: user.managerType,
        isCertified: user.certification?.status === 'APPROVED' ? 1 : 0,
      };
    });

    // 5. TRI
    const sortedResults = usersWithStats.sort((a, b) => {
      if (b.isElite !== a.isElite) return b.isElite - a.isElite;
      if (b.level !== a.level) return b.level - a.level;
      if (b.averageRating !== a.averageRating) return b.averageRating - a.averageRating;
      if (b.xp !== a.xp) return b.xp - a.xp;
      if (b.timestamp !== a.timestamp) return b.timestamp - a.timestamp;
      return a.fullName.localeCompare(b.fullName);
    });

    // 🟢 RENVOI : Format différent selon pagination ou non
    if (usePagination) {
      res.json({
        data: sortedResults,
        pagination: {
          page: page,
          limit: limit,
          total: totalCount,
          hasMore: skip + sortedResults.length < totalCount
        }
      });
    } else {
      // Format original (liste simple) pour rétrocompatibilité
      res.json(sortedResults);
    }

  } catch (error) {
    console.error("❌ Erreur Recherche intelligente:", error);
    res.status(500).json({ error: "Erreur lors de la recherche." });
  }
});


// Fonction utilitaire pour récupérer les IDs à exclure (blocages)
async function getBlockedIds(userId, viewerId) {
  const ids = new Set();
  const targetIds = [userId];
  if (viewerId) targetIds.push(viewerId);

  const blocks = await prisma.block.findMany({
    where: {
      OR: [
        { blockerId: { in: targetIds } },
        { blockedId: { in: targetIds } }
      ]
    },
    select: { blockerId: true, blockedId: true }
  });

  blocks.forEach(b => {
    ids.add(b.blockerId);
    ids.add(b.blockedId);
  });
  return Array.from(ids);
}

