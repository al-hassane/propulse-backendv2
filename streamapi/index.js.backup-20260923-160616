    if (existing) {
      // Si déjà liké, on supprime le like
      await prisma.storyAudioLike.delete({ where: { id: existing.id } });
      const audio = await prisma.storyAudio.update({
        where: { id: storyAudioId },
        data: { likesCount: { decrement: 1 } },
      });
      return res.json({ liked: false, likesCount: audio.likesCount });
    }

    // Sinon, on crée le like
    await prisma.storyAudioLike.create({
      data: { userId: parsedUserId, storyAudioId },
    });
    const audio = await prisma.storyAudio.update({
      where: { id: storyAudioId },
      data: { likesCount: { increment: 1 } },
    });
    return res.json({ liked: true, likesCount: audio.likesCount });
  } catch (e) {
    res.status(500).json({ error: "Erreur lors du like" });
  }
});

