// 💬 SYSTÈME DE MESSAGERIE ÉLITE (V2)
// ==========================================

// 1. Créer ou récupérer une conversation
// 1. Créer ou récupérer une conversation
app.post('/conversations', async (req, res) => {
  const { user1Id, user2Id } = req.body; // user1Id est celui qui clique (l'expéditeur)

  try {
    const u1 = parseInt(user1Id);
    const u2 = parseInt(user2Id);

    // 🟢 1. On récupère les deux utilisateurs pour vérifier leurs rôles et réglages
    const sender = await prisma.user.findUnique({ where: { id: u1 } });
    const receiver = await prisma.user.findUnique({ where: { id: u2 } });

    if (!sender || !receiver) {
      return res.status(404).json({ error: "Utilisateur non trouvé." });
    }

    // 🟢 2. SÉCURITÉ : Blocage des Managers
    if (sender.role === 'manager' || receiver.role === 'manager') {
      return res.status(403).json({ error: "L'accès à la messagerie est réservé aux talents et coachs." });
    }

    // 🟢 3. SÉCURITÉ : Respect de la vie privée du destinataire (Privacy Settings)
    
    // Cas A : Le destinataire n'accepte que les gens qu'il suit
    if (receiver.allowMessages === 'FOLLOWED') {
       const isFollowedByReceiver = await prisma.follow.findFirst({
         where: { followerId: receiver.id, followingId: sender.id, status: 'ACCEPTED' }
       });
       if (!isFollowedByReceiver) return res.status(403).json({ error: "PRIVACY_FOLLOWED" });
    }

    // Cas B : Le destinataire n'accepte que les utilisateurs certifiés (Badge bleu)
    if (receiver.allowMessages === 'VERIFIED' && !sender.isVerified) {
       return res.status(403).json({ error: "PRIVACY_VERIFIED" });
    }

    // 🟢 4. CRÉATION OU RÉCUPÉRATION SÉCURISÉE (Logique anti-crash Race Condition)
    const id1 = Math.min(u1, u2);
    const id2 = Math.max(u1, u2);

    let conversation;

    // A. On tente de trouver la conversation existante
    conversation = await prisma.conversation.findUnique({
      where: { user1Id_user2Id: { user1Id: id1, user2Id: id2 } },
      include: {
        user1: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } },
        user2: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } }
      }
    });

    // B. Si elle n'existe pas, on tente de la créer
    if (!conversation) {
      try {
        conversation = await prisma.conversation.create({
          data: { user1Id: id1, user2Id: id2 },
          include: {
            user1: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } },
            user2: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } }
          }
        });
      } catch (createError) {
        // C. Si la création échoue (erreur P2002), c'est qu'elle a été créée par l'autre utilisateur
        // au même millième de seconde. On se contente alors de la récupérer.
        if (createError.code === 'P2002') {
          conversation = await prisma.conversation.findUnique({
            where: { user1Id_user2Id: { user1Id: id1, user2Id: id2 } },
            include: {
              user1: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } },
              user2: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } }
            }
          });
        } else {
          throw createError; // Si c'est une autre erreur, on la renvoie
        }
      }
    }

