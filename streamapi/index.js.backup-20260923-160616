// DIRECT SHARE : SUGGESTIONS DE DESTINATAIRES (SÉCURISÉ)
// =========================================================================
app.get('/users/:id/share-targets', async (req, res) => {
  const userId = parseInt(req.params.id);
  const search = req.query.search ? req.query.search.trim() : "";

  if (isNaN(userId)) {
    return res.status(400).json({ error: "ID utilisateur invalide" });
  }

  try {
    // Récupérer les bloqués et bloquants
    const blocks = await prisma.block.findMany({
      where: {
        OR: [
          { blockerId: userId },
          { blockedId: userId }
        ]
      },
      select: { blockerId: true, blockedId: true }
    });

    const blockedUserIds = blocks.map(b => b.blockerId === userId ? b.blockedId : b.blockerId);

    // Abonnements mutuels
    const following = await prisma.follow.findMany({
      where: { followerId: userId, status: 'ACCEPTED' },
      select: { followingId: true }
    });
    const followingIds = following.map(f => f.followingId);

    const mutualFollowers = await prisma.follow.findMany({
      where: {
        followerId: { in: followingIds },
        followingId: userId,
        status: 'ACCEPTED'
      },
      select: { followerId: true }
    });
    const mutualIds = mutualFollowers.map(f => f.followerId);

    let andConditions = [
      { id: { not: userId } },
      { id: { notIn: blockedUserIds } },
      { role: { notIn: ['admin', 'manager'] } }
    ];

    if (search !== "") {
      andConditions.push({
        fullName: { contains: search, mode: 'insensitive' }
      });
    } else {
      andConditions.push({
        id: { in: mutualIds }
      });
    }

    const targets = await prisma.user.findMany({
      where: { AND: andConditions },
      select: {
        id: true,
        fullName: true,
        avatarUrl: true,
        role: true,
        sport: true,
        isVerified: true
      },
      take: 15
    });

    if (search === "" && targets.length < 10) {
      const currentIds = targets.map(t => t.id);
      const simpleFollowers = await prisma.user.findMany({
        where: {
          id: { notIn: [userId, ...currentIds, ...blockedUserIds] },
          role: { notIn: ['admin', 'manager'] },
          followedBy: { some: { followerId: userId, status: 'ACCEPTED' } }
        },
        select: {
          id: true,
          fullName: true,
          avatarUrl: true,
          role: true,
          sport: true,
          isVerified: true
        },
        take: 10 - targets.length
      });
      targets.push(...simpleFollowers);
    }

    res.json(targets);
  } catch (error) {
    console.error("Erreur targets de partage:", error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});

// =========================================================================
// DIRECT SHARE : PARTAGER LE POST À PLUSIEURS AMIS D'UN COUP
// =========================================================================
app.post('/messages/share', async (req, res) => {

  const { senderId, targetUserIds, postId, text, message } = req.body;
  const finalShareText = text || message; // Utilise l'un ou l'autre s'il est présent


  const sId = parseInt(senderId);
  const pId = parseInt(postId);

  if (isNaN(sId) || isNaN(pId) || !Array.isArray(targetUserIds) || targetUserIds.length === 0) {
    return res.status(400).json({ error: "Données de partage invalides." });
  }

  try {
    const sender = await prisma.user.findUnique({ where: { id: sId } });
    if (!sender || sender.role === 'manager') {
      return res.status(403).json({ error: "Action non autorisée." });
    }

    const activeBlocks = await prisma.block.findMany({
      where: {
        OR: [
          { blockerId: sId },
          { blockedId: sId }
        ]
      },
      select: { blockerId: true, blockedId: true }
    });
    const blockedIds = activeBlocks.map(b => b.blockerId === sId ? b.blockedId : b.blockerId);

    const postToShare = await prisma.post.findUnique({
      where: { id: pId },
      include: { user: { select: { fullName: true } } }
    });
    if (!postToShare) {
      return res.status(404).json({ error: "Publication introuvable." });
    }

    const results = [];

    await prisma.$transaction(async (tx) => {
      for (const targetId of targetUserIds) {
        const tId = parseInt(targetId);
        if (isNaN(tId) || tId === sId || blockedIds.includes(tId)) continue;

        const id1 = Math.min(sId, tId);
        const id2 = Math.max(sId, tId);

        const conversation = await tx.conversation.upsert({
          where: { user1Id_user2Id: { user1Id: id1, user2Id: id2 } },
          update: { 
            updatedAt: new Date(),
            isArchivedForUser1: false,
            isArchivedForUser2: false
          },
          create: { 
            user1Id: id1, 
            user2Id: id2,
            updatedAt: new Date()
          }
        });

        const message = await tx.message.create({
          data: {
            conversationId: conversation.id,
            senderId: sId,
            text: finalShareText && finalShareText.trim() !== "" ? finalShareText.trim() : null,
            mediaType: 'SHARED_POST',
            sharedPostId: pId
          },
          include: { 
            sender: { select: { id: true, fullName: true, avatarUrl: true } } 
          }
        });

        results.push({ targetId: tId, message, conversationId: conversation.id });
      }
    });

    for (const resItem of results) {
      io.emit(`unread_count_${resItem.targetId}`, { updated: true });
      io.emit(`unread_count_${sId}`, { updated: true });

      io.to(`conv_${resItem.conversationId}`).emit('new_private_message', resItem.message);


      const postAuthor = postToShare.user.fullName;
      const pushMsg = finalShareText && finalShareText.trim() !== "" 
        ? finalShareText.trim() 
        : `Vous a partagé la publication de ${postAuthor}. 📲`;

      await createNotification(
        "MESSAGE",
        sId,
        resItem.targetId,
        null, null, null,
        pushMsg,
        null, null, null,
        resItem.conversationId
      );
    }

    res.status(201).json({ success: true, count: results.length });
  } catch (error) {
    console.error("Erreur partage de masse:", error);
    res.status(500).json({ error: "Échec de l'envoi." });
  }
});


