app.get('/stadiums/nearby', async (req, res) => {
  const { lat, lng, radius } = req.query;

  if (!lat || !lng) {
    return res.status(400).json({ error: "lat et lng obligatoires" });
  }

  const myLat = parseFloat(lat);
  const myLng = parseFloat(lng);
  const radiusMeters = parseFloat(radius) || 5000;
  const radiusKm = radiusMeters / 1000;

  try {
    // 🟢 1. Récupère tous les stades en cache
    const allStadiums = await prisma.stadium.findMany();

    // 🟢 2. Filtre par distance
    const nearby = allStadiums
      .map((s) => {
        if (s.latitude == null || s.longitude == null) return null;
        return {
          ...s,
          distance: calculateDistanceKm(myLat, myLng, s.latitude, s.longitude),
        };
      })
      .filter((s) => s !== null && s.distance <= radiusKm)
      .sort((a, b) => a.distance - b.distance);

    console.log(`📍 ${nearby.length} stades en BDD dans ${radiusKm}km`);

    // 🟢 FILTRE : supprime les images des stades au nom trop générique
    nearby.forEach((s) => {
      const trimmed = (s.name || '').trim().toLowerCase();
      if (trimmed === 'stade' || trimmed === 'stadium') {
        s.imageUrl = null;
      }
    });

    // 🟢 3. Si peu de stades, on va chercher sur Overpass (avec retry)
    if (nearby.length < 5) {
      console.log(`🌐 Fallback Overpass (${nearby.length} < 5)...`);

      let overpassElements = [];

      // 🟢 3 tentatives avec timeouts progressifs
      for (let attempt = 1; attempt <= 3; attempt++) {
        try {
          const query = `
            [out:json][timeout:60];
            (
              node["leisure"="stadium"](around:${radiusMeters},${myLat},${myLng});
              way["leisure"="stadium"](around:${radiusMeters},${myLat},${myLng});
              relation["leisure"="stadium"](around:${radiusMeters},${myLat},${myLng});
              node["building"="stadium"](around:${radiusMeters},${myLat},${myLng});
              way["building"="stadium"](around:${radiusMeters},${myLat},${myLng});
            );
            out center tags;
          `;

          console.log(`   📡 Tentative ${attempt}/3...`);

          const overpassRes = await axios.post(
            'https://overpass-api.de/api/interpreter',
            query,
            {
              headers: {
                'Content-Type': 'text/plain',
                'User-Agent': 'ProPulseApp/1.0 (contact@propulse-sn.com)',
              },
              timeout: 90000,
            }
          );

          overpassElements = overpassRes.data?.elements || [];
          console.log(`   ✅ Overpass OK: ${overpassElements.length} éléments`);
          break;

        } catch (e) {
          console.log(`   ⚠️ Tentative ${attempt} échouée: ${e.message}`);
          if (attempt < 3) {
            await new Promise(r => setTimeout(r, 2000));
          }
        }
      }

      // 🟢 4. Si on a reçu quelque chose, on l'insère en BDD
      if (overpassElements.length > 0) {
        for (const el of overpassElements) {
          const elLat = el.lat ?? el.center?.lat;
          const elLon = el.lon ?? el.center?.lon;
          if (!elLat || !elLon) continue;

          const osmId = `${el.type}/${el.id}`;
