app.get('/manager/stats/:id', async (req, res) => {
  const managerId = parseInt(req.params.id);

  try {
    // 1. CROISSANCE DES ABONNÉS (Total cumulé pour voir une courbe qui monte)
    const followers = await prisma.follow.findMany({
      where: { followingId: managerId },
      orderBy: { createdAt: 'asc' }
    });

    const weeks = [0, 0, 0, 0, 0, 0];
    const now = new Date();
    
    followers.forEach(f => {
      const date = new Date(f.createdAt);
      // Calcul du nombre de semaines d'écart par rapport à aujourd'hui
      const diffInTime = now.getTime() - date.getTime();
      const diffInDays = diffInTime / (1000 * 3600 * 24);
      const weekIndex = Math.floor(diffInDays / 7);

      if (weekIndex < 6) {
        weeks[5 - weekIndex]++;
      }
    });

    // 2. ENGAGEMENT ÉVÉNEMENTS (On s'assure de prendre les événements qui ont des participants)
    const events = await prisma.event.findMany({
      where: { userId: managerId },
      take: 5,
      orderBy: { createdAt: 'desc' },
      include: {
        _count: { select: { participants: true } }
      }
    });

    // Si pas d'événements, on renvoie des labels vides propres
    const eventStats = {
      labels: events.length > 0 ? events.map(e => e.title.substring(0, 8) + '.') : ["Aucun"],
      data: events.length > 0 ? events.map(e => e._count.participants) : [0]
    };

    // 3. VOLUME DE SCOUTING (Groupement par date pour la Heatmap)
    const targets = await prisma.targetPlayer.findMany({
      where: { managerId: managerId },
      select: { createdAt: true }
    });

    // La Heatmap a besoin de points agrégés par jour
    const targetCounts = {};
    targets.forEach(t => {
      const day = t.createdAt.toISOString().split('T')[0];
      targetCounts[day] = (targetCounts[day] || 0) + 1;
    });

    const targetStats = Object.keys(targetCounts).map(date => ({
      date: date,
      count: targetCounts[date]
    }));

    res.json({
      followers: weeks,
      events: eventStats,
      targets: targetStats
    });

  } catch (error) {
    console.error("Erreur Dashboard Stats:", error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});


