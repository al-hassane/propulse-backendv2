    // 1. Vérifier si la sauvegarde existe déjà
    const existing = await prisma.savedPost.findUnique({
      where: { userId_postId: { userId: uId, postId } }
    });

    if (existing) {
      await prisma.savedPost.delete({ where: { id: existing.id } });
      return res.json({ saved: false, message: "Retiré des enregistrements" });
    } else {
      // 2. 🛡️ SÉCURITÉ : Vérifier si le post existe avant de créer le lien
      const postExists = await prisma.post.findUnique({ where: { id: postId } });
      if (!postExists) {
        return res.status(404).json({ error: "Cette publication n'existe plus." });
      }

      // 3. Création de la sauvegarde
      await prisma.savedPost.create({ 
        data: { userId: uId, postId } 
      });
      
      // Enregistrer la vue forte pour l'IA
      await prisma.userPostView.upsert({
        where: { userId_postId: { userId: uId, postId } },
        update: { seenAt: new Date(), action: 'SAVE' },
        create: { userId: uId, postId, action: 'SAVE' }
      });
      
      res.json({ saved: true, message: "Enregistré dans ta collection" });
    }
  } catch (e) {
    // 🛡️ Capturer l'erreur de lien mort (si post supprimé pile au milieu)
    if (e.code === 'P2003' || e.code === 'P2025') {
      return res.status(404).json({ error: "Cette publication n'existe plus." });
    }
    console.error("❌ Erreur SAVE:", e.message);
    res.status(500).json({ error: "Erreur serveur lors de la sauvegarde" });
  }
});


