  }
});

// =========================================================================
// 🟢 HELPER : Vérifie que le nom du stade correspond bien au titre Wikipedia
// =========================================================================
function matchesStadiumName(stadiumName, wikiTitle) {
  const normalize = (str) => str
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '') // enlève les accents
    .replace(/[^a-z0-9 ]/g, ' ')     // enlève la ponctuation
    .replace(/\s+/g, ' ')
    .trim();

  const name = normalize(stadiumName);
  const title = normalize(wikiTitle);

  // On prend le mot le plus long de chaque (souvent le nom propre du stade)
  const nameWords = name.split(' ').filter(w => w.length > 3);
  const titleWords = title.split(' ').filter(w => w.length > 3);

  // Match si au moins 1 mot significatif est commun
  return nameWords.some(nw => titleWords.some(tw => tw === nw || tw.includes(nw) || nw.includes(tw)));
}


// =========================================================================
// 🌍 [CRON] BACKFILL VILLES — Traite les users avec city=null
// ⏰ Toutes les 10 minutes — respecte la limite Nominatim (1 req/sec)
// 🛡️ Skip les users après 3 échecs pour éviter les boucles infinies
// =========================================================================
cron.schedule('*/10 * * * *', async () => {
  try {
    const users = await prisma.user.findMany({
      where: {
        latitude: { not: null },
        longitude: { not: null },
        city: null,
        cityBackfillAttempts: { lt: 3 }, // 🟢 Skip ceux qui ont déjà échoué 3 fois
      },
      select: {
        id: true,
        latitude: true,
        longitude: true,
        cityBackfillAttempts: true,
      },
      take: 50, // 🟢 15 users × 1.2s = 18s → largement sous les 10 min
    });

    if (users.length === 0) return;

    console.log(`🌍 [CRON] Backfill villes : ${users.length} users à traiter`);

    let updated = 0;
    let abandoned = 0;

    for (const u of users) {
      try {
        const geo = await reverseGeocode(u.latitude, u.longitude).catch(() => null);

        if (geo?.city) {
          // ✅ Succès → on remplit la ville et on reset le compteur
          await prisma.user.update({
            where: { id: u.id },
            data: {
              city: geo.city,
              country: geo.country || undefined,
              cityBackfillAttempts: 0,
            },
          });
          updated++;
          console.log(`✅ [CRON] User #${u.id} → ${geo.city}, ${geo.country || ''}`);

        } else {
          // ⚠️ Échec → on incrémente le compteur
          const result = await prisma.user.update({
            where: { id: u.id },
            data: { cityBackfillAttempts: { increment: 1 } },
            select: { cityBackfillAttempts: true },
          });

          // 🟢 Après 3 échecs, on abandonne avec "Inconnu"
          if (result.cityBackfillAttempts >= 3) {
            await prisma.user.update({
              where: { id: u.id },
              data: { city: "Inconnu" },
            });
            abandoned++;
            console.log(`❌ [CRON] User #${u.id} abandonné après 3 essais → "Inconnu"`);
          } else {
            console.log(
              `⚠️ [CRON] User #${u.id} pas de ville trouvée (essai ${result.cityBackfillAttempts}/3)`
            );
          }
        }
      } catch (e) {
        console.log(`⚠️ [CRON] User #${u.id} erreur:`, e.message);
      }

      // 🟢 1.2s entre chaque appel (limite Nominatim : 1 req/sec)
      await new Promise((r) => setTimeout(r, 2000));  // 🟢 1.2s → 2s (plus safe)
    }

    console.log(
      `✅ [CRON] Backfill terminé : ${updated} réussis, ${abandoned} abandonnés`
    );
  } catch (e) {
    console.log(`❌ [CRON] Erreur backfill:`, e.message);
  }
});


