// --- MISE À JOUR DE LA DATE DE NAISSANCE (SÉCURITÉ & CONFORMITÉ) ---
app.put('/users/:id/birthdate', async (req, res) => {
  const { id } = req.params;
  const { birthDate } = req.body; // Format attendu: "YYYY-MM-DD"

  if (!birthDate) {
    return res.status(400).json({ error: "La date de naissance est obligatoire." });
  }

  try {
    const selectedDate = new Date(birthDate);
    const today = new Date();
    
    // Calcul de l'âge
    let age = today.getFullYear() - selectedDate.getFullYear();
    const m = today.getMonth() - selectedDate.getMonth();
    if (m < 0 || (m === 0 && today.getDate() < selectedDate.getDate())) {
      age--;
    }

    // 🛑 RÈGLE DE SÉCURITÉ : Minimum 13 ans pour les réseaux sociaux
    if (age < 13) {
      return res.status(403).json({ 
        error: "AGE_RESTRICTION", 
        message: "Désolé, tu dois avoir au moins 13 ans pour utiliser ProPulse." 
      });
    }

    // Mise à jour de l'utilisateur
    const updatedUser = await prisma.user.update({
      where: { id: parseInt(id) },
      data: { birthDate: selectedDate },
    });

    res.json({ 
      message: "Âge vérifié avec succès !", 
      user: updatedUser 
    });

  } catch (error) {
    console.error("Erreur birthDate:", error);
    res.status(500).json({ error: "Erreur lors de l'enregistrement de la date de naissance." });
  }
});



