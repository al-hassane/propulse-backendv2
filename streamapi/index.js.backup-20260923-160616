// --- 2. ALGORITHME DE SÉLECTION (Corrigé pour le Sport) ---
async function generateDailyDuel() {
  console.log("🤖 Lancement de l'algorithme de rotation des duels...");

  try {
    const allSports = ['football', 'basketball', 'handball', 'volleyball'];

    // 1. Trouver le sport du DERNIER duel créé
    const lastDuel = await prisma.duel.findFirst({
      orderBy: { createdAt: 'desc' },
      select: { sport: true, post1Id: true, post2Id: true }
    });

    let nextSportIndex = 0;
    if (lastDuel) {
      const lastIndex = allSports.indexOf(lastDuel.sport);
      nextSportIndex = (lastIndex + 1) % allSports.length;
    }

    // ============================================================
    // 🟢 HELPER : Récupère les IDs à exclure selon un délai donné (en jours)
    // ============================================================
    const getExcludedIds = async (daysAgo) => {
      const since = new Date();
      since.setDate(since.getDate() - daysAgo);

      const recentDuels = await prisma.duel.findMany({
        where: { createdAt: { gte: since } },
        include: { post1: true, post2: true }
      });

      const set = new Set();
      recentDuels.forEach(d => {
        set.add(d.post1.userId);
        set.add(d.post2.userId);
      });
      return Array.from(set);
    };

    // ============================================================
    // 🟢 HELPER : Cherche les joueurs pour un sport avec une liste d'exclus
    // ============================================================
    const findPlayersForSport = async (sport, excludedIds) => {
      return await prisma.user.findMany({
        where: {
          role: 'joueur',
          sport: sport,
          certification: { status: 'APPROVED' },
          ...(excludedIds.length > 0 ? { id: { notIn: excludedIds } } : {}),
          posts: { some: { imageUrl: { contains: '.mp4' } } }
        },
        include: {
          posts: {
            where: { imageUrl: { contains: '.mp4' } },
            include: { ratings: true },
            orderBy: { createdAt: 'desc' }
          }
        }
      });
    };

    // ============================================================
    // 🟢 HELPER : Essaie de former un duel (avec exclusion des joueurs du duel précédent)
    // ============================================================
    const tryFindDuel = async (excludedIds) => {
      for (let i = 0; i < allSports.length; i++) {
        const currentIdx = (nextSportIndex + i) % allSports.length;
        const sportToTest = allSports[currentIdx];

        const players = await findPlayersForSport(sportToTest, excludedIds);

        if (players.length >= 2) {
          return { sport: sportToTest, players };
        }
      }
      return null;
    };

    // ============================================================
    // 🟢 HELPER : Récupère les 2 joueurs du duel le plus récent
    // (utile pour le fallback final "on évite juste le duel d'hier")
    // ============================================================
    const getLastDuelPlayerIds = () => {
      if (!lastDuel) return [];
      return [lastDuel.post1Id, lastDuel.post2Id]; // Ce sont des POST IDs
    };

    // Récupérer les USER IDs du dernier duel
    let lastDuelUserIds = [];
    if (lastDuel) {
      const [p1, p2] = await Promise.all([
        prisma.post.findUnique({ where: { id: lastDuel.post1Id }, select: { userId: true } }),
        prisma.post.findUnique({ where: { id: lastDuel.post2Id }, select: { userId: true } })
      ]);
      if (p1) lastDuelUserIds.push(p1.userId);
      if (p2) lastDuelUserIds.push(p2.userId);
    }

    let selectedSport = "";
    let eligiblePlayers = [];

    // ============================================================
    // 🟢 PASSE 1 : Règle stricte — cooldown 14 jours
    // ============================================================
    const strictExcludedIds = await getExcludedIds(14);
    console.log(`📋 [PASSE 1] ${strictExcludedIds.length} users en cooldown 14j`);

    const strictResult = await tryFindDuel(strictExcludedIds);
    if (strictResult) {
      selectedSport = strictResult.sport;
      eligiblePlayers = strictResult.players;
      console.log(`✅ [PASSE 1] Joueurs trouvés pour ${selectedSport}`);
    }

    // ============================================================
    // 🟢 PASSE 2 : Cooldown 3 jours pour faire en sorte que sa marche bien 
    // ============================================================
    if (eligiblePlayers.length < 2) {
      console.log(`⚠️ [PASSE 1] Échec. Tentative cooldown 3j...`);
      const softExcludedIds = await getExcludedIds(3);
      console.log(`📋 [PASSE 2] ${softExcludedIds.length} users en cooldown 3j`);

      const softResult = await tryFindDuel(softExcludedIds);
      if (softResult) {
        selectedSport = softResult.sport;
        eligiblePlayers = softResult.players;
        console.log(`🔄 [PASSE 2] Joueurs trouvés pour ${selectedSport}`);
      }
    }

    // ============================================================
    // 🟢 PASSE 3 : Cooldown 1 jour (anti-répétition immédiate)
    // ============================================================
    if (eligiblePlayers.length < 2) {
      console.log(`⚠️ [PASSE 2] Échec. Tentative cooldown 1j...`);
      const lastResortExcludedIds = await getExcludedIds(1);
      console.log(`📋 [PASSE 3] ${lastResortExcludedIds.length} users en cooldown 1j`);

      const lastResortResult = await tryFindDuel(lastResortExcludedIds);
      if (lastResortResult) {
        selectedSport = lastResortResult.sport;
        eligiblePlayers = lastResortResult.players;
        console.log(`🚨 [PASSE 3] Joueurs trouvés pour ${selectedSport}`);
      }
    }

    // ============================================================
    // 🟢 PASSE 4 (ULTIME) : On ignore TOUT sauf le duel d'HIER
    // → permet la rotation quotidienne avec 2 certifiés
    // ============================================================
    if (eligiblePlayers.length < 2) {
      console.log(`⚠️ [PASSE 3] Échec. Dernier recours : tous les certifiés sauf ceux du duel précédent`);

      // On exclut uniquement les joueurs du dernier duel
      const ultimateResult = await tryFindDuel(lastDuelUserIds);

      if (ultimateResult) {
        selectedSport = ultimateResult.sport;
        eligiblePlayers = ultimateResult.players;
        console.log(`🆘 [PASSE 4] Joueurs trouvés pour ${selectedSport} (rotation forcée)`);
      }
    }

    // ============================================================
    // 🟢 PASSE 5 (ULTIME ULTIME) : On autorise tout, même rejouer les mêmes
    // (Filet de sécurité absolu : il faut un duel chaque jour)
    // ============================================================
    if (eligiblePlayers.length < 2) {
      console.log(`🆘 [PASSE 4] Échec. On autorise la répétition (il faut un duel !)`);

      const absoluteResult = await tryFindDuel([]); // Aucune exclusion

      if (absoluteResult) {
        selectedSport = absoluteResult.sport;
        eligiblePlayers = absoluteResult.players;
        console.log(`💥 [PASSE 5] Joueurs trouvés pour ${selectedSport} (répétition autorisée)`);
      }
    }

    if (eligiblePlayers.length < 2) {
      return console.log("❌ Aucun sport n'a assez de joueurs certifiés. Duel annulé.");
    }

    // ============================================================
    // 🟢 CALCUL DES SCORES ET SÉLECTION
    // ============================================================
    const playersWithScore = eligiblePlayers.map(p => {
      let score = 0, count = 0;
      p.posts.forEach(post => post.ratings.forEach(r => { score += r.score; count++; }));
      return {
        userId: p.id,
        avg: count > 0 ? score / count : 0,
        postId: p.posts[0].id
      };
    });

    // 🔥 Trier par score (les meilleurs d'abord)
    playersWithScore.sort((a, b) => b.avg - a.avg);

    // 🎲 Prendre les 5 meilleurs, puis mélanger pour la surprise
    const candidatePool = playersWithScore.slice(0, 5);
    const shuffled = candidatePool.sort(() => 0.5 - Math.random());
    const finalSelection = shuffled.slice(0, 2);

    // 🛡️ Éviter de sélectionner deux fois le même post (sécurité anti-bug)
    if (finalSelection[0].postId === finalSelection[1].postId) {
      console.log("⚠️ Bug détecté : même post sélectionné 2 fois. Annulation.");
      return;
    }

    // ============================================================
    // 🟢 CRÉATION DU DUEL
    // ============================================================
    const expiry = new Date();
    expiry.setHours(24, 0, 0, 0); // Expire à minuit

    await prisma.duel.create({
      data: {
        post1Id: finalSelection[0].postId,
        post2Id: finalSelection[1].postId,
        expiresAt: expiry,
        sport: selectedSport
      }
    });

