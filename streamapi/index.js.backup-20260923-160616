app.put('/products/:id', productUpload, async (req, res) => {
  const { id } = req.params;
  // 🟢 On récupère "discount" ici aussi
  const { title, description, price, oldPrice, category, condition, size, brand, deletedImageIds, discount } = req.body;

  try {
    // 🟢 On récupère le produit avec son shop pour vérifier le statut Premium
    const productData = await prisma.product.findUnique({
        where: { id: parseInt(id) },
        include: { shop: true }
    });

    if (!productData) return res.status(404).json({ error: "Produit introuvable" });

    // 🟢 SÉCURITÉ : Réduction autorisée uniquement pour les Premium
    const finalDiscount = productData.shop.isPremium ? (parseInt(discount) || 0) : 0;

    const updateData = {
      title, 
      description, 
      category, 
      condition, 
      size, 
      brand,
      price: parseFloat(price),
      oldPrice: oldPrice ? parseFloat(oldPrice) : null,
      discount: finalDiscount // 🟢 On met à jour le discount
    };

    await prisma.product.update({
      where: { id: parseInt(id) },
      data: updateData
    });

    // 2. Suppression des anciennes images (Inchangé)
    if (deletedImageIds) {
