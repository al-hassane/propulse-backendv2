// --- 3. SUIVRE UN UTILISATEUR (MODIFIÉ POUR PRIVÉ) ---
app.post('/users/:id/follow', async (req, res) => {
  const targetId = parseInt(req.params.id); // Celui qu'on veut suivre
  const { followerId } = req.body; // Moi

  try {
    const fId = parseInt(followerId);

    // 1. On vérifie si on suit déjà (ou si demande déjà envoyée)
    const existing = await prisma.follow.findUnique({
      where: { followerId_followingId: { followerId: fId, followingId: targetId } }
    });

    if (existing) {
      // Si on reclique, on annule tout (unfollow ou annulation demande)
      // 🛡️ On utilise deleteMany au lieu de delete pour éviter les erreurs si déjà supprimé par ailleurs
      await prisma.follow.deleteMany({ 
        where: { followerId: fId, followingId: targetId } 
      });
      return res.json({ status: "NONE", message: "Abonnement annulé" });
    } else {
      // 2. On récupère la cible pour voir si son profil est PRIVÉ
      const targetUser = await prisma.user.findUnique({ where: { id: targetId } });
      
      if (!targetUser) return res.status(404).json({ error: "Utilisateur introuvable" });

      let initialStatus = "ACCEPTED";
      let msg = "Abonné !";

      if (targetUser.isPrivateProfile) {
        initialStatus = "PENDING";
        msg = "Demande envoyée";
      }

      // 🛡️ SOLUTION ÉLITE : On utilise upsert au lieu de create pour éviter l'erreur P2002 (Unique constraint)
      // Cela crée l'abonnement s'il n'existe pas, ou le met à jour s'il existe déjà.
      await prisma.follow.upsert({
        where: { 
          followerId_followingId: { followerId: fId, followingId: targetId } 
        },
        update: { status: initialStatus }, // Si existant (rare), on met juste à jour le statut
        create: { 
          followerId: fId, 
          followingId: targetId,
          status: initialStatus,
          notifLevel: "ALL" 
        }
      });

      // --- NOTIFICATION ---
      const type = targetUser.isPrivateProfile ? "REQUEST" : "FOLLOW";
      await createNotification(type, fId, targetId, null);
      
      res.json({ status: initialStatus, message: msg });
    }
  } catch (error) {
    console.error("Erreur Follow API:", error);
    res.status(500).json({ error: "Erreur lors de l'opération d'abonnement" });
  }
});

