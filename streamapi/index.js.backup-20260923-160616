app.get('/stadiums/search', async (req, res) => {
  const { q, lat, lng, radius } = req.query;

  console.log(`\n🏟️ === RECHERCHE STADE "${q}" ===`);

  if (!q || String(q).trim().length < 2) {
    return res.json([]);
  }

  const search = String(q).trim();
  const maxDistanceKm = radius ? parseFloat(radius) / 1000 : 50;
  const myLat = lat ? parseFloat(lat) : null;
  const myLng = lng ? parseFloat(lng) : null;

  const words = search.split(/\s+/).filter((w) => w.length > 1);

  const searchLocal = () =>
    prisma.stadium.findMany({
      where: {
        AND: words.map((word) => ({
          OR: [
            { name: { contains: word, mode: 'insensitive' } },
            { city: { contains: word, mode: 'insensitive' } },
          ],
        })),
      },
      take: 30,
    });

  try {
    // 1️⃣ Recherche locale
    let stadiums = await searchLocal();
    console.log(`   📍 Local: ${stadiums.length} stades trouvés`);

    // 2️⃣ Calcul distance
    const withDistance = stadiums.map((s) => ({
      ...s,
      distance:
        myLat !== null && myLng !== null
          ? calculateDistanceKm(myLat, myLng, s.latitude, s.longitude)
          : null,
    }));

    const inRange =
      myLat !== null
        ? withDistance.filter((r) => r.distance !== null && r.distance <= maxDistanceKm)
        : withDistance;

    console.log(`   📏 In-range: ${inRange.length} stades`);

    // 3️⃣ Fallback Nominatim si rien en local
    if (inRange.length === 0) {
      console.log(`   🌐 Fallback Nominatim...`);
      try {
        const params = {
          q: myLat !== null ? search : `${search} stadium`,
          format: 'json',
          limit: '10',
          addressdetails: '1',
          extratags: '1',
        };

        if (myLat !== null && myLng !== null) {
          const delta = Math.max(maxDistanceKm / 111, 0.5);
          params.viewbox = `${myLng - delta},${myLat + delta},${myLng + delta},${myLat - delta}`;
          params.bounded = '1';
        }

        const url =
          `https://nominatim.openstreetmap.org/search?` + new URLSearchParams(params);

        const response = await axios.get(url, {
          headers: { 'User-Agent': 'ProPulseApp/1.0 (contact@propulse-sn.com)' },
          timeout: 8000,
        });

        const fetched = response.data || [];
        const upserted = [];
        console.log(`   🌐 Nominatim: ${fetched.length} résultats bruts`);

        for (const item of fetched) {
          const osmId = `${item.osm_type}/${item.osm_id}`;
          const name = item.name || item.display_name?.split(',')[0];
          if (!name) continue;

          if (typeof isSportsVenue === 'function' && !isSportsVenue(item)) continue;

          try {
            const stadium = await prisma.stadium.upsert({
              where: { osmId },
              update: {},
              create: {
                osmId,
                name,
                address: item.display_name || null,
                city: item.address?.city || item.address?.town || item.address?.state || null,
                country: item.address?.country || null,
                latitude: parseFloat(item.lat),
                longitude: parseFloat(item.lon),
                sport: detectSportFromName(item.name || item.display_name || ''),
                wikipedia: item.extratags?.wikipedia || null,
              },
            });
            upserted.push(stadium);
          } catch (e) {
            console.log('   ⚠️ Upsert:', e.message);
          }
        }

        stadiums = upserted.length > 0 ? upserted : await searchLocal();
        console.log(`   ✅ Après Nominatim: ${stadiums.length} stades`);
      } catch (e) {
        console.error('   ❌ Erreur Nominatim:', e.message);
      }
    }

    // 4️⃣ 🟢 ENRICHISSEMENT WIKIPEDIA (avec User-Agent + fallback par nom)
    const WIKI_HEADERS = {
      'User-Agent': 'ProPulseApp/1.0 (contact@propulse-sn.com)',
      'Accept': 'application/json',
    };

    console.log(`\n📦 AVANT Promise.all: ${stadiums.length} stades, ${stadiums.filter(s => s.wikipedia).length} avec wiki`);

    const finalResults = await Promise.all(
      stadiums.map(async (s) => {
        console.log(`   → "${s.name}" | img=${s.imageUrl ? 'OUI' : 'NON'} | wiki=${s.wikipedia || 'NON'}`);

        let imageUrl = s.imageUrl ?? null;
        let wikiLink = s.wikipedia ?? null;

        if (!imageUrl) {
          try {
            // A) Via le lien Wikipedia en BDD
            if (s.wikipedia) {
              const [lang, ...titleParts] = s.wikipedia.split(':');
              const title = titleParts.join(':');
              console.log(`      🔎 Wiki ${lang} "${title}"...`);

              const wikiRes = await axios.get(
                `https://${lang}.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(title)}`,
                { timeout: 6000, headers: WIKI_HEADERS }
              ).catch((err) => {
                console.log(`      ⚠️ Wiki ${lang} échec:`, err.response?.status || err.message);
                return null;
              });

              imageUrl =
                wikiRes?.data?.thumbnail?.source ||
                wikiRes?.data?.originalimage?.source ||
                null;

              if (imageUrl) console.log(`      ✅ Image trouvée via lien`);
            }

            // B) Fallback par NOM si toujours rien
            if (!imageUrl) {
              const wikiName = s.name.replace(/\s+/g, '_');
              console.log(`      🔎 Wiki fallback "${wikiName}"...`);

              let wikiRes = await axios.get(
                `https://fr.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(wikiName)}`,
                { timeout: 6000, headers: WIKI_HEADERS }
              ).catch((err) => {
                console.log(`      ⚠️ Wiki FR "${wikiName}":`, err.response?.status || err.message);
                return null;
              });

              if (!wikiRes?.data?.thumbnail) {
                wikiRes = await axios.get(
                  `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(wikiName)}`,
                  { timeout: 6000, headers: WIKI_HEADERS }
                ).catch(() => null);
              }

              imageUrl =
                wikiRes?.data?.thumbnail?.source ||
                wikiRes?.data?.originalimage?.source ||
                null;

              if (!wikiLink && wikiRes?.data?.content_urls?.desktop?.page) {
                wikiLink = wikiRes.data.content_urls.desktop.page;
              }

              if (imageUrl) console.log(`      ✅ Image trouvée via nom`);
            }

            // C) Cache BDD
            if (imageUrl) {
              await prisma.stadium.update({
                where: { id: s.id },
                data: {
                  imageUrl,
                  ...(wikiLink ? { wikipedia: wikiLink } : {}),
                },
              });
              console.log(`      💾 Cachée pour "${s.name}"`);
            } else {
              console.log(`      ❌ Aucune image Wiki pour "${s.name}"`);
            }
          } catch (e) {
            console.log(`      💥 Erreur Wiki "${s.name}":`, e.message);
          }
        }

        return {
          ...s,
          imageUrl,
          wikipedia: wikiLink,
          distance:
            myLat !== null && myLng !== null
              ? calculateDistanceKm(myLat, myLng, s.latitude, s.longitude)
              : null,
        };
      })
    );

    finalResults.sort((a, b) => (a.distance ?? 999999) - (b.distance ?? 999999));

    const withImageCount = finalResults.filter((r) => r.imageUrl).length;
    console.log(`\n🎯 RÉSULTAT: ${finalResults.length} stades, ${withImageCount} avec image\n`);

    res.json(finalResults);
  } catch (e) {
    console.error('❌ Erreur recherche stade:', e.message);
    res.status(500).json({ error: e.message });
  }
});


