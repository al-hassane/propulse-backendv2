// Algorithme de géocodage inverse mathématique
function getCityOrCountryFromCoordinates(lat, lng, country) {
  // Si le visiteur est étranger, on affiche directement son pays d'origine
  if (country && country.toLowerCase() !== "sénégal" && country.toLowerCase() !== "senegal") {
    return country;
  }
  
  if (!lat || !lng) return "Dakar"; // Fallback de sécurité

  let closestCity = "Dakar";
  let minDistance = Infinity;

  // Calculer la distance euclidienne minimale sur l'ensemble de votre base de données de villes
  for (const city of senegalCities) {
    const d = Math.sqrt(Math.pow(lat - city.lat, 2) + Math.pow(lng - city.lng, 2));
    if (d < minDistance) {
      minDistance = d;
      closestCity = city.name;
    }
  }

  return closestCity;
}

