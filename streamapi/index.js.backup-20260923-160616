app.get('/competitions/matches/:id/full-details', async (req, res) => {
  const matchId = parseInt(req.params.id);
  try {
    const match = await prisma.match.findUnique({
      where: { id: matchId },
      include: {
        homeTeam: { include: { players: { where: { role: 'joueur' } } } },
        awayTeam: { include: { players: { where: { role: 'joueur' } } } },
        events: { orderBy: { minute: 'desc' } },
        lineups: true, // Ce sont les joueurs qui ont déjà un numéro ou une action
        stats: true, // 🟢 AJOUTE CETTE LIGNE ICI
      }
    });

    if (!match) return res.status(404).json({ error: "Match introuvable" });

    // 🟢 FONCTION DE FUSION MAGIQUE
    const mergePlayers = (clubPlayers, teamId) => {
      return clubPlayers.map(p => {
        // On cherche si ce joueur précis du club est déjà dans la feuille de match (lineups)
        const matchEntry = match.lineups.find(l => l.playerName === p.fullName && l.teamId === teamId);
        
        if (matchEntry) {
          return matchEntry; // On renvoie la version avec le numéro modifié
        } else {
          // Sinon on renvoie la version par défaut du club (id temporaire)
          return {
            id: `temp-${p.id}`,
            teamId: teamId,
            playerName: p.fullName,
            number: p.jerseyNumber || 0,
            isStarter: p.isDefaultStarter,
            tacticalRole: p.tacticalRole
          };
        }
      });
    };

    // On remplace la liste lineups par la fusion des deux équipes
    const finalHomeLineup = mergePlayers(match.homeTeam.players, match.homeTeamId);
    const finalAwayLineup = mergePlayers(match.awayTeam.players, match.awayTeamId);
    
    match.lineups = [...finalHomeLineup, ...finalAwayLineup];

    res.json(match);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur serveur" });
  }
});

