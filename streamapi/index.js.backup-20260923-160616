app.get('/users/nearby', async (req, res) => {
  try {
    const { lat, lng, radius, exclude } = req.query;
    
    if (!lat || !lng) {
      return res.status(400).json({ error: "Coordonnées manquantes" });
    }

    const myLat = parseFloat(lat);
    const myLng = parseFloat(lng);
    const maxDistance = parseFloat(radius) || 10;
    
    // 🛡️ SÉCURITÉ : Si exclude est "undefined" ou invalide, on met 0 au lieu de NaN
    let excludeId = parseInt(exclude);
    if (isNaN(excludeId)) {
      excludeId = 0; 
    }

    const users = await prisma.user.findMany({
      where: {
        latitude: { not: null },
        longitude: { not: null },
        id: { not: excludeId }, // Ne plantera plus car excludeId sera au pire 0
        role: 'joueur'
      },
      select: {
        id: true, fullName: true, avatarUrl: true, sport: true,
        level: true, latitude: true, longitude: true, isVerified: true,
        certification: { select: { status: true } }
      }
    });
    
    const toRad = (value) => (value * Math.PI) / 180;
    const nearby = [];
    
    for (const user of users) {
      const userLat = parseFloat(user.latitude);
      const userLng = parseFloat(user.longitude);
      if (isNaN(userLat) || isNaN(userLng)) continue;
      
      const R = 6371; 
      const dLat = toRad(userLat - myLat);
      const dLon = toRad(userLng - myLng);
      const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(toRad(myLat)) * Math.cos(toRad(userLat)) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      const distance = R * c;
      
      if (distance < maxDistance) {
        nearby.push({
          ...user,
          distance: parseFloat(distance.toFixed(2)),
          isCertified: user.certification?.status === 'APPROVED'
        });
      }
    }
    
    nearby.sort((a, b) => a.distance - b.distance);
    res.json(nearby);
    
  } catch (error) {
    console.error("❌ Erreur Nearby:", error);
    res.status(500).json({ error: "Erreur serveur proximité" });
  }
});


