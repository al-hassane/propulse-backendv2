// --- TOUT MARQUER COMME LU ---
// --- TOUT MARQUER COMME LU (Version Robuste anti-deadlock) ---
app.put('/users/:id/notifications/read-all', async (req, res) => {
  const { id } = req.params;
  try {
    // On n'exécute l'update que s'il y a vraiment des notifs non lues
    // pour réduire la pression sur la base de données
    await prisma.notification.updateMany({
      where: { 
        receiverId: parseInt(id), 
        isRead: false 
      },
      data: { isRead: true }
    });
    
    res.json({ message: "Toutes les notifications marquées comme lues" });
  } catch (error) {
    // Si c'est un deadlock (code Postgres 40P01), on ne crash pas.
    // On considère que l'action est un succès car une autre requête a déjà fait le travail.
    if (error.code === '40P01' || error.message.includes('deadlock')) {
      console.log(`ℹ️ Deadlock évité pour l'user ${id} (read-all)`);
      return res.json({ message: "Notifications déjà en cours de traitement" });
    }
    console.error("Erreur read-all:", error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});


