app.post('/organizations/requests/:id/respond', async (req, res) => {
  const requestId = parseInt(req.params.id);
  const { status } = req.body; // Attend "ACCEPTED" ou "DECLINED"

  try {
    // 1. Trouver la demande et inclure l'organisation pour avoir son nom et son proprio
    const request = await prisma.organizationRequest.findUnique({ 
      where: { id: requestId },
      include: { 
        organization: {
            select: { id: true, name: true, ownerId: true }
        }
      }
    });

    if (!request) {
      return res.status(404).json({ error: "Demande introuvable." });
    }

    const orgId = request.organization.id;
    const orgName = request.organization.name;
    const userId = request.userId;     // Le joueur qui a postulé
    const ownerId = request.organization.ownerId; // Le créateur (expéditeur de la notif)

    if (status === "ACCEPTED") {
      // 2. TRANSACTION : Ajouter le membre et supprimer la demande proprement
      await prisma.$transaction([
        prisma.organization.update({
          where: { id: orgId },
          data: { members: { connect: { id: userId } } }
        }),
        prisma.organizationRequest.delete({
          where: { id: requestId }
        })
      ]);

      // 3. NOTIFICATION DE SUCCÈS (Accepté)
      // Note : On utilise 'ACCEPTED_REQUEST' qui affiche l'icône de validation
            await createNotification(
        "ACCEPTED_REQUEST", 
        ownerId, 
        userId, 
        null, null, null,
        `Félicitations ! Ta demande pour rejoindre "${orgName}" a été acceptée ! ✅`, 
        null, null,       
        null,      // communityId
        null,      // conversationId
        null,      // trainingId
        null,      // orgPostId
        orgId      // 🟢 organizationId (14ème position)
      );

      console.log(`✅ User ${userId} a rejoint l'organisation ${orgName}`);
      return res.json({ success: true, message: "Le joueur a été ajouté aux membres." });

    } else {
      // 4. CAS DE REFUS : Notification et suppression
      await prisma.organizationRequest.delete({
        where: { id: requestId }
      });

      // Notification de refus (Type ADMIN pour message système)
      await createNotification(
        "ADMIN", 
        ownerId, 
        userId, 
        null, null, null, 
        `Désolé, ta demande d'adhésion à l'organisation "${orgName}" n'a pas été retenue. ❌`, 
        null, null, 
        null
      );

      console.log(`❌ Demande de l'user ${userId} pour ${orgName} rejetée.`);
      return res.json({ success: true, message: "Demande refusée et supprimée." });
    }

  } catch (error) {
    console.error("❌ Erreur réponse adhésion organisation:", error);
    res.status(500).json({ error: "Une erreur serveur est survenue." });
  }
});

