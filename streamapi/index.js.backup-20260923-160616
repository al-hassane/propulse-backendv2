// --- 2. SUSPENDRE UN UTILISATEUR (TEMPORAIRE) ---
app.put('/admin/users/:id/suspend', async (req, res) => {
  const { id } = req.params;
  const { duration } = req.body; // '72h', '7d', '30d' ou 'UNBAN'

  try {
    let newDate = new Date();

    if (duration === 'UNBAN') {
      newDate = null; // On retire la suspension
    } else {
      if (duration === '72h') newDate.setHours(newDate.getHours() + 72);
      if (duration === '7d') newDate.setDate(newDate.getDate() + 7);
      if (duration === '30d') newDate.setDate(newDate.getDate() + 30);
    }

    const updatedUser = await prisma.user.update({
      where: { id: parseInt(id) },
      data: { suspendedUntil: newDate }
    });

    res.json({ 
      message: duration === 'UNBAN' ? "Utilisateur réintégré." : `Suspendu jusqu'au ${newDate.toLocaleString()}`, 
      user: updatedUser 
    });

  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur suspension" });
  }
});

