// 🆕 [GET] Récupérer UN post spécifique (pour l'écran détail)
// ----------------------------------------------------------------
// --- [HUB ESPORT] RÉCUPÉRER UN POST UNIQUE (DÉTAILS + MASQUAGE) ---
app.get('/organizations/posts/:id', async (req, res) => {
  const postId = parseInt(req.params.id);
  const userId = req.query.userId ? parseInt(req.query.userId) : null;

  try {
    const post = await prisma.organizationPost.findUnique({
      where: { id: postId },
      include: {
        author: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true } },
        organization: { select: { id: true, name: true, logo: true, ownerId: true } },
        _count: { select: { likes: true, comments: true, votes: true } },
        likes: userId ? { where: { userId: userId } } : false,
        reactions: true,
        votes: true
      }
    });

    if (!post) return res.status(404).json({ error: "Post introuvable" });

    // 🟢 Calcul des stats sondage — supporte N options
    const options = post.pollOptions || null;
    const myVote = post.votes?.find(v => v.userId === userId);
    let pollStats = [0, 0];
    let pollData = null;

    if (options && options.length > 0) {
      pollStats = new Array(options.length).fill(0);
      post.votes?.forEach(v => { if (v.option >= 0 && v.option < options.length) pollStats[v.option]++; });

      pollData = {
        options,
        counts: pollStats,
        totalVotes: pollStats.reduce((a, b) => a + b, 0),
        userVote: myVote ? myVote.option : null,
        endsAt: post.pollEndsAt || null,
      };
    }

    let isHidden = false;
    if (userId) {
      const hiddenRecord = await prisma.hiddenOrganizationPost.findUnique({
        where: {
          userId_postId: { userId: userId, postId: postId },
        },
      });
      isHidden = !!hiddenRecord;
    }

    let isSaved = false;
    if (userId) {
      const savedRecord = await prisma.savedOrganizationPost.findUnique({
        where: { userId_postId: { userId: parseInt(userId), postId: postId } }
      });
      isSaved = !!savedRecord;
    }

    res.json({
      ...post,
      isHidden,
      isLiked: post.likes?.length > 0,
      likesCount: post._count.likes,
      commentsCount: post._count.comments,
      userVote: myVote ? myVote.option : null,
      pollResults: pollStats,
      poll: pollData, // 🟢 NOUVEAU
      author: { 
        ...post.author, 
        avatarUrl: toCdnUrl(post.author.avatarUrl) 
      },
      organization: {
        ...post.organization,
        logo: toCdnUrl(post.organization.logo)
      },
      mediaUrl: toCdnUrl(post.mediaUrl),
      thumbnailUrl: toCdnUrl(post.thumbnailUrl),
      likes: undefined,
      isSaved,
      votes: undefined
    });

  } catch (e) {
    console.error("Erreur chargement post unique:", e);
    res.status(500).json({ error: "Erreur serveur lors de la récupération du post" });
  }
});

