app.post('/training-sessions/:id/react', async (req, res) => {
  const sessionId = parseInt(req.params.id);
  const { userId, emoji } = req.body;
  const uId = parseInt(userId);

  try {
    // 1. Vérifier si l'utilisateur a déjà réagi à cette séance
    const existing = await prisma.trainingReaction.findUnique({
      where: { sessionId_userId: { sessionId, userId: uId } }
    });

    if (existing && existing.emoji === emoji) {
      // 🟢 ACTION : TOGGLE OFF (On retire la réaction car c'est le même emoji)
      await prisma.trainingReaction.delete({
        where: { id: existing.id }
      });
    } else {
      // 🟢 ACTION : UPSERT (On crée ou on remplace par le nouvel emoji)
      await prisma.trainingReaction.upsert({
        where: { sessionId_userId: { sessionId, userId: uId } },
        update: { emoji: emoji },
        create: { sessionId, userId: uId, emoji: emoji }
      });

      // Notifier le propriétaire (si ce n'est pas lui)
      const session = await prisma.trainingSession.findUnique({ where: { id: sessionId } });
      if (session.userId !== uId) {
        await createNotification("TRAINING_REACTION", uId, session.userId, null, null, null, emoji, null, null, null, null, sessionId);
      }
    }

    // 2. RÉCUPÉRER ET FORMATER LES STATS POUR LE FRONTEND (Crucial pour éviter le "undefined")
    const allReactions = await prisma.trainingReaction.findMany({
      where: { sessionId: sessionId }
    });
    
    const reactionStats = allReactions.reduce((acc, curr) => {
      acc[curr.emoji] = (acc[curr.emoji] || 0) + 1;
      return acc;
    }, {});

    // 3. Envoyer le signal temps réel
    io.emit('new_training_reaction', { sessionId, reactions: reactionStats });

    res.json({ success: true, reactions: reactionStats });

  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur réaction" });
  }
});


