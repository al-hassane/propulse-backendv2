app.put('/tournaments/matches/:matchId', async (req, res) => {
  const matchId = parseInt(req.params.matchId);
  const { userId, scoreA, scoreB, scheduledAt, status } = req.body;

  try {
    const match = await prisma.tournamentMatch.findUnique({
      where: { id: matchId },
      include: { tournament: true },
    });
    if (!match) return res.status(404).json({ error: "Match introuvable." });

    if (match.tournament.creatorId !== parseInt(userId)) {
      return res.status(403).json({ error: "Seul le créateur peut modifier ce match." });
    }

    if (!match.playerAId || !match.playerBId) {
      return res.status(400).json({ error: "Ce match n'a pas encore ses deux joueurs." });
    }

    const finalScoreA = scoreA !== undefined ? parseInt(scoreA) : match.scoreA;
    const finalScoreB = scoreB !== undefined ? parseInt(scoreB) : match.scoreB;

    let winnerId = match.winnerId;
    let isNowDone = false;

    if (finalScoreA !== null && finalScoreA !== undefined &&
        finalScoreB !== null && finalScoreB !== undefined) {
      if (finalScoreA === finalScoreB) {
        return res.status(400).json({ error: "Pas d'égalité possible en bracket, un score doit être supérieur à l'autre." });
      }
      winnerId = finalScoreA > finalScoreB ? match.playerAId : match.playerBId;
      isNowDone = true;
    }

    const updated = await prisma.tournamentMatch.update({
      where: { id: matchId },
      data: {
        ...(scoreA !== undefined && { scoreA: finalScoreA }),
        ...(scoreB !== undefined && { scoreB: finalScoreB }),
        ...(scheduledAt !== undefined && { scheduledAt: new Date(scheduledAt) }),
        ...(status !== undefined && { status }),
        ...(isNowDone && { winnerId, status: "DONE" }),
      },
    });

    const winnerJustSet = isNowDone && winnerId !== match.winnerId;

    if (winnerJustSet && match.nextMatchId) {
      const isFirstFeeder = match.position % 2 === 0;
      await prisma.tournamentMatch.update({
        where: { id: match.nextMatchId },
        data: isFirstFeeder ? { playerAId: winnerId } : { playerBId: winnerId },
      });

      const refreshedNext = await prisma.tournamentMatch.findUnique({ where: { id: match.nextMatchId } });
      if (refreshedNext.playerAId && refreshedNext.playerBId) {
        await prisma.tournamentMatch.update({
          where: { id: match.nextMatchId },
          data: { status: "SCHEDULED" },
        });
      }
    }

    if (winnerJustSet) {
      const loserId = winnerId === match.playerAId ? match.playerBId : match.playerAId;
      await createNotification("ADMIN", userId, winnerId, null, null, null,
        `Victoire ! Tu passes au tour suivant dans "${match.tournament.title}" 🏆`,
        null, null, null, null, null);
      await createNotification("ADMIN", userId, loserId, null, null, null,
        `Match terminé dans "${match.tournament.title}". La prochaine sera la bonne !`,
        null, null, null, null, null);
    }

    io.to(`tournament_${match.tournamentId}`).emit('match_status_updated', {
  matchId: updated.id,
  status: updated.status,
});

    res.json({ message: "Match mis à jour.", match: updated });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Erreur lors de la mise à jour du match." });
  }
});


app.post('/tournaments/matches/:matchId/go-live', async (req, res) => {
  const matchId = parseInt(req.params.matchId);
  const { userId } = req.body;

  try {
    // 1. On cherche le match et son live potentiel
    const match = await prisma.tournamentMatch.findUnique({
      where: { id: matchId },
      include: { liveStream: true, tournament: true }
    });

    if (!match) return res.status(404).json({ error: "Match non trouvé." });
    
    if (match.playerAId !== parseInt(userId)) {
      return res.status(403).json({ error: "Seul le Joueur A peut lancer le live." });
    }

    // 🟢 CORRECTIF : Si un live existe déjà, on utilise match.liveStream
    if (match.liveStream) {
      console.log("♻️ [CTO SAFE] Réutilisation du flux existant.");
      return res.json({
        success: true,
        ingestUrl: `rtmps://${match.liveStream.ingestEndpoint}/app/`,
        streamKey: match.liveStream.streamKey,
        playbackUrl: match.liveStream.playbackUrl
      });
    }

    // 2. Sinon, on crée le canal chez AWS
    console.log("📡 Création d'un nouveau canal sur AWS IVS...");
    const ivsCommand = new CreateChannelCommand({
      name: `Match-${matchId}-User-${userId}`,
      latencyMode: "LOW",
      type: "BASIC",
    });

    const ivsResponse = await ivs.send(ivsCommand);

    // 3. On enregistre le NOUVEAU live (on l'appelle 'newLive' pour éviter l'erreur)
    const newLive = await prisma.liveStream.create({
      data: {
        title: `${match.tournament.title} : Direct`,
        matchId: matchId,
        streamerId: parseInt(userId),
        ingestEndpoint: ivsResponse.channel.ingestEndpoint,
        streamKey: ivsResponse.streamKey.value,
        playbackUrl: ivsResponse.channel.playbackUrl,
        isLive: true
      }
    });

    // 4. On met le match en LIVE
    await prisma.tournamentMatch.update({
      where: { id: matchId },
      data: { status: "LIVE" }
    });

    res.json({
      success: true,
      ingestUrl: `rtmps://${newLive.ingestEndpoint}/app/`,
      streamKey: newLive.streamKey,
      playbackUrl: newLive.playbackUrl
    });

  } catch (error) {
    console.error("❌ Erreur Go Live réelle:", error);
    res.status(500).json({ error: "Erreur lors de l'initialisation du stream." });
  }
});


