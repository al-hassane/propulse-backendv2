// --- SUPPRIMER UNE CONVERSATION (Logique "Supprimer pour moi") ---
app.delete('/conversations/:id', async (req, res) => {
  const { id } = req.params;
  const { userId } = req.body;

  try {
    const convId = parseInt(id);
    const uId = parseInt(userId);

    // 1. On récupère les messages de la conversation
    const messages = await prisma.message.findMany({
      where: { conversationId: convId }
    });

    // 2. On marque tous les messages actuels comme "Supprimés pour moi"
    // Cela évite de les supprimer chez l'autre personne
    const deletePromises = messages.map(msg => 
      prisma.messageDeletion.upsert({
        where: { userId_messageId: { userId: uId, messageId: msg.id } },
        update: {},
        create: { userId: uId, messageId: msg.id }
      })
    );
    await Promise.all(deletePromises);

    // 3. On archive aussi la conversation pour qu'elle n'apparaisse plus dans la liste
    const conv = await prisma.conversation.findUnique({ where: { id: convId } });
    let updateData = {};
    if (conv.user1Id === uId) updateData.isArchivedForUser1 = true;
    else updateData.isArchivedForUser2 = true;

    await prisma.conversation.update({
      where: { id: convId },
      data: updateData
    });

    res.json({ success: true, message: "Conversation supprimée" });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur serveur lors de la suppression" });
  }
});


