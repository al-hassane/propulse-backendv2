// ==========================================
// 🔔 [CRON] RAPPEL 2H AVANT LA FIN D'UN SONDAGE D'ORGANISATION
// ⏰ Tourne toutes les 30 min pour ne rater aucune fenêtre
// 🎯 Cible : UNIQUEMENT les membres de l'organisation
// 🛡️ Anti-doublon via notification existante
// ==========================================
cron.schedule('*/30 * * * *', async () => {
  console.log("🔔 [CRON RAPPEL] Vérification des sondages qui expirent bientôt...");

  const now = new Date();
  const in2Hours = new Date(now.getTime() + 2 * 60 * 60 * 1000);
  const in3Hours = new Date(now.getTime() + 3 * 60 * 60 * 1000);

  try {
    // 1. Trouver tous les posts d'org avec sondage qui expirent dans 2h à 3h
    //    (la fenêtre 2h-3h évite les doublons quand le cron tourne toutes les 30 min)
    const expiringPosts = await prisma.organizationPost.findMany({
      where: {
        pollOptions: { not: null },
        pollEndsAt: {
          gte: in2Hours,
          lt: in3Hours,
        },
      },
      include: {
        organization: {
          include: {
            members: {
              select: { id: true, pushToken: true, fullName: true },
            },
          },
        },
      },
    });

    if (expiringPosts.length === 0) {
      console.log("ℹ️ [CRON RAPPEL] Aucun sondage n'expire dans les 2 prochaines heures.");
      return;
    }

    console.log(`📊 [CRON RAPPEL] ${expiringPosts.length} sondage(s) à traiter.`);

    for (const post of expiringPosts) {
      const org = post.organization;
      if (!org || !org.members || org.members.length === 0) continue;

      // 2. Trouver qui a DÉJÀ voté sur ce post
      const existingVotes = await prisma.organizationPostVote.findMany({
        where: { postId: post.id },
        select: { userId: true },
      });
      const votedUserIds = new Set(existingVotes.map(v => v.userId));

      // 3. Cibler les membres qui n'ont PAS encore voté
      const targetMembers = org.members.filter(m => !votedUserIds.has(m.id));

      if (targetMembers.length === 0) {
        console.log(`ℹ️ [CRON RAPPEL] Post #${post.id} : tous les membres ont déjà voté.`);
        continue;
      }

      // 4. Anti-doublon : vérifier si on a déjà envoyé un rappel récemment
      //    (dans les 4 dernières heures) pour ce post à ces membres
      const fourHoursAgo = new Date(now.getTime() - 4 * 60 * 60 * 1000);
      const alreadySent = await prisma.notification.findFirst({
        where: {
          type: "POLL_REMINDER",
          orgPostId: post.id,
          createdAt: { gte: fourHoursAgo },
        },
      });

      if (alreadySent) {
        console.log(`⏭️ [CRON RAPPEL] Post #${post.id} : rappel déjà envoyé récemment.`);
        continue;
      }

      console.log(`🎯 [CRON RAPPEL] Post #${post.id} → ${targetMembers.length} membres à notifier.`);

      // 5. Envoyer les notifications (in-app + push)
      for (const member of targetMembers) {
        try {
          await createNotification(
            "POLL_REMINDER",         // 🟢 nouveau type
            org.ownerId,              // senderId (le créateur du post)
            member.id,                // receiverId
            null,                     // postId
            null,                     // ratingId
            null,                     // eventId
            `⏰ Dernière chance ! Le sondage "${post.pollQuestion || post.text || 'de ' + org.name}" se termine dans 2h. Vote maintenant !`,
            null,                     // storyId
            null,                     // newsId
            null,                     // communityId
            null,                     // conversationId
            null,                     // trainingId
            post.id,                  // orgPostId ✅
            org.id                    // organizationId ✅
          );
        } catch (notifErr) {
          console.error(`⚠️ [CRON RAPPEL] Notif membre #${member.id} échouée:`, notifErr.message);
        }
      }

      console.log(`✅ [CRON RAPPEL] Post #${post.id} → ${targetMembers.length} notifications envoyées.`);
    }

  } catch (error) {
    console.error("❌ [CRON RAPPEL] Erreur:", error);
  }
});


// ==========================================
// CRON JOB : AUTOMATISATION DES EXPIRATIONS
// (Tourne tous les jours à minuit : 00:00)
// ==========================================
// ==========================================
// CRON JOB : AUTOMATISATION DES EXPIRATIONS (V2 ÉLITE)
// ⏰ Tourne TOUTES LES HEURES pour éviter les désyncs
// 🛡️ Inclut une AUTO-RÉPARATION en cas de désync détectée
// ==========================================
cron.schedule('0 * * * *', async () => {
  console.log("⏰ [CRON HORAIRE] Vérification des expirations...");
  const now = new Date();

  try {
    // ═══════════════════════════════════════════════════════
    // 1. EXPIRATION DES CERTIFICATIONS JOUEURS
    // ═══════════════════════════════════════════════════════
    const expiredPlayers = await prisma.playerCertification.findMany({
      where: { 
        status: 'APPROVED',
        OR: [
          { expiryDate: { lt: now } },   // Date dépassée
          { expiryDate: null }            // 🛡️ Sécurité anti-désync
        ]
      },
      include: { user: true }
    });

    for (const cert of expiredPlayers) {
      try {
        await prisma.$transaction([
          prisma.playerCertification.update({
            where: { id: cert.id },
            data: { status: 'EXPIRED' }
          }),
          prisma.user.update({
            where: { id: cert.userId },
            data: { 
              isVerified: false,
              certifTier: 'NONE'
            }
          })
        ]);

        // Notification séparée (si elle plante, la transaction reste commit)
        try {
          await createNotification(
            "ADMIN", cert.userId, cert.userId, null, null, null,
            "Votre certification Pro a expiré. Renouvelez-la pour récupérer votre badge ! 🏆"
          );
        } catch (notifErr) {
          console.error(`⚠️ Notif expirée non envoyée (user ${cert.userId}):`, notifErr.message);
        }
      } catch (e) {
        console.error(`❌ Erreur expiration joueur ${cert.userId}:`, e.message);
      }
    }

    // ═══════════════════════════════════════════════════════
    // 2. EXPIRATION DES BOUTIQUES PREMIUM
    // ═══════════════════════════════════════════════════════
    const expiredShops = await prisma.shopCertification.findMany({
      where: { 
        status: 'APPROVED',
        OR: [
          { expiryDate: { lt: now } },
          { expiryDate: null }
        ]
      },
      include: { shop: { include: { owner: true } } }
    });

    for (const cert of expiredShops) {
      try {
        await prisma.$transaction([
          prisma.shopCertification.update({
            where: { id: cert.id },
            data: { status: 'EXPIRED' }
          }),
          prisma.shop.update({
            where: { id: cert.shopId },
            data: { isPremium: false }
          })
        ]);

        try {
          await createNotification(
            "ADMIN", cert.shop.ownerId, cert.shop.ownerId, null, null, null,
            `Votre abonnement Premium pour "${cert.shop.name}" a expiré. 👑`
          );
        } catch (notifErr) {
          console.error(`⚠️ Notif boutique expirée non envoyée:`, notifErr.message);
        }
      } catch (e) {
        console.error(`❌ Erreur expiration boutique ${cert.shopId}:`, e.message);
      }
    }

    // ═══════════════════════════════════════════════════════
    // 3. EXPIRATION DES CLUBS CERTIFIÉS
    // ═══════════════════════════════════════════════════════
    const expiredClubs = await prisma.communityCertification.findMany({
      where: { 
        status: 'APPROVED',
        OR: [
          { expiryDate: { lt: now } },
          { expiryDate: null }
        ]
      },
      include: { community: true }
    });

    for (const cert of expiredClubs) {
      try {
        await prisma.$transaction([
          prisma.communityCertification.update({
            where: { id: cert.id },
            data: { status: 'EXPIRED' }
          }),
          prisma.community.update({
            where: { id: cert.communityId },
            data: { isVerified: false }
          })
        ]);

        try {
          await createNotification(
            "ADMIN", cert.community.ownerId, cert.community.ownerId, null, null, null,
            `La certification officielle du club "${cert.community.name}" a expiré. 🏟️`
          );
        } catch (notifErr) {
          console.error(`⚠️ Notif club expiré non envoyée:`, notifErr.message);
        }
      } catch (e) {
        console.error(`❌ Erreur expiration club ${cert.communityId}:`, e.message);
      }
    }

    // ═══════════════════════════════════════════════════════
    // 4. 🛡️ AUTO-RÉPARATION : DÉTECTER ET CORRIGER LES DÉSYNCS
    // (Cas où le cron aurait raté un passage précédent)
    // ═══════════════════════════════════════════════════════
    const desyncedUsers = await prisma.user.findMany({
      where: {
        isVerified: true,
        certification: {
          OR: [
            { status: 'EXPIRED' },
            { status: 'REJECTED' },
            { status: { not: 'APPROVED' } }
          ]
        }
      },
      select: { id: true, fullName: true, certifTier: true }
    });

    if (desyncedUsers.length > 0) {
      console.log(`🚨 [AUTO-REPAIR] ${desyncedUsers.length} utilisateur(s) désynchronisé(s) détecté(s)`);

      for (const user of desyncedUsers) {
        await prisma.user.update({
          where: { id: user.id },
          data: { 
            isVerified: false,
            certifTier: 'NONE'
          }
        });
        console.log(`🔧 [AUTO-REPAIR] User ${user.id} (${user.fullName}) corrigé`);
      }
    }

    // Log final uniquement s'il y a eu de l'activité
    const total = expiredPlayers.length + expiredShops.length + expiredClubs.length + desyncedUsers.length;
    if (total > 0) {
      console.log(`✅ [CRON HORAIRE] ${expiredPlayers.length} joueurs, ${expiredShops.length} boutiques, ${expiredClubs.length} clubs expirés + ${desyncedUsers.length} désyncs réparées`);
    }

  } catch (error) {
    console.error("❌ [CRON HORAIRE] Erreur:", error);
  }
});



