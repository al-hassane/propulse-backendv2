app.delete('/training-sessions/:id', async (req, res) => {
  const sessionId = parseInt(req.params.id);
  const { userId } = req.body; // L'ID de celui qui veut supprimer

  try {
    const session = await prisma.trainingSession.findUnique({
      where: { id: sessionId },
      include: { _count: { select: { feedbacks: true } } }
    });

    if (!session) return res.status(404).json({ error: "Session introuvable" });

    // 🛡️ SÉCURITÉ : Seul le créateur peut supprimer
    if (session.userId !== parseInt(userId)) {
      return res.status(403).json({ error: "Tu ne peux pas supprimer l'entraînement d'un autre joueur." });
    }

    // 💡 LOGIQUE ÉLITE : Si des feedbacks existent déjà
    if (session._count.feedbacks > 0) {
      console.log(`⚠️ Suppression d'une session avec ${session._count.feedbacks} avis de coachs.`);
      // Ici on pourrait ajouter une logique pour prévenir les coachs
    }

    // TRANSACTION : On nettoie tout (avis, cibles, et la session)
    await prisma.$transaction([
      prisma.trainingFeedback.deleteMany({ where: { sessionId } }),
      prisma.trainingTarget.deleteMany({ where: { sessionId } }),
      prisma.trainingSession.delete({ where: { id: sessionId } })
    ]);

    res.json({ message: "Session d'entraînement supprimée définitivement." });

  } catch (e) {
    res.status(500).json({ error: "Erreur lors de la suppression" });
  }
