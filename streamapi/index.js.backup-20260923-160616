// ==========================================
// 🎬 ROUTE : GÉNÉRER UNE VIDÉO À PARTIR D'UNE PRO CARD
// À coller dans server.js, avec les autres routes
// ==========================================

app.post('/generate-card-video', async (req, res) => {
  const { cardUrl, logoUrl } = req.body;

  if (!cardUrl) {
    return res.status(400).json({ error: "cardUrl manquant" });
  }

  const tmpDir = require('os').tmpdir();
  const timestamp = Date.now();
  const cardPath    = path.join(tmpDir, `card_${timestamp}.jpg`);
  const logoPath    = path.join(tmpDir, `logo_${timestamp}.png`);
  const outputPath  = path.join(tmpDir, `propulse_card_${timestamp}.mp4`);

  try {
    // 1. Télécharger la carte (image principale)
    console.log("📥 Téléchargement de la carte...");
    const cardResponse = await axios({ method: 'GET', url: cardUrl, responseType: 'stream' });
    await new Promise((resolve, reject) => {
      const w = fs.createWriteStream(cardPath);
      cardResponse.data.pipe(w);
      w.on('finish', resolve);
      w.on('error', reject);
    });

    // 2. Télécharger le logo si fourni
    let hasLogo = false;
    if (logoUrl) {
      try {
        const logoResponse = await axios({ method: 'GET', url: logoUrl, responseType: 'stream' });
        await new Promise((resolve, reject) => {
          const w = fs.createWriteStream(logoPath);
          logoResponse.data.pipe(w);
          w.on('finish', resolve);
          w.on('error', reject);
        });
        hasLogo = true;
      } catch (e) {
        console.log("⚠️ Logo non téléchargé, on continue sans.");
      }
    }

    // 3. Générer la vidéo avec FFmpeg
    // Effet : zoom-in + fade in/out sur 3 secondes, 30fps
    console.log("🎬 Génération de la vidéo...");

    await new Promise((resolve, reject) => {
      let command = ffmpeg(cardPath)
        .loop(1)                           // Boucle sur l'image fixe
        .inputOptions(['-t 3'])            // Durée de l'input : 3 secondes
        .fps(30);

      if (hasLogo) {
        // Avec logo incrusté en bas à droite
        command = command
          .input(logoPath)
          .complexFilter([
            // Zoom-in sur la carte (scale 0.8 → 1.0)
            "[0:v]zoompan=z='if(lte(on,30),0.8+on*0.006,1.0)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=90:s=820x650,fade=t=in:st=0:d=0.5,fade=t=out:st=2.5:d=0.5[base]",
            // Redimensionner le logo
            "[1:v]scale=60:60[logo]",
            // Superposer le logo en bas à droite
            "[base][logo]overlay=main_w-74:main_h-74[out]"
          ])
          .map('[out]');
      } else {
        // Sans logo
        command = command.videoFilter([
          "zoompan=z='if(lte(on,30),0.8+on*0.006,1.0)':x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=90:s=820x650",
          "fade=t=in:st=0:d=0.5",
          "fade=t=out:st=2.5:d=0.5"
        ]);
      }

      command
        .outputOptions([
          '-c:v libx264',
          '-preset ultrafast',
          '-pix_fmt yuv420p',
          '-movflags +faststart',   // Permet le streaming immédiat
          '-an'                     // Pas d'audio
        ])
        .output(outputPath)
        .on('end', resolve)
        .on('error', (err) => {
          console.error("❌ FFmpeg error:", err.message);
          reject(err);
        })
        .run();
    });

    // 4. Uploader la vidéo sur S3
    console.log("☁️ Upload sur S3...");
    const { PutObjectCommand } = require('@aws-sdk/client-s3');
    const videoBuffer = fs.readFileSync(outputPath);
    const s3Key = `propulse_cards/video_${timestamp}.mp4`;

    await s3.send(new PutObjectCommand({
      Bucket: 'propulse-media-final-storage',
      Key: s3Key,
      Body: videoBuffer,
      ContentType: 'video/mp4'
    }));

    const videoUrl = `https://propulse-media-final-storage.s3.amazonaws.com/${s3Key}`;
    console.log("✅ Vidéo disponible :", videoUrl);

    res.json({ success: true, videoUrl });

  } catch (error) {
    console.error("❌ Erreur generate-card-video:", error.message);
    res.status(500).json({ error: "Erreur lors de la génération de la vidéo", details: error.message });
  } finally {
    // 5. Nettoyage des fichiers temporaires
    [cardPath, logoPath, outputPath].forEach(f => {
      try { if (fs.existsSync(f)) fs.unlinkSync(f); } catch (_) {}
    });
  }
});


