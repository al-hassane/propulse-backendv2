    const calculateAge = (birthDate) => {
      if (!birthDate) return null;
      const today = new Date();
      const birth = new Date(birthDate);
      let age = today.getFullYear() - birth.getFullYear();
      const m = today.getMonth() - birth.getMonth();
      if (m < 0 || (m === 0 && today.getDate() < birth.getDate())) {
        age--;
      }
      return age;
    };

    // Formater les données (Calcul de l'âge + CDN CloudFront pour toutes les images)
    const formattedPlayers = pendingPlayers.map(player => ({
      ...player,
      age: calculateAge(player.birthDate),
      avatarUrl: player.avatarUrl ? toCdnUrl(player.avatarUrl) : null,
      eliteCardUrl: player.eliteCardUrl ? toCdnUrl(player.eliteCardUrl) : null,
      eliteCardUrlLight: player.eliteCardUrlLight ? toCdnUrl(player.eliteCardUrlLight) : null,
    }));

    res.json({
      success: true,
      count: formattedPlayers.length,
      data: formattedPlayers
    });

