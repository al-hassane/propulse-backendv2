// --- 5. COMMENTER UNE STORY (AVEC PROLONGATION +15 MIN) ---
app.post('/stories/:id/comment', async (req, res) => {
  const storyId = parseInt(req.params.id);
  const { userId, text, parentId } = req.body; // parentId ajouté pour les réponses

  if (!text || text.trim() === "") {
    return res.status(400).json({ error: "Le commentaire ne peut pas être vide." });
  }

  try {
    // 1. Créer le commentaire dans la BDD
    const comment = await prisma.storyComment.create({
      data: {
        userId: parseInt(userId),
        storyId: storyId,
        text: text,
        parentId: parentId ? parseInt(parentId) : null // Gère les réponses au chat
      },
      include: {
        user: {
          select: { id: true, fullName: true, avatarUrl: true, role: true }
        }
      }
    });

    // 2. Récupérer la story pour calculer la prolongation
    const story = await prisma.story.findUnique({ where: { id: storyId } });

    if (story) {
      // --- 🟢 LOGIQUE DE PROLONGATION (+15 minutes) ---
      const FIFTEEN_MINUTES = 15 * 60 * 1000;
      let newExpiresAt = new Date(story.expiresAt.getTime() + FIFTEEN_MINUTES);

      // Sécurité CTO : Une story ne peut pas dépasser 72h de vie totale
      const MAX_LIFESPAN = 72 * 60 * 60 * 1000; // 72 heures
      const absoluteMaxDate = new Date(story.createdAt.getTime() + MAX_LIFESPAN);

      if (newExpiresAt > absoluteMaxDate) {
        newExpiresAt = absoluteMaxDate;
      }

      // Mise à jour de la date d'expiration de la story
      await prisma.story.update({
        where: { id: storyId },
        data: { expiresAt: newExpiresAt }
      });

      // 3. Envoyer la notification (seulement si ce n'est pas le propriétaire qui commente sa propre story)
      if (story.userId !== parseInt(userId)) {
        await createNotification(
            "STORY_COMMENT",
            parseInt(userId),
            story.userId,
            null, // postId
            null, // ratingId
            null, // eventId
            text, // On envoie le texte du commentaire pour le message push
            storyId
        );
      }
    }

    // 🚀 --- 🟢 AJOUT DU CTO : ENVOI DU MESSAGE EN DIRECT ---
    io.to(`story_${storyId}`).emit('new_story_comment', comment);
    // -------------------------------------------------------

    // 🟢🟢🟢 NOUVEAU BLOC CTO : CRÉATION AUTOMATIQUE DU DM 🟢🟢🟢
    // Si le commentateur n'est pas le propriétaire de la story → on crée un DM
    if (story && story.userId !== parseInt(userId)) {
      try {
        const uId = parseInt(userId);
        const id1 = Math.min(uId, story.userId);
        const id2 = Math.max(uId, story.userId);

        // A. Trouver ou créer la conversation
        let conversation = await prisma.conversation.findUnique({
          where: { user1Id_user2Id: { user1Id: id1, user2Id: id2 } }
        });

        if (!conversation) {
          conversation = await prisma.conversation.create({
            data: { user1Id: id1, user2Id: id2 }
          });
        }

        // B. Construire le snapshot de la story (pour survivre à son expiration/suppression)
        const storySnapshot = {
          id: story.id,
          type: story.type,
          mediaUrl: story.mediaUrl,
          content: story.content,
          background: story.background,
          sharedPostId: story.sharedPostId,
          ownerId: story.userId,
          createdAt: story.createdAt,
          expiresAt: story.expiresAt
        };

        // C. Créer le message avec le type SHARED_STORY
        const storyMessage = await prisma.message.create({
          data: {
            conversationId: conversation.id,
            senderId: uId,
            text: text,
            mediaType: 'SHARED_STORY',
            sharedStoryId: storyId,
            storySnapshot: storySnapshot
          },
          include: {
            sender: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true } },
            sharedStory: {
              select: {
                id: true,
                type: true,
                mediaUrl: true,
                content: true,
                background: true,
                expiresAt: true,
                sharedPost: { select: { id: true, imageUrl: true, mediaType: true } }
              }
            }
          }
        });

        // D. Mettre à jour le updatedAt de la conversation
        await prisma.conversation.update({
          where: { id: conversation.id },
          data: { updatedAt: new Date() }
        });

        // E. Émettre en temps réel via Socket.io
        io.emit(`unread_count_${story.userId}`, { updated: true });
        io.emit(`unread_count_${uId}`, { updated: true });
        io.to(`conv_${conversation.id}`).emit('new_private_message', storyMessage);

        // F. Notification push en arrière-plan (setImmediate pour ne pas bloquer la réponse)
        setImmediate(async () => {
          try {
            await createNotification(
              "MESSAGE",
              uId,
              story.userId,
              null, null, null,
              `💬 A répondu à votre story : "${text.substring(0, 60)}${text.length > 60 ? '...' : ''}"`,
              null, null, null,
              conversation.id
            );
          } catch (notifErr) {
            console.error("Erreur notif push story DM:", notifErr.message);
          }
        });

        console.log(`💬 Commentaire story #${storyId} → DM créé dans conv #${conversation.id}`);
      } catch (dmError) {
        // 🛡️ SÉCURITÉ : Si la création du DM échoue, on ne bloque PAS la réponse
        // Le commentaire de story est déjà créé et fonctionne correctement
        console.error("❌ Erreur création DM depuis comment story:", dmError);
      }
    }
    // 🟢🟢🟢 FIN DU NOUVEAU BLOC 🟢🟢🟢

    res.json({
      message: "Commentaire envoyé et durée prolongée !",
      comment,
      newExpiresAt: story ? story.expiresAt : null
    });

  } catch (e) {
    console.error("Erreur Story Comment:", e);
    res.status(500).json({ error: "Erreur lors de l'ajout du commentaire." });
  }
});



