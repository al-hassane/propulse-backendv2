// --- [ADMIN] APPROUVER LA CERTIFICATION D'UN CLUB ---
app.put('/admin/communities/:id/approve-certif', async (req, res) => {
  const communityId = parseInt(req.params.id);
  
  // On définit la date d'expiration (ex: dans 30 jours)
  const expiry = new Date();
  expiry.setDate(expiry.getDate() + 30); 

  try {
    // 🟢 TRANSACTION ÉLITE : On met à jour les deux tables d'un coup
    const result = await prisma.$transaction([
      // 1. On met à jour le statut de la demande de certification
      prisma.communityCertification.update({
        where: { communityId: communityId },
        data: { 
          status: "APPROVED", 
          expiryDate: expiry 
        }
