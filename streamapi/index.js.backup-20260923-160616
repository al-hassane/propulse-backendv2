app.get('/search/smart', async (req, res) => {
  const { query, searcherId, type } = req.query;
  const sId = searcherId ? parseInt(searcherId) : 0;
  const searchTab = type || 'MEMBERS';
  const limit = 20;

  if (!query || query.trim() === "") {
    return res.json([]);
  }

  const searchQuery = query.trim();

  try {
    // ─── 1. RECHERCHE DES CLUBS (COMMUNAUTÉS) ───
    if (searchTab === 'CLUBS') {
      const communities = await prisma.community.findMany({
        where: {
          name: { contains: searchQuery, mode: 'insensitive' }
        },
        take: limit,
        include: {
          _count: { select: { members: true } }
        }
      });
      
      return res.json(communities.map(c => ({
        ...c,
        logo: toCdnUrl(c.logo),
        banner: toCdnUrl(c.banner)
      })));
    }

    // ─── 2. RECHERCHE DES BOUTIQUES (SHOPS) ───
    if (searchTab === 'SHOPS') {
      const shops = await prisma.shop.findMany({
        where: {
          name: { contains: searchQuery, mode: 'insensitive' }
        },
        take: limit,
        include: {
          owner: { select: { fullName: true, isVerified: true } },
          _count: { select: { products: true } }
        }
      });

      return res.json(shops.map(s => ({
        ...s,
        logo: toCdnUrl(s.logo),
        cover: toCdnUrl(s.cover)
      })));
    }

    // ─── 3. RECHERCHE DES PRODUITS ───
    if (searchTab === 'PRODUCTS') {
      const products = await prisma.product.findMany({
        where: {
          isSold: false,
          OR: [
            { title: { contains: searchQuery, mode: 'insensitive' } },
            { brand: { contains: searchQuery, mode: 'insensitive' } }
          ]
        },
        take: limit,
        include: {
          images: true,
          shop: { select: { name: true, logo: true, isPremium: true } }
        }
      });

      return res.json(products.map(p => ({
        ...p,
        images: p.images.map(img => ({ ...img, url: toCdnUrl(img.url) })),
        shop: p.shop ? { ...p.shop, logo: toCdnUrl(p.shop.logo) } : null
      })));
    }

    // ─── 4. RECHERCHE DES MEMBRES (Par défaut : MEMBERS) ───
    const users = await prisma.user.findMany({
      where: {
        fullName: { contains: searchQuery, mode: 'insensitive' },
        id: { not: sId },
        AND: [
          { blockedBy: { none: { blockerId: sId } } },
          { blockedUsers: { none: { blockedId: sId } } }
        ]
      },
      take: limit,
      orderBy: [
        { isVerified: 'desc' }, 
        { lastActiveAt: 'desc' }, 
        { createdAt: 'desc' }
      ],
      include: {
        certification: true,
        followedBy: { where: { followerId: sId } },
        posts: {
          where: { isArchived: false },
          take: 3,
          orderBy: { createdAt: 'desc' },
          include: {
            media: true,
            votes: true,
            ratings: true, 
            likes: {       
              include: {
                user: {
                  select: { id: true, fullName: true, avatarUrl: true, role: true, certification: true }
                }
              }
            },
            _count: { select: { likes: true, ratings: true, votes: true } }
          }
        }
      }
    });

    const globalSuggestions = await prisma.user.findMany({
      where: { 
        isVerified: true, 
        id: { not: sId },
        role: 'joueur' 
      },
      take: 6,
      select: { id: true, fullName: true, avatarUrl: true, sport: true }
    });

    const enrichedResults = users.map((user) => {
      const amIFollowing = user.followedBy.length > 0 && user.followedBy[0].status === 'ACCEPTED';
      const canView = !user.isPrivateProfile || amIFollowing;
      let content = {};

      if (canView) {
        const formattedPosts = user.posts.map(p => {
          const myVote = p.votes.find(v => v.userId === sId);
          return {
            ...p,
            userVote: myVote ? myVote.option : null,
            pollStats: {
              YES: p.votes.filter(v => v.option === 'YES').length,
              NO: p.votes.filter(v => v.option === 'NO').length
            },
            votes: undefined
          };
        });
        content = { type: 'POSTS', data: formattedPosts };
      } else {
        const sportSuggestions = globalSuggestions
          .filter(s => s.sport === user.sport && s.id !== user.id)
          .slice(0, 3);
        
        const finalSuggestions = sportSuggestions.length > 0 ? sportSuggestions : globalSuggestions.slice(0, 3);
        content = { type: 'SUGGESTIONS', data: finalSuggestions };
      }

      const { posts, ...userWithoutPosts } = user;
      return { 
        ...userWithoutPosts, 
        avatarUrl: userWithoutPosts.avatarUrl ? toCdnUrl(userWithoutPosts.avatarUrl) : null,
        coverUrl: userWithoutPosts.coverUrl ? toCdnUrl(userWithoutPosts.coverUrl) : null,
        // 🟢 NOUVEAU : ville + pays explicitement exposés
        city: userWithoutPosts.city || null,
        country: userWithoutPosts.country || null,
        amIFollowing, 
        content 
      };
    });

    res.json(enrichedResults);

  } catch (e) {
    console.error("❌ Erreur Search Smart:", e.message);
    res.status(500).json({ error: "Erreur serveur lors de la recherche intelligente." });
  }
});



