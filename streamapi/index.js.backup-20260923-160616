        };
      }

      // 🟢 TRANSFORMATION DU CURSEUR EMOJI : calcule la moyenne des votes + choix de l'user courant
      let transformedSlider = null;
      if (story.slider) {
        const totalVotes = story.slider.votes.length;
        const sumValues = story.slider.votes.reduce((acc, v) => acc + v.value, 0);
        const averageValue = totalVotes > 0 ? parseFloat((sumValues / totalVotes).toFixed(1)) : 50;
        const myVote = currentUserId
          ? story.slider.votes.find(v => v.userId === currentUserId)
          : null;

        transformedSlider = {
          id: story.slider.id,
          question: story.slider.question,
          emoji: story.slider.emoji,
          x: story.slider.x,
          y: story.slider.y,
          scale: story.slider.scale,
          rotation: story.slider.rotation,
          averageValue,
          total: totalVotes,
          hasVoted: !!myVote,
          userValue: myVote ? myVote.value : null,
        };
      }

      // 🟢 FORMATAGE DE L'URL AUDIO POUR LE CDN
  if (story.storyAudio) {
    story.storyAudio.audioUrl = toCdnUrl(story.storyAudio.audioUrl);
  }
      
      return {
        ...story,
        mediaUrl: transformedMediaUrl,
        thumbnailUrl: transformedThumbnailUrl,
        sharedPost: transformedSharedPost,
        poll: transformedPoll, // 🟢 remplace l'objet brut par la version calculée
        slider: transformedSlider, // 🟢 AJOUTÉ
      };
    });

    const grouped = {};
    transformedStories.forEach(story => {
      if (!grouped[story.userId]) {
        grouped[story.userId] = {
          user: story.user,
          stories: [],
          hasUnseen: false,
          lastCreatedAt: story.createdAt
        };
      }
      grouped[story.userId].stories.push(story);

      // On vérifie si l'utilisateur a vu CETTE story précise
      const isSeenByMe = story.views.some(v => v.userId === currentUserId);
      if (!isSeenByMe) {
        grouped[story.userId].hasUnseen = true;
      }
    });

    // 🟢 ALGORITHME DE TRI ÉLITE (Style Instagram)
    const sortedGroups = Object.values(grouped).sort((a, b) => {
      // 1. Priorité aux stories NON VUES
      if (a.hasUnseen && !b.hasUnseen) return -1;
      if (!a.hasUnseen && b.hasUnseen) return 1;

      // 2. Si les deux sont vues OU les deux sont non vues, on trie par date
      return new Date(b.lastCreatedAt) - new Date(a.lastCreatedAt);
    });

    res.json(sortedGroups);
  } catch (e) { 
    console.error("Erreur tri stories:", e);
    res.status(500).json([]); 
  }
});

