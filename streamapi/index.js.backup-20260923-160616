// 3. MODIFIER UN MESSAGE (Limite 5 minutes)
app.put('/messages/:id', async (req, res) => {
  const { text, userId } = req.body; // <--- On récupère l'userId de celui qui fait la requête
  const messageId = parseInt(req.params.id);

  try {
    const message = await prisma.message.findUnique({ where: { id: messageId } });
    if (!message) return res.status(404).json({ error: "Message introuvable" });

    // 🛡️ SÉCURITÉ : Est-ce bien l'auteur ?
    if (message.senderId !== parseInt(userId)) {
      return res.status(403).json({ error: "Tu ne peux modifier que tes propres messages." });
    }

    const now = new Date();
    const createdAt = new Date(message.createdAt);
    const diffInMinutes = (now - createdAt) / 1000 / 60;

    if (diffInMinutes > 5) {
      return res.status(403).json({ error: "Le délai de modification (5 min) est dépassé." });
    }

    const updatedMessage = await prisma.message.update({
      where: { id: messageId },
      data: { 
        text: text,
        isEdited: true 
      },
      // 🌟 On inclut à nouveau les réactions et le post partagé avec son auteur
      include: { 
        sender: { select: { id: true, fullName: true, avatarUrl: true } },
        reactions: {
          include: {
            user: { select: { id: true, fullName: true, avatarUrl: true } }
          }
        },
        sharedPost: {
          include: {
            user: { select: { id: true, fullName: true, avatarUrl: true, username: true } }
          }
        }
      }
    });

    io.to(`conv_${message.conversationId}`).emit('message_edited', updatedMessage);
    res.json(updatedMessage);
  } catch (e) { res.status(500).json({ error: "Erreur modification" }); }
});
   
