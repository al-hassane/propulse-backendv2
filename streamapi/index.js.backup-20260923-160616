const getOptimizedVideoUrl = (url) => {
  if (!url || !url.includes('cloudinary.com')) return url;
 
  const isVideo = url.match(/\.(mp4|mov|avi|m4v)$/i);
  if (isVideo) {
    // Force l'extension MP4 et ajoute les codecs magiques (H264 pour l'image, AAC pour le son)
    return url
      .replace(/\.[^/.]+$/, ".mp4")
      .replace('/upload/', '/upload/f_auto,q_auto:good,vc_h264,ac_aac,w_720/');
  }
  return url;
};


