});

// --- SUPPRIMER UNE STORY ---
app.delete('/stories/:id', async (req, res) => {
  const storyId = parseInt(req.params.id);

  try {
    // 🟢🟢🟢 NOUVEAU : Avant de supprimer, on enrichit les snapshots des messages DM 🟢🟢🟢
    // Cela permet au front d'afficher "Fichier indisponible" proprement
    const story = await prisma.story.findUnique({
      where: { id: storyId }
    });

    if (story) {
      // On récupère tous les messages DM qui référencent cette story
      const relatedMessages = await prisma.message.findMany({
        where: { sharedStoryId: storyId },
        select: { id: true, storySnapshot: true }
      });

      // On enrichit chaque snapshot avec un flag "deletedAt"
      for (const msg of relatedMessages) {
        const existingSnapshot = msg.storySnapshot || {};
        await prisma.message.update({
          where: { id: msg.id },
          data: {
            storySnapshot: {
              ...existingSnapshot,
              deletedAt: new Date().toISOString(),
              deletedReason: 'story_deleted'
            }
          }
        });
      }

      if (relatedMessages.length > 0) {
        console.log(`🗑️ Story #${storyId} : ${relatedMessages.length} message(s) DM marqué(s) comme supprimé(s)`);
      }
    }
    // 🟢🟢🟢 FIN DU NOUVEAU 🟢🟢🟢

    // Suppression de la story (le onDelete: SetNull va automatiquement
    // mettre sharedStoryId à null dans les messages liés)
    await prisma.story.delete({ where: { id: storyId } });

    res.json({ message: "Story supprimée" });
  } catch (e) {
    console.error("Erreur suppression story:", e);
    res.status(500).json({ error: "Erreur suppression" });
  }
});



