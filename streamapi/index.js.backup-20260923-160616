app.post('/products', productUpload, async (req, res) => {
  // 🟢 On récupère "discount" dans le body
  const { shopId, title, description, price, oldPrice, category, condition, size, brand, discount } = req.body;
  const sId = parseInt(shopId);

  try {
    const shop = await prisma.shop.findUnique({ where: { id: sId } });
    if (!shop) return res.status(404).json({ error: "Boutique introuvable" });

    if (!shop.isPremium) {
      const oneWeekAgo = new Date();
      oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
      const countThisWeek = await prisma.product.count({
        where: { shopId: sId, createdAt: { gte: oneWeekAgo } }
      });

      if (countThisWeek >= 2) {
        return res.status(403).json({ 
          error: "LIMIT_REACHED", 
          message: "Limite de 2 produits atteinte. Passez au Premium !" 
        });
      }
    }

    // 🟢 SÉCURITÉ CTO : On n'autorise le discount que si le shop est Premium
    const finalDiscount = shop.isPremium ? (parseInt(discount) || 0) : 0;

    const product = await prisma.product.create({
      data: {
        shopId: sId,
        title,
        description,
        price: parseFloat(price),
        oldPrice: oldPrice ? parseFloat(oldPrice) : null,
        discount: finalDiscount, // 🟢 On enregistre le discount
        category,
        condition,
        size,
        brand,
        images: {
          create: req.files.map(file => ({ url: file.location }))
        }
      },
      include: { images: true }
    });

    res.status(201).json(product);
  } catch (e) {
    res.status(500).json({ error: "Erreur lors de l'ajout" });
  }
});

