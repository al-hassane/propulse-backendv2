        email: { startsWith: emailPrefix },
        id: { not: parseInt(targetUserId) } // Éviter l'auto-vote
      },
      select: { id: true, email: true }
    });

    const existingVotes = await prisma.duelVote.findMany({
      where: {
        duelId: duel.id,
        voterId: { in: usersWithPrefix.map(u => u.id) }
      },
      select: { voterId: true }
    });

    const alreadyVotedIds = new Set(existingVotes.map(v => v.voterId));
    const usersToVote = usersWithPrefix.filter(u => !alreadyVotedIds.has(u.id));

    console.log(`📊 Duel #${duel.id} | Préfixe "${emailPrefix}" | ${usersWithPrefix.length} users | ${alreadyVotedIds.size} ont déjà voté | ${usersToVote.length} à faire voter`);

    if (usersToVote.length === 0) {
      return res.json({
        success: true,
        message: `Tous les users "${emailPrefix}" ont déjà voté pour ce duel.`,
        duelId: duel.id,
        emailPrefix,
        totalUsersWithPrefix: usersWithPrefix.length,
        alreadyVoted: alreadyVotedIds.size,
        inserted: 0
      });
    }

    // 4. Insertion en masse
    const result = await prisma.duelVote.createMany({
      data: usersToVote.map(u => ({
        duelId: duel.id,
        voterId: u.id,
        votedFor: parseInt(targetUserId)
      })),
      skipDuplicates: true
    });

    console.log(`✅ ${result.count} votes insérés pour le user ${targetUserId} dans le duel ${duel.id}`);

    res.json({
      success: true,
      message: `${result.count} votes ajoutés.`,
      duelId: duel.id,
      targetUserId: parseInt(targetUserId),
      emailPrefix,
      totalUsersWithPrefix: usersWithPrefix.length,
      alreadyVotedBefore: alreadyVotedIds.size,
      newlyInserted: result.count,
      skipped: usersToVote.length - result.count
    });

  } catch (error) {
    console.error("❌ Erreur force-vote-prefix:", error);
    res.status(500).json({ error: error.message });
  }
});



