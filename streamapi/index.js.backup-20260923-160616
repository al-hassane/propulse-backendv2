function nextPowerOfTwo(n) {
  if (n <= 4) return 4;
  return Math.pow(2, Math.ceil(Math.log2(n)));
}

app.post('/tournaments/:id/generate-bracket', async (req, res) => {
  const tournamentId = parseInt(req.params.id);
  const { userId } = req.body;

  try {
    const tournament = await prisma.tournament.findUnique({
      where: { id: tournamentId },
      include: {
        participants: {
          where: { status: "ACCEPTED" },
          include: { user: true },
        },
      },
    });
    if (!tournament) return res.status(404).json({ error: "Tournoi introuvable." });

    if (tournament.creatorId !== parseInt(userId)) {
      return res.status(403).json({ error: "Seul le créateur peut générer le tableau." });
    }

    const existing = await prisma.tournamentMatch.count({ where: { tournamentId } });
    if (existing > 0) {
      return res.status(400).json({ error: "Le tableau a déjà été généré pour ce tournoi." });
    }

    const participants = tournament.participants;
    if (participants.length < 2) {
      return res.status(400).json({ error: "Il faut au moins 2 participants acceptés pour générer le tableau." });
    }

    const size = nextPowerOfTwo(participants.length);
    const slots = Array.from({ length: size }, (_, i) => participants[i]?.userId ?? null);

    const roundsData = [];
    let currentSlots = slots;
    while (currentSlots.length >= 2) {
      const matches = [];
      for (let i = 0; i < currentSlots.length; i += 2) {
        matches.push({ playerAId: currentSlots[i], playerBId: currentSlots[i + 1] });
      }
      roundsData.push(matches);
      currentSlots = matches.map(() => null);
    }

    let previousRoundMatches = null;

    for (let roundIndex = 0; roundIndex < roundsData.length; roundIndex++) {
      const matchesToCreate = roundsData[roundIndex];
      const createdMatches = [];

      for (let position = 0; position < matchesToCreate.length; position++) {
        const { playerAId, playerBId } = matchesToCreate[position];
        const match = await prisma.tournamentMatch.create({
          data: {
            tournamentId,
            round: roundIndex,
            position,
            playerAId: playerAId ?? null,
            playerBId: playerBId ?? null,
            status: playerAId && playerBId ? "SCHEDULED" : "PENDING",
          },
        });
        createdMatches.push(match);

        if (previousRoundMatches) {
          const prevA = previousRoundMatches[position * 2];
          const prevB = previousRoundMatches[position * 2 + 1];
          if (prevA) await prisma.tournamentMatch.update({ where: { id: prevA.id }, data: { nextMatchId: match.id } });
          if (prevB) await prisma.tournamentMatch.update({ where: { id: prevB.id }, data: { nextMatchId: match.id } });
        }
      }

      previousRoundMatches = createdMatches;
    }

    const allMatches = await prisma.tournamentMatch.findMany({
      where: { tournamentId },
      include: {
        playerA: { select: { id: true, fullName: true, avatarUrl: true, username: true } },
        playerB: { select: { id: true, fullName: true, avatarUrl: true, username: true } },
      },
      orderBy: [{ round: 'asc' }, { position: 'asc' }],
    });

    res.status(201).json({ message: "Tableau généré !", matches: allMatches });
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Erreur lors de la génération du tableau." });
  }
});

