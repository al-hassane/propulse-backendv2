          where: { user1Id_user2Id: { user1Id: id1, user2Id: id2 } },
          update: { 
            updatedAt: new Date(),
            isArchivedForUser1: false,
            isArchivedForUser2: false
          },
          create: { user1Id: id1, user2Id: id2 }
        });

        const newMessage = await tx.message.create({
          data: {
            conversationId: conversation.id,
            senderId: sId,
            text: message || null,
            mediaType: 'SHARED_ORG_POST',
            sharedOrgPostId: pId
          },
          include: { 
            sender: { select: { id: true, fullName: true, avatarUrl: true } },
            sharedOrgPost: {
            include: {
              organization: { select: { name: true, logo: true } },
              author: { select: { fullName: true } },
              votes: true,  // 🟢 AJOUT pour que le socket envoie les votes
              _count: { select: { likes: true, comments: true, votes: true } }
            }
          }
          }
        });
        results.push({ targetId: tId, message: newMessage, conversationId: conversation.id });
      }
    });

    // 3. Envoi Sockets et Notifications Push
    for (const resItem of results) {
      // Update badge non lu
      io.emit(`unread_count_${resItem.targetId}`, { updated: true });
      
      // Envoi temps réel dans la conv
      io.to(`conv_${resItem.conversationId}`).emit('new_private_message', resItem.message);

      // Notification Push
      const orgName = postToShare.organization.name;
      const pushMsg = message || `Vous a partagé une publication de ${orgName}. 🏢`;

      await createNotification(
        "MESSAGE",
        sId,
        resItem.targetId,
        null, null, null,
        pushMsg,
        null, null, null,
        resItem.conversationId
      );
    }

    res.json({ success: true, count: results.length });
  } catch (error) {
    console.error("Erreur share org post:", error);
    res.status(500).json({ error: "Erreur lors du partage." });
  }
});


app.post('/training-sessions', upload.single('video'), async (req, res) => {
  const { userId, description, intensity, isPublic, targetIds } = req.body;
  const uId = parseInt(userId);

  try {
    // 1. Création de la session
    const session = await prisma.trainingSession.create({
      data: {
        userId: uId,
        videoUrl: req.file ? req.file.location : null,
        description,
        intensity: parseInt(intensity),
        isPublic: isPublic === 'true',
        // Si on a ciblé des gens (targetIds est un tableau JSON)
        targets: targetIds ? {
          create: JSON.parse(targetIds).map(tId => ({ targetUserId: parseInt(tId) }))
        } : undefined
      }
    });

    // 2. LOGIQUE DE STREAK (SÉRIE)
    const user = await prisma.user.findUnique({ where: { id: uId } });
    let newStreak = 1;
    const now = new Date();

    if (user.lastTrainingAt) {
      const lastDate = new Date(user.lastTrainingAt);
      const diffHours = (now - lastDate) / (1000 * 60 * 60);
      
      if (diffHours <= 48 && diffHours >= 18) {
        newStreak = user.trainingStreak + 1; // On continue la série
      } else if (diffHours < 18) {
        newStreak = user.trainingStreak; // Trop tôt pour augmenter, on garde
      }
    }

    await prisma.user.update({
      where: { id: uId },
      data: { trainingStreak: newStreak, lastTrainingAt: now, xp: { increment: 20 } }
    });

    // 3. Notifications aux cibles (Coachs/Amis)
    if (targetIds) {
      const ids = JSON.parse(targetIds);
      for (const tId of ids) {
        await createNotification(
          "TRAINING_INVITE", 
          uId, 
          tId, 
          null, null, null, 
          "t'invite à analyser son entraînement ! 🏃‍♂️", 
          null, null, null, null,
          session.id // 🟢 session.id en 12ème position
        );
      }
    }

    res.status(201).json({ session, streak: newStreak });
  } catch (e) {
    res.status(500).json({ error: e.message });
  }
});

