app.post('/api/payment/apple-verify', async (req, res) => {
  const { userId, receiptData, tier } = req.body;
  const uId = parseInt(userId);

  if (isNaN(uId) || !receiptData) {
    console.log(`⚠️ [IAP] Requête rejetée - userId: ${userId}, receiptData présent: ${!!receiptData}`);
    return res.status(400).json({ error: "Données de reçu manquantes ou invalides." });
  }

  try {
    const verifyReceipt = async (url) => {
      const resp = await axios.post(url, {
        "receipt-data": receiptData,
        "password": process.env.APPLE_IAP_SHARED_SECRET
      });
      return resp.data;
    };

    console.log(`🍏 [IAP] Vérification du reçu Apple pour user ${uId}...`);

    // 1. On tente TOUJOURS la production en premier
    let appleData = await verifyReceipt("https://buy.itunes.apple.com/verifyReceipt");

    // 2. Si Apple dit "ceci est un reçu sandbox", on rebascule automatiquement
    if (appleData.status === 21007) {
      console.log(`🍏 [IAP] Reçu sandbox détecté, bascule vers l'environnement de test...`);
      appleData = await verifyReceipt("https://sandbox.itunes.apple.com/verifyReceipt");
    }

    if (appleData.status === 0) {
      const latestReceiptInfo = appleData.latest_receipt_info;
      const lastTx = Array.isArray(latestReceiptInfo) ? latestReceiptInfo[latestReceiptInfo.length - 1] : latestReceiptInfo;

      const transactionId = lastTx.transaction_id;
      const originalTransactionId = lastTx.original_transaction_id;
      const expiresDateMs = parseInt(lastTx.expires_date_ms);
      const expiryDate = new Date(expiresDateMs);
      const now = new Date();

      await prisma.$transaction([
        prisma.playerCertification.upsert({
          where: { userId: uId },
          update: {
            status: "APPROVED", paymentStatus: true, paymentMethod: "APPLE_IAP",
            paymentGateway: "APPLE_IAP", transactionId, originalTransactionId,
            paymentDate: now, expiryDate, tier: tier
          },
          create: {
            userId: uId,
            realFullName: req.body.realFullName || "Acheteur iOS",
            birthDate: req.body.birthDate || "Non spécifiée",
            status: "APPROVED", paymentStatus: true, paymentMethod: "APPLE_IAP",
            paymentGateway: "APPLE_IAP", transactionId, originalTransactionId,
            paymentDate: now, expiryDate, tier: tier
          }
        }),
        prisma.user.update({
          where: { id: uId },
          data: { isVerified: true, certifTier: tier }
        }),
        prisma.certificationPayment.create({
          data: {
            userId: uId,
            refCommand: `IAP_${transactionId}`,
            token: receiptData.substring(0, 255),
            amount: tier === "ELITE" ? 15000 : tier === "GOLD" ? 5000 : 3000,
            status: "SUCCESS", paymentMethod: "APPLE_IAP", tier: tier, paidAt: now
          }
        })
      ]);

      console.log(`✅ [IAP] Abonnement ${tier} activé pour l'utilisateur ${uId}. Expire le: ${expiryDate}`);
      return res.json({ success: true, message: "Abonnement validé avec succès." });
    } else {
      console.log(`❌ [IAP] Échec validation Apple. Statut code: ${appleData.status}`);
      return res.status(400).json({ error: "Jeton de paiement Apple invalide." });
    }

  } catch (error) {
    console.error("❌ Erreur validation IAP:", error.message);
    res.status(500).json({ error: "Erreur serveur lors de la validation Apple." });
  }
});

