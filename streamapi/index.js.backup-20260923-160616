      // Pour une publication classique : Source principale = Fil (ex: ~75%)
      pVal = 70 + (hashSeed * 2); // 70% à 78%
      sVal = 15 - hashSeed;       // 11% à 15%
      rVal = 100 - pVal - sVal;
