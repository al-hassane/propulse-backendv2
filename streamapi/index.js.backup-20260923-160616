// --- [BACKEND] BLOQUER UN UTILISATEUR (VERSION ÉLITE AVEC TRANSACTION) ---
app.post('/users/:id/block', async (req, res) => {
  const blockerId = parseInt(req.params.id); // Moi
  const { targetId } = req.body; // Lui
  const blockedId = parseInt(targetId);

  if (!blockerId || !blockedId) return res.status(400).json({ error: "Données manquantes" });

  try {
    // 🟢 TRANSACTION : Tout est fait en une seule fois, ou rien n'est fait.
    await prisma.$transaction([
      // A. On crée le blocage (upsert évite le crash si on clique deux fois)
      prisma.block.upsert({
        where: { blockerId_blockedId: { blockerId, blockedId } },
        update: {},
        create: { blockerId, blockedId }
      }),
      // B. On supprime les abonnements (Follow) dans les DEUX sens
      prisma.follow.deleteMany({
        where: {
          OR: [
            { followerId: blockerId, followingId: blockedId }, // Je le suivais
            { followerId: blockedId, followingId: blockerId }  // Il me suivait
          ]
        }
      })
    ]);

    console.log(`🚫 Blocage réussi : User ${blockerId} a bloqué ${blockedId}`);
    res.json({ message: "Utilisateur bloqué et relations rompues." });

  } catch (error) {
    console.error("❌ Erreur Block Server:", error);
    res.status(500).json({ error: "Erreur lors du blocage." });
  }
});

