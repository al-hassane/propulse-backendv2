// Remplacer la route de récupération des conversations par celle-ci (Paginée par 20)
app.get('/users/:id/conversations', async (req, res) => {
  const userId = parseInt(req.params.id);
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 20;
  const skip = (page - 1) * limit;

  try {
    const convs = await prisma.conversation.findMany({
      where: { 
        OR: [
          { user1Id: userId, isArchivedForUser1: false },
          { user2Id: userId, isArchivedForUser2: false }
        ] 
      },
      include: {
        // Remplace user1 et user2 par ça :
        user1: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } },
        user2: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true, certifTier: true, certification: { select: { status: true } }, createdAt: true } },
        messages: { 
          take: 1, 
          orderBy: { createdAt: 'desc' },
          where: { deletions: { none: { userId: userId } } }
        }
      }
    });
    
    // 🟢 Tri intelligent (Épinglés d'abord, puis chronologique inverse)
    const sortedConvs = convs.sort((a, b) => {
      const userIdInt = parseInt(userId);
      const aIsPinned = a.user1Id === userIdInt ? a.isPinned : a.isPinnedForUser2;
      const bIsPinned = b.user1Id === userIdInt ? b.isPinned : b.isPinnedForUser2;
      
      if (aIsPinned && !bIsPinned) return -1;
      if (!aIsPinned && bIsPinned) return 1;
      
      const dateA = a.messages[0] ? new Date(a.messages[0].createdAt) : new Date(a.updatedAt);
      const dateB = b.messages[0] ? new Date(b.messages[0].createdAt) : new Date(b.updatedAt);
      
      return dateB.getTime() - dateA.getTime();
    });

    // 🟢 Extraction de la tranche (pagination)
    const paginatedConvs = sortedConvs.slice(skip, skip + limit);

    res.json({
      data: paginatedConvs,
      pagination: {
        page,
        limit,
        total: sortedConvs.length,
        hasMore: skip + paginatedConvs.length < sortedConvs.length
      }
    });
  } catch (e) { 
    console.error("Erreur serveur conversations:", e);
    res.status(500).json({ data: [], pagination: { page, limit, total: 0, hasMore: false } }); 
  }
});


