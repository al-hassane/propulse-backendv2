app.put('/users/:id/phone-setup', async (req, res) => {
  const { id } = req.params;
  const { phoneCountryCode, phoneNumber } = req.body;

  try {
    // 1. On nettoie le numéro (enlever les espaces ou points)
    const cleanNumber = phoneNumber.replace(/\s/g, '');

    // 2. On vérifie si ce numéro est déjà pris
    const existing = await prisma.user.findFirst({
      where: { 
        phoneNumber: cleanNumber,
        id: { not: parseInt(id) }
      }
    });

    if (existing) {
      return res.status(409).json({ error: "Ce numéro est déjà utilisé par un autre compte." });
    }

    // 3. Mise à jour de l'utilisateur
    const updatedUser = await prisma.user.update({
      where: { id: parseInt(id) },
      data: { 
        phoneCountryCode: phoneCountryCode,
        phoneNumber: cleanNumber 
      }
    });

    const { password, ...safeUser } = updatedUser;
    res.json({ message: "Numéro enregistré !", user: safeUser });

  } catch (error) {
    res.status(500).json({ error: "Erreur lors de l'enregistrement." });
  }
});


// --- SUPPRESSION TOTALE ET SÉCURISÉE DU COMPTE ---
app.delete('/users/:id', async (req, res) => {
  const { id } = req.params;
  const userId = parseInt(id);

  try {
    // ÉTAPE PRÉALABLE : Récupérer les IDs des entités possédées pour nettoyer leurs enfants
    const userOwnedData = await prisma.user.findUnique({
      where: { id: userId },
      include: {
        shop: { select: { id: true } },
        ownedCommunities: { select: { id: true } },
        posts: { select: { id: true } }
      }
    });

    if (!userOwnedData) return res.status(404).json({ error: "Utilisateur introuvable" });

    const shopId = userOwnedData.shop?.id;
    const communityIds = userOwnedData.ownedCommunities.map(c => c.id);
    const postIds = userOwnedData.posts.map(p => p.id);

    // DÉBUT DE LA TRANSACTION
    await prisma.$transaction([
      
      // 1. RÉSEAU SOCIAL & INTERACTIONS DE BASE
      prisma.follow.deleteMany({ where: { OR: [{ followerId: userId }, { followingId: userId }] } }),
      prisma.block.deleteMany({ where: { OR: [{ blockerId: userId }, { blockedId: userId }] } }),
      prisma.notification.deleteMany({ where: { OR: [{ senderId: userId }, { receiverId: userId }] } }),
      prisma.share.deleteMany({ where: { OR: [{ senderId: userId }, { receiverId: userId }] } }),
      prisma.suggestionDismiss.deleteMany({ where: { OR: [{ userId: userId }, { targetId: userId }] } }),

      // 2. ACTIVITÉ SUR LES CONTENUS (Likes, Notes, Signalements)
      prisma.like.deleteMany({ where: { userId: userId } }),
      prisma.savedPost.deleteMany({ where: { userId: userId } }),
      prisma.hiddenPost.deleteMany({ where: { userId: userId } }),
      prisma.report.deleteMany({ where: { OR: [{ reporterId: userId }, { postId: { in: postIds } }] } }),
      prisma.ratingLike.deleteMany({ where: { userId: userId } }),
      prisma.rating.deleteMany({ where: { OR: [{ userId: userId }, { postId: { in: postIds } }] } }),
      prisma.duelVote.deleteMany({ where: { voterId: userId } }),

      // 3. SYSTÈME DE STORIES
      prisma.storyLike.deleteMany({ where: { userId: userId } }),
      prisma.storyFlame.deleteMany({ where: { userId: userId } }),
      prisma.storyView.deleteMany({ where: { userId: userId } }),
      prisma.storyComment.deleteMany({ where: { userId: userId } }),
      prisma.story.deleteMany({ where: { userId: userId } }),

      // 4. ÉVÉNEMENTS & SCOUTING
      prisma.eventParticipant.deleteMany({ where: { userId: userId } }),
      prisma.targetPlayer.deleteMany({ where: { OR: [{ managerId: userId }, { playerId: userId }] } }),
      prisma.event.deleteMany({ where: { userId: userId } }),

      // 5. COMMUNAUTÉS (CLUBS)
      // On supprime les demandes et on déconnecte les membres des clubs possédés
      prisma.communityRequest.deleteMany({ where: { OR: [{ userId: userId }, { communityId: { in: communityIds } }] } }),
      // On supprime les posts liés aux clubs du manager
      prisma.post.deleteMany({ where: { communityId: { in: communityIds } } }),
      // On supprime les clubs eux-mêmes
      prisma.community.deleteMany({ where: { ownerId: userId } }),

      // 6. E-COMMERCE (SHOP)
      ...(shopId ? [
        // Supprimer les images et likes des produits de la boutique
        prisma.productImage.deleteMany({ where: { product: { shopId: shopId } } }),
        prisma.productLike.deleteMany({ where: { product: { shopId: shopId } } }),
        // Supprimer les items de commandes liés aux produits de la boutique
        prisma.orderItem.deleteMany({ where: { product: { shopId: shopId } } }),
        // Supprimer les produits
        prisma.product.deleteMany({ where: { shopId: shopId } }),
        // Supprimer les commandes reçues par la boutique
        prisma.order.deleteMany({ where: { shopId: shopId } }),
        // Supprimer la boutique
        prisma.shop.delete({ where: { id: shopId } }),
      ] : []),

      // 7. DONNÉES PERSONNELLES RESTANTES
      prisma.playerCertification.deleteMany({ where: { userId: userId } }),
      prisma.supportTicket.deleteMany({ where: { userId: userId } }),
      prisma.productLike.deleteMany({ where: { userId: userId } }),
      prisma.order.deleteMany({ where: { buyerId: userId } }), // Commandes passées par l'user

      // 8. SUPPRESSION DES POSTS PERSONNELS (Si pas déjà fait via clubs)
      prisma.post.deleteMany({ where: { userId: userId } }),

      // 9. ENFIN, L'UTILISATEUR
      // ✅ Version blindée
      prisma.user.deleteMany({ where: { id: userId } }),
    ]);

    console.log(`🚀 Nettoyage complet réussi pour l'utilisateur ${userId}`);
    res.json({ message: "Compte supprimé avec succès." });

  } catch (error) {
    console.error("❌ Erreur critique suppression:", error);
    res.status(500).json({ 
      error: "Erreur serveur lors de la suppression.",
      details: error.message 
    });
  }
});


