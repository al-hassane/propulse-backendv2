// --- [ADMIN] STATISTIQUES FINANCIÈRES ÉLITE ---
app.get('/admin/finances/stats', async (req, res) => {
  try {
    const [playerCerts, clubCerts, config] = await Promise.all([
      prisma.playerCertification.findMany({ where: { status: 'APPROVED' } }),
      prisma.communityCertification.findMany({ where: { status: 'APPROVED' } }),
      prisma.systemConfig.findFirst()
    ]);

    const pPrice = config?.playerPrice || 1000;
    const cPrice = config?.clubPrice || 100000;

    // Calculs globaux
    const playerRevenue = playerCerts.length * pPrice;
    const clubRevenue = clubCerts.length * cPrice;

    // Répartition par méthode (Total combiné)
    const waveRevenue = 
      (playerCerts.filter(p => p.paymentMethod === 'WAVE').length * pPrice) +
      (clubCerts.filter(c => c.paymentMethod === 'WAVE').length * cPrice);

    const orangeRevenue = 
      (playerCerts.filter(p => p.paymentMethod === 'ORANGE_MONEY').length * pPrice) +
      (clubCerts.filter(c => c.paymentMethod === 'ORANGE_MONEY').length * cPrice);

    res.json({
      summary: {
        grandTotal: playerRevenue + clubRevenue,
        playerTotal: playerRevenue,
        clubTotal: clubRevenue,
        totalTransactions: playerCerts.length + clubCerts.length
      },
      methods: {
        wave: waveRevenue,
        orange: orangeRevenue
      },
      // On envoie les données brutes pour les graphiques (triées par date)
      history: {
        players: playerCerts.map(p => ({ date: p.updatedAt, amount: pPrice })),
        clubs: clubCerts.map(c => ({ date: c.updatedAt, amount: cPrice }))
      }
    });
  } catch (e) {
    res.status(500).json({ error: "Erreur finance stats" });
  }
});


