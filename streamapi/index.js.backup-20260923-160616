    if (type === "story") {
      // Pour une story : Source principale = Stories (ex: ~75%)
      pVal = 10 + hashSeed; // 10% à 14%
      sVal = 75 - (hashSeed * 2); // 67% à 75%
      rVal = 100 - pVal - sVal;
    } else if (postTypeMap[contentId] === 'reels') {
