// --- FONCTION POUR CLÔTURER LE DUEL (CORRIGÉE) ---
async function closeLastDuel() {
  const now = new Date();
  
  // 1. On cherche le duel qui est expiré mais qui n'a pas encore de vainqueur
  const lastDuel = await prisma.duel.findFirst({
    where: { 
      winnerId: null, 
      expiresAt: { lte: now } 
    },
    include: { 
      post1: true,
      post2: true
    }
  });

  if (!lastDuel) {
    console.log("ℹ️ Aucun duel à clôturer.");
    return;
  }

  // 2. COMPTAGE DES VOTES
  const v1 = await prisma.duelVote.count({ 
    where: { duelId: lastDuel.id, votedFor: lastDuel.post1.userId } 
  });
  const v2 = await prisma.duelVote.count({ 
    where: { duelId: lastDuel.id, votedFor: lastDuel.post2.userId } 
  });

  const totalVotes = v1 + v2;
  console.log(`📊 Clôture Duel ${lastDuel.id}: P1=${v1} votes, P2=${v2} votes`);

  // 3. DÉTERMINATION DU VAINQUEUR
  let winnerId = null;
  if (v1 > v2) winnerId = lastDuel.post1.userId;
  else if (v2 > v1) winnerId = lastDuel.post2.userId;
  else {
      winnerId = lastDuel.post1.userId; // Égalité -> Joueur 1
  }

  if (winnerId) {
    // --- 🟢 RÉCOMPENSE VAINQUEUR (+100 XP) ---
    await prisma.user.update({
      where: { id: winnerId },
      data: { xp: { increment: 100 } }
    });

    // --- 🟢 RÉCOMPENSE ET NOTIFICATIONS VOTANTS (+5 XP) ---
    // On récupère les IDs et les Push Tokens des gens qui ont voté pour le gagnant
    const correctVoters = await prisma.duelVote.findMany({
      where: { duelId: lastDuel.id, votedFor: winnerId },
      include: { user: { select: { id: true, pushToken: true } } }
    });

    const voterIds = correctVoters.map(v => v.voterId);

    if (voterIds.length > 0) {
      // A. Mise à jour XP massive
      await prisma.user.updateMany({
        where: { id: { in: voterIds } },
        data: { xp: { increment: 5 } }
      });

      // B. Création des notifications In-App (en base de données)
      const voterNotifications = voterIds.map(vId => ({
        type: 'VOTE_WIN',
        senderId: winnerId, // Le gagnant est "l'expéditeur" symbolique
        receiverId: vId,
        message: "Bien joué ! Tu as voté pour le vainqueur. Tu gagnes +5 XP ! 🧠"
      }));

      await prisma.notification.createMany({ data: voterNotifications });

      // C. Envoi des Push Notifications (via Expo en Chunks pour la performance)
      let pushMessages = [];
      for (let voter of correctVoters) {
        if (voter.user.pushToken && Expo.isExpoPushToken(voter.user.pushToken)) {
          pushMessages.push({
            to: voter.user.pushToken,
            sound: 'default',
            title: 'ProPulse Expert 🧠',
            body: 'Bien joué ! Ton vote était le bon. Tu gagnes +5 XP !',
            data: { url: '/notifications', type: 'VOTE_WIN' },
          });
        }
      }

      // On envoie les pushs par paquets de 100 pour ne pas saturer le serveur cote serveur 
      let chunks = expo.chunkPushNotifications(pushMessages);
      for (let chunk of chunks) {
        try {
          await expo.sendPushNotificationsAsync(chunk);
        } catch (error) {
          console.error("Erreur envoi push votants:", error);
        }
      }
    }

    // --- 🟢 LOGIQUE REVANCHE ---
    const diffPercent = totalVotes > 0 ? Math.abs((v1 - v2) / totalVotes) * 100 : 0;
    const isTightMatch = totalVotes >= 10 && diffPercent <= 5;

    // 4. ENREGISTRER LE GAGNANT DANS LA TABLE DUEL
    await prisma.duel.update({ 
      where: { id: lastDuel.id }, 
      data: { winnerId: winnerId } 
    });

    // 5. NOTIFICATION DU VAINQUEUR
    const winPercent = totalVotes > 0 ? Math.round((Math.max(v1, v2) / totalVotes) * 100) : 0;
    let victoryMessage = `Félicitations ! Tu as remporté le Duel avec ${winPercent}% des voix ! +100 XP 🏆`;
    if (isTightMatch) victoryMessage += " C'était très serré, une revanche se prépare !";

    await createNotification("DUEL_WIN", winnerId, winnerId, null, null, null, victoryMessage);

    console.log(`🏆 Succès : Gagnant ${winnerId} (+100XP) | ${voterIds.length} votants (+5XP + Notifs)`);
  }
}


