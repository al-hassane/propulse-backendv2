// --- [BACKEND] PUBLIER UNE ACTUALITÉ AVEC NOTIFICATION CIBLÉE (VERSION SÉCURISÉE CTO) ---
app.post('/admin/news', upload.single('image'), async (req, res) => {
  const { title, content, source, category } = req.body;

  try {
    // 1. Normalisation de la catégorie
    const targetCategory = category ? category.toLowerCase().trim() : "football";
    
    // 2. 🟢 TROUVER UN EXPÉDITEUR RÉEL (Indispensable pour l'affichage mobile)
    // On cherche l'admin, s'il n'y en a pas, on prend le tout premier utilisateur de la base
    let officialSender = await prisma.user.findFirst({ where: { role: 'admin' } });
    if (!officialSender) {
        officialSender = await prisma.user.findFirst(); 
    }

    // Si la base est vraiment vide (pas d'admin, pas d'user), on s'arrête
    if (!officialSender) {
      return res.status(400).json({ error: "Aucun utilisateur trouvé pour envoyer la notification." });
    }
    
    const senderId = officialSender.id; // On utilise son VRAI ID (ex: 42, 105, etc.)

    // 3. Création de l'article
    const article = await prisma.newsArticle.create({
      data: {
        title,
        content,
        source,
        category: targetCategory,
        imageUrl: req.file ? req.file.location : null,
      }
    });

    // 4. Ciblage des utilisateurs
    const targetUsers = await prisma.user.findMany({
      where: {
        pushToken: { not: null },
        OR: [
          { sport: { equals: targetCategory, mode: 'insensitive' } }, 
          { role: 'manager' }
        ]
      },
      select: { id: true, pushToken: true }
    });

    if (targetUsers.length > 0) {
      console.log(`🚀 Diffusion à ${targetUsers.length} comptes avec Sender ID: ${senderId}`);

      // A. Sauvegarde In-App
      const notificationsData = targetUsers.map(u => ({
        type: 'NEWS',
        receiverId: u.id,
        senderId: senderId, // 🟢 ID Garanti existant
        newsId: article.id,
        message: title 
      }));

      await prisma.notification.createMany({
        data: notificationsData,
        skipDuplicates: true
      });

      // B. Push Notifications
      let pushMessages = [];
      const capitalizedSport = targetCategory.charAt(0).toUpperCase() + targetCategory.slice(1);
      
      for (let user of targetUsers) {
        if (Expo.isExpoPushToken(user.pushToken)) {
          pushMessages.push({
            to: user.pushToken,
            sound: 'default',
            title: `📰 Actu ${capitalizedSport}`,
            body: title,
            image: getThumbnailUrl(article.imageUrl),
            data: { 
                url: `/news-detail`, 
                params: { id: article.id },
                type: 'NEWS', 
                newsId: article.id 
            },
          });
        }
      }

      let chunks = expo.chunkPushNotifications(pushMessages);
      for (let chunk of chunks) {
        try {
          await expo.sendPushNotificationsAsync(chunk);
        } catch (error) {
          console.error("❌ Erreur Push:", error);
        }
      }
    }
    
    await createAdminNotif('NEW_ACTU', `Article "${title}" diffusé.`);
    res.status(201).json(article);

  } catch (e) {
    console.error("❌ ERREUR CRITIQUE:", e);
    res.status(500).json({ error: "Erreur serveur", details: e.message });
  }
});


// --- RÉCUPÉRER LES ACTUS (AVEC RECHERCHE & FILTRES) ---
app.get('/news', async (req, res) => {
  const { category, sort, userId, search } = req.query; // <--- On récupère "search" ici

  try {
    let whereCondition = {};

    // 1. FILTRE PAR CATÉGORIE
    if (category && category !== 'ALL') {
      whereCondition.category = category;
    }

    // 2. LOGIQUE DE RECHERCHE (CTO FIX)
    if (search && search.trim() !== "") {
      whereCondition.OR = [
        { title: { contains: search, mode: 'insensitive' } }, // Cherche dans le titre
        { content: { contains: search, mode: 'insensitive' } } // Cherche aussi dans le contenu
      ];
    }

    let articles = await prisma.newsArticle.findMany({
      where: whereCondition,
      include: {
        likes: true 
      },
      orderBy: sort === 'RECENT' ? { createdAt: 'desc' } : undefined
    });

    // --- LOGIQUE DE TRI POPULAIRE (Si demandé) ---
    if (sort === 'POPULAR') {
      articles.sort((a, b) => {
        const scoreA = (a.likes.filter(l => l.type === 'LIKE').length * 2) + a.views;
        const scoreB = (b.likes.filter(l => l.type === 'LIKE').length * 2) + b.views;
        return scoreB - scoreA;
      });
    }

    // Formatage pour le frontend
    const formattedNews = articles.map(art => ({
        ...art,
        likesCount: art.likes.filter(l => l.type === 'LIKE').length,
        userReaction: userId ? art.likes.find(l => l.userId === parseInt(userId))?.type : null,
        likes: undefined
    }));

    res.json(formattedNews);
  } catch (e) {
    console.error("Erreur recherche news:", e);
    res.status(500).json({ error: "Erreur serveur" });
  }
});

