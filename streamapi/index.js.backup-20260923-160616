// Vérifier si l'utilisateur a besoin d'un feed personnalisé
async function needsPersonalizedFeed(userId) {
  // Un utilisateur a besoin d'un feed personnalisé s'il :
  // - A déjà interagi (likes, comments)
  // - Est revenu plusieurs fois
  // - Son cache Redis existe déjà
  
  const [interactions, cacheExists] = await Promise.all([
    prisma.like.count({ where: { userId } }),
    redisClient ? await redisClient.exists(`ai:user:${userId}`) : 0
  ]);
  
  return interactions >= 5 || cacheExists === 1;
}

