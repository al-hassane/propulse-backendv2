// 🟢 [BACKEND] ROUTE DISCOVERY ÉLITE (TAGS + SPORT + RECHERCHE PAGINÉE)
// =========================================================================
app.get('/posts/discovery', async (req, res) => {
    const { tag, sport, role, userId, search } = req.query;
    
    // Définition des paramètres de pagination
    const page = parseInt(req.query.page) || 1;
    const limit = parseInt(req.query.limit) || 15;
    const skip = (page - 1) * limit;
    const currentUserId = (userId && userId !== "null" && userId !== "undefined") ? parseInt(userId) : null;
 
    try {
      // 1. Gestion des Mutes
      let mutedUserIds = [];
      if (currentUserId && !isNaN(currentUserId)) {
        const mutes = await prisma.mute.findMany({
          where: { muterId: currentUserId, mutePosts: true },
          select: { mutedId: true }
        });
        mutedUserIds = mutes.map(m => m.mutedId);
      }
 
      // 2. Conditions de filtrage de base
      let andConditions = [{ isArchived: false }];

      // 🟢 AJOUTE CE BLOC POUR LE FILTRE PAR RÔLE
    if (role && role !== "null" && role !== "undefined" && role !== "") {
      andConditions.push({
        user: {
          role: { equals: role, mode: 'insensitive' }
        }
      });
    }

      if (mutedUserIds.length > 0) andConditions.push({ userId: { notIn: mutedUserIds } });
 
      // Logique de recherche textuelle
      if (search && search.trim() !== "") {
        andConditions.push({
          OR: [
            { description: { contains: search, mode: 'insensitive' } },
            { user: { fullName: { contains: search, mode: 'insensitive' } } }
          ]
        });
      }

      // Logique de filtrage par Tag
      if (tag && tag !== "null" && tag !== "undefined" && tag !== "") {
        andConditions.push({
          tags: {
            contains: tag.trim(),
            mode: 'insensitive'
          }
        });
      } else if (!search) {
        // Option Explore propre sans recherche textuelle : requiert au moins un tag
        andConditions.push({
          AND: [
            { tags: { not: null } },
            { tags: { not: "" } }
          ]
        });
      }
 
      // Filtre par Sport
      if (sport && sport !== "Tous" && sport !== "null" && sport !== "undefined") {
        andConditions.push({ sport: { equals: sport.toLowerCase(), mode: 'insensitive' } });
      }
 
      // Sécurité : Blocages mutuels
      if (currentUserId && !isNaN(currentUserId)) {
        andConditions.push({
          user: {
            AND: [
              { blockedBy: { none: { blockerId: currentUserId } } },
              { blockedUsers: { none: { blockedId: currentUserId } } }
            ]
          }
        });
        andConditions.push({ hiddenBy: { none: { userId: currentUserId } } });
      }

      // 🟢 Ajoute ceci juste après les autres filtres (tag, sport, etc.)
        if (req.query.mediaType) {
          andConditions.push({ mediaType: req.query.mediaType.toUpperCase() }); // IMAGE ou VIDEO
        }
 
      // 3. Récupération du compte total d'enregistrements correspondants
      const totalCount = await prisma.post.count({
        where: { AND: andConditions }
      });

      // 4. Récupération paginée des publications
      const posts = await prisma.post.findMany({
        where: { AND: andConditions },
        include: {
          user: { include: { certification: true, followedBy: { where: { followerId: currentUserId || 0 } } } },
          media: true,
          savedBy: true,
          ratings: true,
          community: true,
          votes: true,
          mentions: { include: { user: { select: { id: true, fullName: true, avatarUrl: true, certification: true } } } },
          likes: {
            include: {
              user: {
                include: {
                  followedBy: { where: { followerId: currentUserId || 0 }, select: { status: true } },
                  certification: true
                }
              }
            }
          },
          _count: { select: { ratings: true, votes: true, likes: true } }
        },
        orderBy: { createdAt: 'desc' },
        take: limit,
        skip: skip
      });
 
      // 5. Formatage des données
      const responseData = posts.map(p => {
        const myVote = (p.votes && currentUserId) ? p.votes.find(v => v.userId === currentUserId) : null;
        const validRatings = (p.ratings || []).filter(r => r.score > 0);
        const avg = validRatings.length > 0 ? validRatings.reduce((acc, r) => acc + r.score, 0) / validRatings.length : 0;
 
        return {
          ...p,
          averageRating: avg.toFixed(1),
          userVote: myVote ? myVote.option : null,
          pollStats: {
            YES: (p.votes || []).filter(v => v.option === 'YES').length,
            NO: (p.votes || []).filter(v => v.option === 'NO').length
          },
          votes: undefined
        };
      });
 
      // Retour du format enveloppé compatible avec votre logique mobile (newList/hasMoreData)
      res.json({
        data: responseData,
        pagination: {
          page,
          limit,
          total: totalCount,
          hasMore: skip + responseData.length < totalCount
        }
      });

    } catch (error) {
      console.error("❌ Erreur Discovery Elite paginé:", error);
      res.status(500).json({ error: error.message });
    }
});

