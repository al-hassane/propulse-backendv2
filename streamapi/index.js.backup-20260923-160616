// Route : Récupérer les notifications paginées ET filtrées (CTO Optimisation)
app.get('/users/:id/notifications', async (req, res) => {
  const { id } = req.params;
  const timerLabel = `notifs_${id}_${Date.now()}`;  // 🟢 Label unique
  console.time(timerLabel);                    // 🟢 CETTE LIGNE MANQUAIT
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 15;
  const skip = (page - 1) * limit;
  const typeFilter = req.query.type || "ALL";

  try {
    const whereCondition = { receiverId: parseInt(id) };

    if (typeFilter && typeFilter !== "ALL") {
      if (typeFilter === "LIKE") {
        whereCondition.type = {
          in: ["LIKE", "COMMENT_LIKE", "STORY_LIKE", "STORY_FLAME", "VOTE_WIN", "SHOP_LIKE"]
        };
      } else if (typeFilter === "COMMENT") {
        whereCondition.type = {
          in: ["COMMENT", "STORY_COMMENT"]
        };
      } else if (typeFilter === "FOLLOW") {
        whereCondition.type = {
          in: ["FOLLOW", "ACCEPTED_REQUEST"]
        };
      } else {
        whereCondition.type = typeFilter;
      }
    }

    const notifs = await prisma.notification.findMany({
      where: whereCondition,
      skip: skip,
      take: limit,
      // 🟢 select ciblé au lieu de include complet : beaucoup moins de données ramenées
      select: {
        id: true,
        type: true,
        message: true,
        isRead: true,
        requestStatus: true,
