          try {
            await prisma.stadium.upsert({
              where: { osmId },
              update: {},
              create: {
                osmId,
                name,
                address: el.tags?.["addr:street"] || el.tags?.["addr:city"] || null,
                city: el.tags?.["addr:city"] || null,
                country: el.tags?.["addr:country"] || null,
                latitude: elLat,
                longitude: elLon,
                sport: detectSportFromName(name),
                wikipedia: el.tags?.wikipedia || null,
                imageUrl: el.tags?.image || null,
              },
            });
          } catch (e) {
            // Ignore les doublons
          }
        }

        // Recalcul après insertion
        const allStadiums2 = await prisma.stadium.findMany();

        const nearby2 = allStadiums2
          .map((s) => {
            if (s.latitude == null || s.longitude == null) return null;
            return {
              ...s,
              distance: calculateDistanceKm(myLat, myLng, s.latitude, s.longitude),
            };
          })
          .filter((s) => s !== null && s.distance <= radiusKm)
          .sort((a, b) => a.distance - b.distance);

        console.log(`   🎉 Total après Overpass: ${nearby2.length} stades`);

        // 🟢 FILTRE : même chose pour nearby2
        nearby2.forEach((s) => {
          const trimmed = (s.name || '').trim().toLowerCase();
          if (trimmed === 'stade' || trimmed === 'stadium') {
            s.imageUrl = null;
          }
        });

        // 🟢 5. Enrichissement Wikipedia avec FILTRE ANTI-FAUX-MATCHS
        const WIKI_HEADERS = {
          'User-Agent': 'ProPulseApp/1.0 (contact@propulse-sn.com)',
          'Accept': 'application/json',
        };

        const topStadiums = nearby2.slice(0, 20);
        console.log(`   📸 Enrichissement Wiki pour ${topStadiums.length} stades...`);

        await Promise.all(
          topStadiums.map(async (s) => {
            if (s.imageUrl) return;

            // 🟢 On ignore d'emblée les noms trop génériques
            // 🟢 On ignore d'emblée les noms trop génériques
            const trimmedName = (s.name || '').trim().toLowerCase();
            if (
