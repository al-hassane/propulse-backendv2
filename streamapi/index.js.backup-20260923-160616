// ==========================================
// 🔐 [ADMIN] LISTER LES MESSAGES DE CONTACT
// ==========================================
app.get('/admin/contact-messages', async (req, res) => {
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 20;
  const skip = (page - 1) * limit;
  const status = req.query.status; // "NEW", "READ", "REPLIED", "ARCHIVED" ou vide
  const type = req.query.type;     // "support", "partner"...

  try {
    const whereCondition = {};
    if (status && status !== "ALL") whereCondition.status = status;
    if (type && type !== "ALL") whereCondition.type = type;

    const [messages, totalCount, countsByStatus] = await Promise.all([
      prisma.contactMessage.findMany({
        where: whereCondition,
        include: {
          user: { 
            select: { 
              id: true, fullName: true, avatarUrl: true, role: true, 
              isVerified: true, certifTier: true 
            } 
          }
        },
        orderBy: { createdAt: 'desc' },
        take: limit,
        skip: skip
      }),
      prisma.contactMessage.count({ where: whereCondition }),
      // 🟢 Compteurs par statut pour les badges du dashboard
      prisma.contactMessage.groupBy({
        by: ['status'],
        _count: { status: true }
      })
    ]);

    // Transformer les compteurs en objet simple
    const statusCounts = { NEW: 0, READ: 0, REPLIED: 0, ARCHIVED: 0 };
    countsByStatus.forEach(c => {
      statusCounts[c.status] = c._count.status;
    });

    res.json({
      data: messages,
      pagination: {
        page,
        limit,
        total: totalCount,
        hasMore: skip + messages.length < totalCount
      },
      statusCounts
    });

  } catch (error) {
    console.error("❌ Erreur admin contact-messages:", error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});

