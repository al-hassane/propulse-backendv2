const CLOUDFRONT_URL = process.env.CLOUDFRONT_URL || null;

function toCdnUrl(s3Url) {
  if (!CLOUDFRONT_URL || !s3Url) return s3Url;
  
  // Ne transforme que les URLs de ton bucket S3
  if (!s3Url.includes('propulse-media-final-storage.s3')) return s3Url;
  
  return s3Url.replace(
    /^https:\/\/[^/]+\.s3\.[^/]+\.amazonaws\.com/,
    CLOUDFRONT_URL
  );
}


const getThumbnailUrl = (url) => {
  if (!url) return null;
  
  // Transforme l'URL S3 en CloudFront si nécessaire
  const cdnUrl = toCdnUrl(url);
  
  // Pour les vidéos, la miniature est un JPG avec le même nom
  if (cdnUrl.match(/\.(mp4|mov|avi|m4v)$/i)) {
    return cdnUrl.replace(/\.[^/.]+$/, ".jpg");
  }
  
  return cdnUrl;
};



