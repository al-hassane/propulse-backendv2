    const summary = {
      dismissed: stats.find(s => s.action === 'DISMISS')?._count.action || 0,
      opened: stats.find(s => s.action === 'OPEN_DETAILS')?._count.action || 0,
      started: stats.find(s => s.action  === 'START_CV')?._count.action || 0,
      total: stats.reduce((acc, curr) => acc + curr._count.action, 0)
    };

    res.json({
      summary,
      interactions: logs
    });

  } catch (e) {
    console.error("Erreur dashboard teaser:", e);
