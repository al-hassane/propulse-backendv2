// 🚀 MIDDLEWARE CACHE CONTROLE (Cloudflare + Navigateur)
// ==========================================
app.use((req, res, next) => {
  // Ne pas cacher les requêtes POST, PUT, DELETE
  if (req.method !== 'GET') {
    res.setHeader('Cache-Control', 'no-cache, no-store, must-revalidate');
    return next();
  }

  const url = req.url;
  console.log("🔍 URL reçue:", url);
  
  // 1. Feed posts / discovery → 30 secondes
  if (url.match(/\/posts($|\?)/) || url.match(/\/discovery/) || url.match(/\/reels/)) {
    res.setHeader('Cache-Control', 'public, max-age=30');
  }
  // 2. Uniquement la recherche globale de talents (ex: /users ou /users?search=...) → 5 minutes
  else if (
    (url === '/users' || url.startsWith('/users?')) && 
    !url.includes('/notifications') && 
    !url.includes('/posts') &&
    !url.includes('/conversations') && 
    !url.includes('/unread-chat-count') 
  ) {
    res.setHeader('Cache-Control', 'public, max-age=300');
  }
  // 🟢 PLACÉ EN POSITION 3 : LES RÈGLES SANS CACHE (Elles s'appliquent en priorité)
  else if (
    url.match(/\/users\/\d+/) ||    
    url.match(/\/stories/) || 
    url.match(/\/notifications/) || 
    url.match(/\/messages/) || 
    url.match(/\/conversations/) || 
    url.match(/\/socket\.io/) ||
    url.includes('/mercato') ||     // Pas de cache pour le mercato live
    url.includes('/events')         // Pas de cache pour l'agenda live
  ) {
    res.setHeader('Cache-Control', 'no-cache, no-store, must-revalidate');
  }
  // 🔴 PLACÉ EN POSITION 4 : LES RÈGLES DE CACHE GÉNÉRALES
  else if (url.match(/\/events/) || url.match(/\/communities/)) {
    res.setHeader('Cache-Control', 'public, max-age=600');
  }
  // 5. Par défaut → 1 minute
  else {
    res.setHeader('Cache-Control', 'public, max-age=60');
  }
  
  next();
});


