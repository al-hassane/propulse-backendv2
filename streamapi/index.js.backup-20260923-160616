// --- ROUTE DASHBOARD JOUEUR (STATISTIQUES COMPLÈTES) ---
app.get('/users/:id/player-stats', async (req, res) => {
  const userId = parseInt(req.params.id);

  try {
    // 1. On récupère les infos de base et les records du joueur
    const user = await prisma.user.findUnique({
      where: { id: userId },
      select: { xp: true, level: true, createdAt: true }
    });

     // 1. On récupère les parrainages réussis
    const referralCount = await prisma.user.count({
      where: { referredById: userId }
    });


    // 2. CALCUL DES FLAMMES (Stories)
    // On compte toutes les flammes reçues sur toutes ses stories
    const totalFlames = await prisma.storyFlame.count({
      where: { story: { userId: userId } }
    });

    // 3. CALCUL DES VOTES (Reels)
    // On récupère tous ses posts qui ont un sondage
    const myPolls = await prisma.post.findMany({
      where: { userId: userId, hasPoll: true },
      include: { _count: { select: { votes: true } }, votes: true }
    });

    const totalVotesReceived = myPolls.reduce((acc, p) => acc + p._count.votes, 0);
    const totalYesVotes = myPolls.reduce((acc, p) => {
      return acc + p.votes.filter(v => v.option === 'YES').length;
    }, 0);
    
    // Taux d'approbation (ex: 85% de OUI)
    const approvalRate = totalVotesReceived > 0 
      ? Math.round((totalYesVotes / totalVotesReceived) * 100) 
      : 0;

    // 4. BILAN DES DUELS
    const wins = await prisma.duel.count({ where: { winnerId: userId } });
    // On compte les participations (Post1 ou Post2)
    const participations = await prisma.duel.count({
      where: {
        OR: [
          { post1: { userId: userId } },
          { post2: { userId: userId } }
        ],
        winnerId: { not: null } // Uniquement les duels terminés
      }
    });
    const losses = participations - wins;

    // 5. TOP POSTS (Les 3 mieux notés ou plus likés)
    const topPosts = await prisma.post.findMany({
      where: { userId: userId, isArchived: false },
      take: 10,
      orderBy: { likes: { _count: 'desc' } },
      include: { 
        media: true, // <--- CRUCIAL
        _count: { select: { likes: true, ratings: true } } 
      }
    });

    // --- LOGIQUE XP (Calcul dynamique du niveau) ---
    // On définit des points : 
    // 1 Like = 2xp | 1 Flame = 5xp | 1 Vote = 1xp | 1 Win Duel = 50xp
    const totalLikes = await prisma.like.count({ where: { post: { userId: userId } } });
     const calculatedXP = 
      (totalLikes * 2) + 
      (totalFlames * 5) + 
      (totalVotesReceived * 1) + 
      (wins * 50) + 
      (referralCount * 100); // <-- Ajout des points ambassadeur
    
    // Calcul du niveau simple : tous les 500xp on monte d'un niveau
    const calculatedLevel = Math.floor(calculatedXP / 500) + 1;

    // Mise à jour silencieuse en BDD (Optionnel pour garder la trace)
    await prisma.user.update({
      where: { id: userId },
      data: { xp: calculatedXP, level: calculatedLevel }
    });

    // 6. RÉPONSE FINALE
    res.json({
      overview: {
        xp: calculatedXP,
        level: calculatedLevel,
        referrals: referralCount, // Optionnel : renvoyer le nombre d'amis
        totalInteractions: totalLikes + totalFlames + totalVotesReceived
      },
      stories: {
        flames: totalFlames,
      },
      reels: {
        votes: totalVotesReceived,
        approvalRate: approvalRate + "%"
      },
      duels: {
        wins: wins,
        losses: losses,
        total: participations
      },
      topContent: topPosts
    });

  } catch (error) {
    console.error("Erreur Stats Dashboard:", error);
    res.status(500).json({ error: "Impossible de générer les statistiques" });
  }
});


