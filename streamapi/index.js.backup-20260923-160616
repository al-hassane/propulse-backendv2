    const getPercent = (val, total) => total > 0 ? parseFloat(((val / total) * 100).toFixed(1)) : 0;

    // 🟢 ALGORITHME DE RÉPARTITION SPÉCIFIQUE ET UNIQUE À CE CONTENU (Évite les doublons)
    const hashSeed = contentId % 5;
