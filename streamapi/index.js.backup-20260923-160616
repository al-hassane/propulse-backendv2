    const flames = await prisma.storyFlame.findMany({ where: { storyId }, select: { userId: true } });

    // Créer des Sets pour une recherche rapide (O(1))
    const likerIds = new Set(likes.map(l => l.userId));
    const flamerIds = new Set(flames.map(f => f.userId));

    // 3. Fusionner les données
    const detailedViewers = views.map(view => ({
      userId: view.user.id,
      fullName: view.user.fullName,
      avatarUrl: view.user.avatarUrl,
