// --- [BACKEND] CLASSEMENT ÉLITE : POPULARITÉ PAR SPORT OU PAR RÔLE ---
app.get('/leaderboard/popularity', async (req, res) => {
  const { sport, role } = req.query; // 🟢 On récupère les deux paramètres

  try {
    // 1. On construit la condition de recherche dynamiquement
    let whereCondition = {
      // 🛡️ Sécurité : On exclut toujours les comptes suspendus
      OR: [
        { suspendedUntil: null },
        { suspendedUntil: { lt: new Date() } }
      ]
    };

    // 🟢 LOGIQUE DE FILTRE : 
    // Priorité au RÔLE si fourni (ex: Journaliste), sinon on cherche les JOUEURS
    if (role && role !== "" && role !== "undefined") {
      whereCondition.role = { equals: role, mode: 'insensitive' };
    } else {
      whereCondition.role = 'joueur';
    }

    // Filtre par SPORT uniquement si précisé et différent de "ALL"
    if (sport && sport !== 'ALL' && sport !== "" && sport !== "undefined") {
      whereCondition.sport = { equals: sport, mode: 'insensitive' };
    }

    const users = await prisma.user.findMany({
      where: whereCondition,
      select: {
        id: true,
        fullName: true,
        username: true, // 🟢 Ajouté car ton frontend en a besoin pour @user
        avatarUrl: true,
        level: true,
        isVerified: true,
        certifTier: true, // 🟢 Ajoute cette ligne ici
        sport: true,
        role: true,
        posts: {
          where: { isArchived: false },
          select: { views: true }
        }
      }
    });

    // 2. Calcul de la somme des vues
    const formatted = users.map(u => {
      const totalPostViews = u.posts.reduce((sum, post) => sum + (post.views || 0), 0);
     
      return {
        id: u.id,
        fullName: u.fullName,
        username: u.username,
        avatarUrl: u.avatarUrl,
        level: u.level,
        isVerified: u.isVerified,
        sport: u.sport,
        role: u.role,
        viewsCount: totalPostViews
      };
    });

    // 3. Tri et Top 10
    const top10 = formatted
      .sort((a, b) => b.viewsCount - a.viewsCount)
      .slice(0, 10);

    res.json(top10);
  } catch (e) {
    console.error("❌ Erreur leaderboard popularity:", e);
    res.status(500).json({ error: "Erreur serveur" });
  }
});

