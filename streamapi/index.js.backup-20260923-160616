app.post('/tournaments/request', async (req, res) => {
  const { userId, title, description, game, rules, prizePool, maxParticipants, isFree, entryFee } = req.body;

  try {
    const uId = parseInt(userId);

    // 1. Vérification de l'utilisateur
    const creator = await prisma.user.findUnique({ where: { id: uId } });
    if (!creator) return res.status(404).json({ error: "Utilisateur non trouvé." });

    if (creator.role === 'joueur') {
      return res.status(403).json({ error: "Les joueurs ne peuvent pas organiser de tournois." });
    }

    // 2. VÉRIFICATION DE L'ORGANISATION ET DE SON STATUT
    const organization = await prisma.organization.findUnique({
      where: { ownerId: uId }
    });

    if (!organization) {
      return res.status(403).json({ 
        error: "NEED_ORGANIZATION", 
        message: "Tu dois d'abord créer ton profil Organisateur pour lancer un tournoi." 
      });
    }

    // 🟢 SÉCURITÉ : Vérifier si l'organisation est validée
    if (organization.status === "PENDING") {
      return res.status(403).json({ 
        error: "ORG_PENDING", 
        message: "Votre organisation est en cours de validation. Vous pourrez créer des tournois dès qu'elle sera approuvée ! ⏳" 
      });
    }

    if (organization.status === "REJECTED") {
      return res.status(403).json({ 
        error: "ORG_REJECTED", 
        message: "Désolé, votre profil Organisateur a été refusé. Veuillez contacter le support." 
      });
    }

    // 3. Création du tournoi lié à l'Organisation approuvée
    const tournament = await prisma.tournament.create({
      data: {
        creatorId: uId,
        organizationId: organization.id,
        title,
        description,
        game,
        rules,
        prizePool,
        maxParticipants: parseInt(maxParticipants) || 16,
        isFree: isFree === 'true' || isFree === true,
        entryFee: entryFee ? parseFloat(entryFee) : 0,
        status: "PENDING_APPROVAL"
      }
    });

