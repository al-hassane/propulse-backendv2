// ==========================================

app.put('/conversations/:id/pin', async (req, res) => {
  const { id } = req.params;
  const { userId } = req.body;
  
  try {
    const conversation = await prisma.conversation.findUnique({
      where: { id: parseInt(id) }
    });
    
    if (!conversation) {
      return res.status(404).json({ error: "Conversation introuvable" });
    }
    
    let updateData = {};
    let isPinned = false;
    
    if (conversation.user1Id === parseInt(userId)) {
      isPinned = !conversation.isPinned;
      updateData = { isPinned: isPinned };
    } else if (conversation.user2Id === parseInt(userId)) {
      isPinned = !conversation.isPinnedForUser2;
      updateData = { isPinnedForUser2: isPinned };
    } else {
      return res.status(403).json({ error: "Vous n'êtes pas membre de cette conversation" });
    }
    
    // ✅ ON NE TOUCHE PLUS À updatedAt — jamais
    
    const updatedConv = await prisma.conversation.update({
      where: { id: parseInt(id) },
      data: updateData,
      include: {
        user1: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true } },
        user2: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true } },
        messages: { 
          take: 1, 
          orderBy: { createdAt: 'desc' },
          where: { deletions: { none: { userId: parseInt(userId) } } }
        }
      }
    });
    
    io.emit(`conversations_updated_${userId}`, { action: 'pin', conversationId: updatedConv.id });
    
    res.json({ 
      success: true, 
      isPinned: isPinned,
      conversation: updatedConv  // ✅ updatedAt original intact ici
    });
    
  } catch (error) {
    console.error("❌ Erreur épinglage conversation:", error);
    res.status(500).json({ error: "Erreur lors de l'épinglage" });
  }
});

