// --- [HUB ESPORT] ÉDITION COMPLÈTE D'UN POST (TEXTE + MÉDIA) ---
// --- [HUB ESPORT] ÉDITION COMPLÈTE (TEXTE + MÉDIA + GIF) ---
app.put('/organizations/posts/:id', upload.single('media'), async (req, res) => {
  const { id } = req.params;
  const { userId, text, mediaType, deleteMedia, mediaUrl } = req.body; 
  const uId = parseInt(userId);

  try {
    const postId = parseInt(id);
    const post = await prisma.organizationPost.findUnique({ where: { id: postId } });

    if (!post) return res.status(404).json({ error: "Post introuvable" });

    // 🛡️ SÉCURITÉ : Seul l'auteur peut éditer
    if (post.authorId !== uId) {
      return res.status(403).json({ error: "Non autorisé." });
    }

    let updateData = { text };

    // 1️⃣ CAS : Nouveau fichier Image ou Vidéo (Upload vers S3)
    if (req.file) {
      updateData.mediaUrl = req.file.location;
      updateData.mediaType = mediaType;
    } 
    // 2️⃣ CAS : Nouveau GIF (URL externe provenant de Tenor/Giphy)
    else if (mediaType === 'gif' && mediaUrl) {
      updateData.mediaUrl = mediaUrl;
      updateData.mediaType = 'gif';
    }
    // 3️⃣ CAS : L'utilisateur a cliqué sur le bouton supprimer (X)
    else if (deleteMedia === 'true') {
      updateData.mediaUrl = null;
      updateData.mediaType = null;
    }

    // 4️⃣ CAS : Sinon, on garde l'ancien mediaUrl et mediaType (juste update texte)

    const updatedPost = await prisma.organizationPost.update({
      where: { id: postId },
      data: updateData,
      include: { author: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true } } }
    });

    res.json(updatedPost);

  } catch (e) {
    console.error("Erreur Full Edit:", e);
    res.status(500).json({ error: "Erreur lors de la modification." });
  }
});


