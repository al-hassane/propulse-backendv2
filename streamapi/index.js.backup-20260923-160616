app.put('/users/:id/location', async (req, res) => {
  const { id } = req.params;
  const { latitude, longitude, batteryLevel } = req.body;
  const userId = parseInt(id);

  if (isNaN(userId)) {
    return res.status(400).json({ error: "ID utilisateur invalide ou manquant." });
  }

  try {
    const latNum = parseFloat(latitude);
    const lngNum = parseFloat(longitude);

    // 🟢 On prépare la mise à jour de base (comportement identique à avant)
    const updateData = {
      latitude: latNum,
      longitude: lngNum,
      lastLocUpdate: new Date(),
      ...(batteryLevel !== undefined && !isNaN(parseInt(batteryLevel)) && {
        batteryLevel: parseInt(batteryLevel)
      }),
    };

    // 🟢 NOUVEAU : on regarde si on doit reverse geocoder
    //   On ne le fait QUE si :
    //     - L'utilisateur n'a pas encore de ville en base
    //     - OU il a bougé de plus de 5km
    const existingUser = await prisma.user.findUnique({
      where: { id: userId },
      select: { latitude: true, longitude: true, city: true },
    });

    let shouldReverse = !existingUser?.city;

    if (!shouldReverse && existingUser?.latitude && existingUser?.longitude) {
      const R = 6371;
      const dLat = ((latNum - existingUser.latitude) * Math.PI) / 180;
      const dLon = ((lngNum - existingUser.longitude) * Math.PI) / 180;
      const a =
        Math.sin(dLat / 2) ** 2 +
        Math.cos((existingUser.latitude * Math.PI) / 180) *
          Math.cos((latNum * Math.PI) / 180) *
          Math.sin(dLon / 2) ** 2;
      const movedKm = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

      if (movedKm > 5) shouldReverse = true;
    }

    if (shouldReverse) {
      const geo = await reverseGeocode(latNum, lngNum).catch(() => null);
      if (geo?.city) updateData.city = geo.city;
      if (geo?.country) updateData.country = geo.country;
      console.log(`🌍 Reverse geocoded user ${userId} → ${geo?.city || 'inconnu'}`);
    }

    // 🟢 UPDATE (identique à avant + city/country si besoin)
    const updatedUser = await prisma.user.update({
      where: { id: userId },
      data: updateData,
    });

    if (!isNaN(updatedUser.latitude) && !isNaN(updatedUser.longitude)) {

        io.to('radar').emit('location:update', {
          userId: updatedUser.id,
          fullName: updatedUser.fullName,
          avatarUrl: updatedUser.avatarUrl ? toCdnUrl(updatedUser.avatarUrl) : updatedUser.avatarUrl,
          latitude: updatedUser.latitude,
          longitude: updatedUser.longitude,
          lastLocUpdate: updatedUser.lastLocUpdate,
          batteryLevel: updatedUser.batteryLevel,
          position: updatedUser.position,
          sport: updatedUser.sport,
          level: updatedUser.level,
          city: updatedUser.city, // 🟢 NOUVEAU : ajouté au payload socket
        });

        axios.post(`${AI_ENGINE_URL}/ai/proximity-alert`, {
            new_user_id: updatedUser.id,
            new_user_sport: updatedUser.sport,
            user_level: updatedUser.level,
            lat: updatedUser.latitude,
            lng: updatedUser.longitude
        }).catch(e => console.log("IA Proximité indisponible"));
    }

    res.json({ 
      success: true,
      city: updatedUser.city,       // 🟢 On renvoie la ville
      country: updatedUser.country, // 🟢 Et le pays
    });
  } catch (e) {
    console.error("Erreur GPS:", e.message);
    res.status(500).json({ error: "Erreur mise à jour GPS" });
  }
});

