// 🌍 REVERSE GEOCODING : lat/lng → ville (via Nominatim OSM, gratuit)
// =========================================================================
async function reverseGeocode(lat, lng) {
  if (!lat || !lng) return null;

  try {
    const url = `https://nominatim.openstreetmap.org/reverse?` + new URLSearchParams({
      lat: String(lat),
      lon: String(lng),
      format: 'json',
      zoom: '10',              // Niveau ville
      addressdetails: '1',
    });

    const res = await axios.get(url, {
      headers: { 'User-Agent': 'ProPulseApp/1.0 (contact@propulse-sn.com)' },
      timeout: 5000,
    });

    const addr = res.data?.address || {};

    // 🟢 Priorité : city > town > village > suburb > state
    const city =
      addr.city ||
      addr.town ||
      addr.village ||
      addr.suburb ||
      addr.county ||
      addr.state ||
      null;

    const country = addr.country || null;

    return {
      city: city ? city.charAt(0).toUpperCase() + city.slice(1) : null,
      country,
    };
  } catch (e) {
    console.log('⚠️ reverseGeocode échec:', e.message);
    return null;
  }
}


