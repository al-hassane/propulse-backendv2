const waitForAiSlot = async () => {
  while (activeAiCalls >= MAX_PARALLEL_AI_CALLS) {
    await new Promise(resolve => setTimeout(resolve, 100));
  }
  activeAiCalls++;
};

const releaseAiSlot = () => {
