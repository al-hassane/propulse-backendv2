// --- SUPPRESSION TOTALE ET PROPRE D'UN POST (Côté Utilisateur) ---
app.delete('/posts/:id', async (req, res) => {
  const { id } = req.params;
  const postId = parseInt(id);

  try {
    // 1. On vérifie si le post existe
    const post = await prisma.post.findUnique({ where: { id: postId } });
    if (!post) return res.status(404).json({ error: "Post introuvable" });

    // 2. TRANSACTION : On nettoie TOUT avant de supprimer le post
    await prisma.$transaction([
      prisma.postMedia.deleteMany({ where: { postId } }),
      prisma.pollVote.deleteMany({ where: { postId } }),
      prisma.like.deleteMany({ where: { postId } }),
      prisma.savedPost.deleteMany({ where: { postId } }),
      prisma.hiddenPost.deleteMany({ where: { postId } }),
      prisma.report.deleteMany({ where: { postId } }),
      prisma.notification.deleteMany({ where: { postId } }),
      prisma.postMention.deleteMany({ where: { postId } }),
      prisma.ratingLike.deleteMany({ where: { rating: { postId } } }),
      prisma.rating.deleteMany({ where: { postId } }),
      
      // 🟢 LE FIX : On utilise deleteMany au lieu de delete pour éviter l'erreur P2025
      prisma.post.deleteMany({ where: { id: postId } }),
    ]);

    console.log(`🗑️ Post ${postId} supprimé avec succès.`);
    res.json({ message: "Post supprimé avec succès" });
  } catch (error) {
    console.error("Erreur suppression post:", error);
    res.status(500).json({ error: "Erreur lors de la suppression", details: error.message });
  }
});

