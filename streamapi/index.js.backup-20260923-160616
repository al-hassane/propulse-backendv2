// --- [ADMIN] REJETER UN DOSSIER MANAGER (CORRIGÉ PAR LE CTO AVEC SAUVEGARDE RAISON) ---
app.post('/admin/users/:id/reject-manager', async (req, res) => {
  const { id } = req.params;
  const { reason } = req.body;
  const userId = parseInt(id);

  try {
    const user = await prisma.user.findUnique({ where: { id: userId } });
    if (!user) return res.status(404).json({ error: "Utilisateur introuvable" });

    // 🟢 ÉTAPE 1 : Sauvegarder le motif dans la table Certification
    // On met le statut à REJECTED pour garder une trace du refus
    try {
        await prisma.playerCertification.update({
            where: { userId: userId },
            data: { 
                status: "REJECTED",
                reason: reason, // On utilise ton nouveau champ ici
                transactionId: null // On libère l'ID de transaction pour qu'il puisse repayer si besoin
            }
        });
    } catch (certError) {
        console.log("Note: Pas de fiche certif trouvée à mettre à jour, on continue...");
    }

    // 2. Réinitialisation des champs sur le profil User pour permettre de recommencer
    await prisma.user.update({
      where: { id: userId },
      data: {
        managerRequestDate: null,
        verificationSelfie: null,
        verificationDocFront: null,
        verificationDocBack: null,
      }
    });

    // 3. Trouver un expéditeur Admin valide
    const adminSender = await prisma.user.findFirst({ where: { role: 'admin' } });
    const senderId = adminSender ? adminSender.id : userId;

    // 4. Envoyer la NOTIFICATION INTERNE
    await createNotification(
      "ADMIN", 
      senderId, 
      userId, 
      null, null, null, 
      `Dossier Manager refusé : ${reason}. Vous pouvez soumettre de nouveaux documents dans vos réglages.`
    );

    // 5. Envoyer l'EMAIL (Optionnel : utilise l'email réel de l'utilisateur)
    try {
        await resend.emails.send({
          from: 'ProPulse <no-reply@propulse-sn.com>',
          to: user.email, // 🟢 On utilise le vrai email maintenant !
          subject: '❌ Mise à jour de votre dossier ProPulse',
          html: `<h3>Dossier refusé</h3><p>Bonjour ${user.fullName},</p><p>Votre dossier Manager a été refusé pour la raison suivante : <b>${reason}</b></p><p>Vous pouvez soumettre un nouveau dossier dans les paramètres de l'application.</p>`
        });
    } catch (emailErr) {
        console.error("Erreur envoi email rejection:", emailErr);
    }

    res.json({ message: "Dossier rejeté, raison enregistrée et utilisateur notifié." });
  } catch (error) {
    console.error("Erreur critique reject-manager:", error);
    res.status(500).json({ error: "Erreur lors du traitement du rejet." });
  }
});

