const getAiRecommendations = async (userId) => {
  await waitForAiSlot();
  
  // 🟢 FONCTION POUR DÉTERMINER LE TTL SELON L'HEURE
  const getTTL = () => {
    const hour = new Date().getHours();
    // Nuit (22h - 6h) : 4 heures (14400 secondes)
    if (hour >= 22 || hour <= 6) return 14400;
    // Journée : 30 minutes (1800 secondes)
    return 1800;
  };
  
  try {
    // 1. Vérifier le cache Redis d'abord
    if (redisClient) {
      try {
        const cached = await redisClient.get(`ai:user:${userId}`);
        if (cached) {
          console.log(`🎯 [CACHE] IA Redis trouvé pour user ${userId}`);
          
          // 🟢 RENOUVELER LE TTL (le cache reste chaud tant que l'user est actif)
          await redisClient.expire(`ai:user:${userId}`, getTTL());
          console.log(`⏰ TTL renouvelé pour user ${userId} (${getTTL()}s)`);
          
          return JSON.parse(cached);
        }
      } catch (err) {
        console.log("⚠️ Erreur lecture cache Redis:", err.message);
      }
    }

    // ⚠️ TIMEOUT AGGRESSIF (2 secondes)
    try {
      console.log(`🤖 [API] Appel IA Python pour user ${userId} (timeout 2s)`);
      const response = await axios.get(`${AI_ENGINE_URL}/ai/feed/${userId}`, {
        timeout: 2000  // 2 secondes max !
      });
      
      if (response.data && response.data.post_ids && response.data.post_ids.length > 0) {
        const postIds = response.data.post_ids;
        console.log(`✅ IA répondu en moins de 2s pour user ${userId}`);
        
        if (redisClient) {
          // 🟢 UTILISER LE TTL DYNAMIQUE
          const ttl = getTTL();
          await redisClient.setEx(`ai:user:${userId}`, ttl, JSON.stringify(postIds));
          console.log(`💾 Cache sauvegardé pour user ${userId} (TTL: ${ttl}s)`);
        }
        return postIds;
      }
      return null;
      
    } catch (iaError) {
      // Timeout ou erreur – on ne bloque pas
      console.log(`⚠️ IA lente ou indisponible pour user ${userId}: ${iaError.message}`);
      return null;
    }
    
  } finally {
    releaseAiSlot();
  }
};


