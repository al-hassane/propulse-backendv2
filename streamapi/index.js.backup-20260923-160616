app.get('/reels', async (req, res) => {
  const currentUserId = req.query.userId ? parseInt(req.query.userId) : null;
  const sportFilter = req.query.sport;
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 30;
  const skip = (page - 1) * limit;

  try {
    let mutedUserIds = [];
    let seenPostIds = [];

    // 1. RÉCUPÉRER LES FILTRES (Mutes et Déjà vus)
    if (currentUserId) {
      const [mutes, likes, ratings] = await Promise.all([
        prisma.mute.findMany({ where: { muterId: currentUserId, mutePosts: true }, select: { mutedId: true } }),
        prisma.like.findMany({ where: { userId: currentUserId }, select: { postId: true } }),
        prisma.rating.findMany({ where: { userId: currentUserId }, select: { postId: true } })
      ]);
      mutedUserIds = mutes.map(m => m.mutedId);
      seenPostIds = [...new Set([...likes.map(l => l.postId), ...ratings.map(r => r.postId)])];
    }

    // 2. CONDITIONS DE SÉCURITÉ DE BASE
    const baseConditions = {
      isArchived: false,
      communityId: null,
      mediaType: 'VIDEO', // ⚡ REMPLACE TOUT LE BLOC "OR: [...]" PAR CETTE LIGNE
      userId: { notIn: mutedUserIds },
      user: {
        AND: [
          { blockedBy: { none: { blockerId: currentUserId || 0 } } },
          { blockedUsers: { none: { blockedId: currentUserId || 0 } } }
        ]
      }
    };

    if (sportFilter && sportFilter !== 'ALL' && sportFilter !== 'Tous') {
      baseConditions.sport = sportFilter;
    }

    const reelsInclude = {
      user: { include: { certification: true, followedBy: { take: 3, include: { follower: { select: { id: true, fullName: true, avatarUrl: true } } } } } },
      likes: { include: { user: { select: { id: true, fullName: true, avatarUrl: true } } } },
      audio: { include: { author: true } },
      votes: true,
      ratings: { select: { score: true } },
      _count: { select: { ratings: true, votes: true, likes: true } }
    };

    let finalReels = [];

    // --- ÉTAPE A : PRIORITÉ IA (Page 1 uniquement) ---
    if (currentUserId && page === 1) {
      const aiIds = await getAiRecommendations(currentUserId);
      if (aiIds && aiIds.length > 0) {
        const aiReels = await prisma.post.findMany({
          where: { ...baseConditions, id: { in: aiIds } },
          include: reelsInclude
        });
        finalReels = aiIds.map(id => aiReels.find(p => p.id === id)).filter(Boolean);
      }
    }

    // --- ÉTAPE B : REMPLISSAGE AVEC LE "JAMAIS VU" ---
    if (finalReels.length < limit) {
      const unseenReels = await prisma.post.findMany({
        where: { 
          ...baseConditions, 
          id: { notIn: [...finalReels.map(r => r.id), ...seenPostIds] } // Pas dans l'IA et pas dans le "Déjà vu"
        },
        include: reelsInclude,
        take: limit - finalReels.length,
        skip: skip, // On utilise skip ici pour la pagination des nouveautés
        orderBy: { createdAt: 'desc' }
      });
      finalReels = [...finalReels, ...unseenReels];
    }

    // --- 🟢 ÉTAPE C : LA BOUCLE INFINIE (REMPLISSAGE AVEC LE "DÉJÀ VU") ---
    // Si après avoir cherché partout, on n'a toujours pas assez de vidéos (ex: il reste 5 vidéos)
    // On va piocher dans ce que l'utilisateur a DÉJÀ liké ou vu pour boucher le trou.
    if (finalReels.length < limit && seenPostIds.length > 0) {
      const seenFiller = await prisma.post.findMany({
        where: {
          ...baseConditions,
          id: { 
            in: seenPostIds, 
            notIn: finalReels.map(r => r.id) // Éviter les doublons dans la même page
          }
        },
        include: reelsInclude,
        take: limit - finalReels.length,
        // On trie par "aléatoire" ou par date pour changer l'ordre de la boucle
        orderBy: { createdAt: 'asc' } 
      });
      finalReels = [...finalReels, ...seenFiller];
    }

    // 4. FORMATAGE FINAL
    const responseData = finalReels.map(reel => {
      const myVote = reel.votes?.find(v => v.userId === currentUserId);
      const validRatings = (reel.ratings || []).filter(r => r.score > 0);
      const avg = validRatings.length > 0
          ? (validRatings.reduce((acc, r) => acc + r.score, 0) / validRatings.length).toFixed(1)
          : "0.0";

      return {
        ...reel,
        imageUrl: reel.imageUrl.includes('cloudinary') ? reel.imageUrl.replace('/upload/', '/upload/f_auto,q_auto:good,vc_h264,w_720/') : toCdnUrl(reel.imageUrl),
        avgRating: avg,
        ratingsCount: reel._count?.ratings || 0,
        userVote: myVote ? myVote.option : null,
        pollStats: {
          YES: reel.votes?.filter(v => v.option === 'YES').length || 0,
          NO: reel.votes?.filter(v => v.option === 'NO').length || 0
        }
      };
    });

    res.json(responseData);

  } catch (error) {
    console.error("❌ Erreur Route Reels Infinity Loop:", error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});

