app.put('/users/:id', profileUpload, async (req, res) => {
  const { id } = req.params;
  const { fullName, username, role, position, club, strongFoot, height, weight, bio } = req.body;

  try {
    const userId = parseInt(id);
    const user = await prisma.user.findUnique({ where: { id: userId } });

    if (!user) return res.status(404).json({ error: "Utilisateur introuvable" });

    // --- 🟢 MAGIE DU CTO : CONSTRUCTION DYNAMIQUE DE L'OBJET ---
    // On initialise un objet vide et on ajoute seulement ce qui est reçu
    let updateData = {};
    
    if (role !== undefined) updateData.role = role;
    if (position !== undefined) updateData.position = position;
    if (club !== undefined) updateData.club = club;
    if (strongFoot !== undefined) updateData.strongFoot = strongFoot;
    if (bio !== undefined) updateData.bio = bio;

    // Sécurité pour les nombres (pour éviter le crash NaN si les champs sont vides)
    if (height !== undefined && height !== null && height !== "") {
      updateData.height = parseInt(height);
    }
    if (weight !== undefined && weight !== null && weight !== "") {
      updateData.weight = parseInt(weight);
    }

    // 🟢 LOGIQUE DE SÉCURITÉ POUR LE NOM (Gardée intacte)
    if (fullName && fullName !== user.fullName) {
      const now = new Date();
      if (user.nameUpdatedAt) {
        const thirtyDaysAgo = new Date();
        thirtyDaysAgo.setDate(now.getDate() - 30);

        if (user.nameUpdatedAt > thirtyDaysAgo) {
          const nextUpdateDate = new Date(user.nameUpdatedAt);
          nextUpdateDate.setDate(nextUpdateDate.getDate() + 30);
         
          return res.status(403).json({
            error: "COOLDOWN",
            message: `Tu ne peux changer ton nom qu'une fois par mois. Prochaine modification possible le ${nextUpdateDate.toLocaleDateString('fr-FR')}.`
          });
        }
      }
      updateData.fullName = fullName;
      updateData.nameUpdatedAt = now;
    }

    // Gestion des images (Gardée intacte)
    if (req.files) {
      if (req.files['avatar']) updateData.avatarUrl = req.files['avatar'][0].location;
      if (req.files['cover']) updateData.coverUrl = req.files['cover'][0].location;
    }

    // --- 🟢 LOGIQUE USERNAME UNIQUE (Gardée intacte) ---
    if (username) {
      const cleanUsername = username.toLowerCase().trim().replace('@', '');
      
      const regex = /^[a-zA-Z]+$/;
      if (!regex.test(cleanUsername) || cleanUsername.length > 7) {
        return res.status(400).json({ error: "Pseudo invalide (Lettres uniquement, max 7)." });
      }

      const duplicate = await prisma.user.findFirst({
        where: { 
          username: cleanUsername,
          id: { not: userId }
        }
      });

      if (duplicate) {
        return res.status(409).json({ error: "Ce pseudo est déjà utilisé par un autre talent." });
      }
      
      updateData.username = cleanUsername;
    }

    // MISE À JOUR FINALE
    const updatedUser = await prisma.user.update({
      where: { id: userId },
      data: updateData,
    });

    res.json({ message: "Profil mis à jour !", user: updatedUser });
  } catch (error) {
    console.error("❌ Erreur serveur lors de l'update:", error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});



