app.post('/stories', uploadStories.single('media'), async (req, res) => {
  try {
    // 1. Récupération des données du body
    const { 
      userId, type, content, background, fontStyle, textColor, 
      sharedPostId, mentionIds, stickerStyle,
      textScale, textOffsetX, textOffsetY, textRotation, stickers,
      mediaBgMode, mediaBgColor, mediaScale, mediaOffsetX, mediaOffsetY,
      // 🟢 AJOUTÉ : données du sondage (optionnel)
      pollQuestion, pollOptionA, pollOptionB,
      pollX, pollY, pollScale, pollRotation,
      // 🟢 AJOUTEZ CES SÉLECTEURS ICI :
      sliderEmoji, sliderQuestion, sliderValue,
      sliderX, sliderY, sliderScale, sliderRotation, storyAudioId
    } = req.body;

    // 2. SÉCURITÉ : Conversion forcée et vérification des nombres (évite le crash NaN)
    const pUserId = parseInt(userId);
    if (isNaN(pUserId)) {
        return res.status(400).json({ error: "ID utilisateur invalide" });
    }

    // Gestion du sharedPostId (si vide ou "null" -> null)
    const pSharedPostId = (sharedPostId && sharedPostId !== "null" && sharedPostId !== "") ? parseInt(sharedPostId) : null;
    
    // Gestion du stickerStyle (par défaut 0 si vide)
    const pStickerStyle = (stickerStyle && stickerStyle !== "") ? parseInt(stickerStyle) : 0;

    const expiry = new Date(Date.now() + 24 * 60 * 60 * 1000); 

    // 3. Vérification de l'utilisateur
    const user = await prisma.user.findUnique({ where: { id: pUserId } });
    if (!user) return res.status(404).json({ error: "Utilisateur introuvable" });

    // 🛡️ AJOUTE LE BLOC ICI (Juste avant l'étape 4) :
    if (user.suspendedUntil && new Date() < new Date(user.suspendedUntil)) {
        return res.status(403).json({ error: "Votre compte est suspendu." });
    }
    

    // 4. Création de la story avec les valeurs nettoyées
    const story = await prisma.story.create({
      data: {
        userId: pUserId,
        type: type || "IMAGE",
        content: content || null,
        background: background || null,
        fontStyle: fontStyle || 'classic',
        textColor: textColor || "#FFFFFF",
        // mediaUrl: req.file ? req.file.path : null,
        mediaUrl: req.file ? req.file.location : null,
        expiresAt: expiry,
        // 🟢 ON FAIT LE LIEN AVEC L'AUDIO
        storyAudioId: storyAudioId ? parseInt(storyAudioId) : null,
        sharedPostId: pSharedPostId, // Utilise la valeur nettoyée
        stickerStyle: pStickerStyle, // Utilise la valeur nettoyée
        textScale: textScale || "1",       // 🟢 AJOUTÉ
        textOffsetX: textOffsetX || "0",   // 🟢 AJOUTÉ
        textOffsetY: textOffsetY || "0",   // 🟢 AJOUTÉ
        textRotation: textRotation || "0", // 🟢 AJOUTÉ
        stickers: stickers || "[]",        // 🟢 AJOUTÉ
        mediaBgMode: mediaBgMode || "blur",     // 🟢 AJOUTÉ
        mediaBgColor: mediaBgColor || "#000000", // 🟢 AJOUTÉ
        mediaScale: mediaScale || "1",           // 🟢 AJOUTÉ
        mediaOffsetX: mediaOffsetX || "0",       // 🟢 AJOUTÉ
        mediaOffsetY: mediaOffsetY || "0"        // 🟢 AJOUTÉ
      },
       include: { storyAudio: true } // 🟢 Renvoie l'audio dans la réponse
    });

    // 📈 Augmenter le compteur d'utilisation du son
    if (storyAudioId) {
      await prisma.storyAudio.update({
        where: { id: parseInt(storyAudioId) },
        data: { usageCount: { increment: 1 } }
      });
    }

    // 4.5. Logique du Sondage (optionnel)
    if (pollQuestion && pollOptionA && pollOptionB) {
      try {
        await prisma.storyPoll.create({
          data: {
            storyId: story.id,
            question: String(pollQuestion),
            optionA: String(pollOptionA),
            optionB: String(pollOptionB),
            x: parseFloat(pollX) || 0,
            y: parseFloat(pollY) || 0,
            scale: parseFloat(pollScale) || 1,
            rotation: parseFloat(pollRotation) || 0,
          },
        });
      } catch (err) {
        console.error("Erreur création sondage:", err);
      }
    }

    // 🟢 ENREGISTREMENT DU CURSEUR EMOJI (OPTIONNEL)
    if (sliderEmoji && sliderQuestion) {
      try {
        await prisma.storySlider.create({
          data: {
            storyId: story.id,
            emoji: String(sliderEmoji),
            question: String(sliderQuestion),
            x: parseFloat(sliderX) || 0,
            y: parseFloat(sliderY) || 0,
            scale: parseFloat(sliderScale) || 1,
            rotation: parseFloat(sliderRotation) || 0,
          },
        });
      } catch (err) {
        console.error("Erreur création curseur emoji:", err);
      }
    }

    // 5. Logique des Mentions (@)
    if (mentionIds && mentionIds !== "" && mentionIds !== "[]") {
      try {
        const ids = typeof mentionIds === 'string' ? JSON.parse(mentionIds) : mentionIds;
        
        if (Array.isArray(ids) && ids.length > 0) {
          await prisma.storyMention.createMany({
            data: ids.map(mId => ({
              storyId: story.id,
              userId: parseInt(mId)
            }))
          });

          for (const mId of ids) {
            await createNotification(
              "STORY_MENTION",
              pUserId,
              parseInt(mId),
              null, null, null,
              `vous a mentionné dans sa story. 🏷️`,
              story.id
            );
          }
        }
      } catch (err) {
        console.error("Erreur parsing mentions:", err);
      }
    }

    // 6. Logique du Partage de Post
    if (pSharedPostId) {
      const originalPost = await prisma.post.findUnique({ where: { id: pSharedPostId } });
      
      if (originalPost && originalPost.userId !== pUserId) {
        await createNotification(
          "STORY_SHARE",
          pUserId,
          originalPost.userId,
          pSharedPostId,
          null, null,
          `a partagé votre publication dans sa story. 📲`,
          story.id
        );
      }
    }

    await createAdminNotif('NEW_STORY', `Nouvelle story publiée par ${user.fullName}`);

    // 🟢 ENVOI DE LA NOTIFICATION AUX ABONNÉS
    const subscribers = await prisma.follow.findMany({
      where: {
        followingId: pUserId,
        status: 'ACCEPTED'
      },
      include: {
        follower: { select: { id: true, pushToken: true } }
      }
    });

    if (subscribers.length > 0) {
      // 1. Enregistrement des notifications in-app en base de données
      const notifsData = subscribers.map(sub => ({
        type: 'NEW_STORY',
        senderId: pUserId,
        receiverId: sub.follower.id,
        storyId: story.id,
        message: `${user.fullName} a publié une nouvelle story ! 📸`
      }));
      await prisma.notification.createMany({ data: notifsData });

      // 2. Préparation et envoi des pushs via Expo
      let pushMessages = [];
      for (let sub of subscribers) {
        if (sub.follower.pushToken && Expo.isExpoPushToken(sub.follower.pushToken)) {
          pushMessages.push({
            to: sub.follower.pushToken,
            sound: 'default',
            title: '📸 Nouvelle Story',
            body: `${user.fullName} a publié une nouvelle story !`,
            data: {
              url: `/notifications`,
              storyId: story.id,
              type: "NEW_STORY"
            },
          });
        }
      }

      let chunks = expo.chunkPushNotifications(pushMessages);
      for (let chunk of chunks) {
        try {
          await expo.sendPushNotificationsAsync(chunk);
        } catch (error) {
          console.error("❌ Erreur envoi push story:", error);
        }
      }
    }

    res.json(story);

  } catch (e) {
    console.error("❌ ERREUR CRITIQUE STORY:", e);
    res.status(500).json({ error: "Erreur interne du serveur", details: e.message });
  }
});



