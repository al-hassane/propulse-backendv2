// --- CRÉER UN ÉVÉNEMENT (MANAGER) ---
app.post('/events', upload.single('image'), async (req, res) => {
  let { 
    userId, communityId, title, type, description, date,
    ageCategory, isFree, price, currency,
    country, city, location 
  } = req.body;

  try {
    // 1. VÉRIFICATION DU STATUT MANAGER
    const manager = await prisma.user.findUnique({
      where: { id: parseInt(userId) }
    });

    if (manager.role === 'manager' && !manager.isManagerVerified) {
      return res.status(403).json({ error: "Votre compte est en cours de vérification. Vous ne pouvez pas encore publier." });
    }

    // 🛡️ LOGIQUE DE RÉPARATION DE LA DATE (CTO FIX)
    let finalDate = new Date();
    
    if (date && date !== "" && date !== "null") {
      // Si la date arrive au format JJ/MM/AAAA (ex: 08/10/2026)
      if (typeof date === 'string' && date.includes('/')) {
        const parts = date.split('/');
        if (parts.length === 3) {
          // On la transforme en AAAA-MM-JJ pour que JavaScript comprenne
          date = `${parts[2]}-${parts[1]}-${parts[0]}`;
        }
      }
      
      const parsedDate = new Date(date);
      if (!isNaN(parsedDate.getTime())) {
        finalDate = parsedDate;
      } else {
        console.log("⚠️ Format de date toujours invalide après tentative de réparation :", date);
        // On peut soit mettre la date du jour, soit renvoyer une erreur
        finalDate = new Date(); 
      }
    }

    // 2. CRÉATION DE L'ÉVÉNEMENT EN BDD
    const event = await prisma.event.create({
      data: {
        userId: parseInt(userId),
        communityId: (communityId && communityId !== 'undefined' && communityId !== 'null') ? parseInt(communityId) : null,
        title, type, description,
        date: finalDate, // 👈 On utilise la date réparée
        ageCategory,
        isFree: isFree === 'true' || isFree === true,
        price: price ? parseFloat(price) : 0,
        currency,
        country, city, location,
        imageUrl: req.file ? req.file.location : null
      }
    });

    // 🚀 --- DIFFUSION PAR LOTS (EN ARRIÈRE-PLAN) ---
    res.json(event);

    setImmediate(async () => {
      try {
        const players = await prisma.user.findMany({
          where: { role: 'joueur', pushToken: { not: null } },
          select: { id: true, pushToken: true }
        });

        if (players.length === 0) return;

        let pushMessages = [];
        for (let p of players) {
          if (Expo.isExpoPushToken(p.pushToken)) {
            pushMessages.push({
              to: p.pushToken,
              sound: 'default',
              title: '📅 Nouvel Événement !',
              body: `${manager.fullName} organise : ${title} (${city})`,
              image: getThumbnailUrl(event.imageUrl),
              data: { eventId: event.id, type: 'EVENT' },
              priority: 'normal'
            });
          }
        }

        let chunks = expo.chunkPushNotifications(pushMessages);
        for (let chunk of chunks) {
          try {
            await expo.sendPushNotificationsAsync(chunk);
            await new Promise(resolve => setTimeout(resolve, 1000));
          } catch (error) {
            console.error("Erreur lot push event:", error);
          }
        }

        const batchSize = 500;
        for (let i = 0; i < players.length; i += batchSize) {
          const batch = players.slice(i, i + batchSize);
          await prisma.notification.createMany({
            data: batch.map(p => ({
              type: "ADMIN", 
              senderId: parseInt(userId),
              receiverId: p.id,
              eventId: event.id,
              message: `Nouvel événement : ${title} 📅`
            })),
            skipDuplicates: true
          });
        }
      } catch (err) {
        console.error("❌ Erreur critique lors de la diffusion globale :", err);
      }
    });

  } catch (e) {
    console.error("❌ Erreur création événement:", e.message);
    res.status(500).json({ error: "Erreur serveur lors de la création de l'événement." });
  }
});


