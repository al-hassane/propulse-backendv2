app.put('/notifications/:id/respond-org-invite', async (req, res) => {
  const { status } = req.body; // "ACCEPTED" ou "DECLINED"
  const notifId = parseInt(req.params.id);

  try {
    const notif = await prisma.notification.findUnique({ 
      where: { id: notifId },
      include: { community: true } // C'est l'organisation
    });

     // 🟢 SUPPRIMER L'INVITATION DE LA TABLE (Elle n'est plus "en attente")
    await prisma.organizationInvitation.deleteMany({
      where: { organizationId: notif.communityId, userId: notif.receiverId }
    });

    if (status === "ACCEPTED") {
      // On connecte l'utilisateur à l'organisation
      await prisma.organization.update({
        where: { id: notif.communityId },
        data: { members: { connect: { id: notif.receiverId } } }
      });

      // Notif de succès pour le créateur
      await createNotification("ADMIN", notif.receiverId, notif.senderId, null, null, null, `a accepté ton invitation pour rejoindre ${notif.community.name} ! ✅`);
    } else {
      // Notif de refus pour le créateur
      await createNotification("ADMIN", notif.receiverId, notif.senderId, null, null, null, `a décliné ton invitation pour rejoindre ${notif.community.name}. ❌`);
    }

    // On met à jour la notif pour qu'elle ne soit plus actionnable
    await prisma.notification.update({
      where: { id: notifId },
      data: { requestStatus: status, isRead: true }
    });

    res.json({ success: true });
  } catch (e) {
    res.status(500).json({ error: "Erreur lors de la réponse" });
  }
});



