// POST /messages/:id/reactions - Ajouter ou modifier une réaction
app.post('/messages/:id/reactions', async (req, res) => {
  const messageId = parseInt(req.params.id);
  const { userId, reactionType } = req.body;

  try {
    // Vérifier si l'utilisateur a déjà réagi à ce message
    const existingReaction = await prisma.messageReaction.findUnique({
      where: {
        messageId_userId: {
          messageId: messageId,
          userId: parseInt(userId)
        }
      }
    });

    let reaction;
    let action = 'ADD';

    // Récupérer le message pour connaître l'expéditeur (AVANT de modifier)
    const message = await prisma.message.findUnique({
      where: { id: messageId },
      select: { senderId: true, conversationId: true }
    });

    if (existingReaction) {
      if (existingReaction.reactionType === reactionType) {
        // Même réaction → on supprime (toggle off)
        await prisma.messageReaction.delete({
          where: { id: existingReaction.id }
        });
        action = 'REMOVE';
        reaction = null;
      } else {
        // Réaction différente → on met à jour
        reaction = await prisma.messageReaction.update({
          where: { id: existingReaction.id },
          data: { reactionType: reactionType }
        });
      }
    } else {
      // Nouvelle réaction
      reaction = await prisma.messageReaction.create({
        data: {
          messageId: messageId,
          userId: parseInt(userId),
          reactionType: reactionType
        },
        include: {
          user: {
            select: { id: true, fullName: true, avatarUrl: true }
          }
        }
      });

      // 🟢 AJOUTE CETTE NOTIFICATION (seulement pour une nouvelle réaction)
      if (message && message.senderId !== parseInt(userId)) {
        const sender = await prisma.user.findUnique({
          where: { id: parseInt(userId) },
          select: { fullName: true, avatarUrl: true }
        });
        
        const emojiMap = {
          'LIKE': '👍',
          'LOVE': '❤️',
          'LAUGH': '😂',
          'SURPRISED': '😮',
          'SAD': '😢',
          'ANGRY': '😠',
          'WOW': '🤯',
          'COOL': '😎',
          'CLAP': '👏'
        };
        
        const emoji = emojiMap[reactionType] || '👍';
        
        await createNotification(
          "MESSAGE_REACTION",
          parseInt(userId),
          message.senderId,
          null, null, null,
          `${sender?.fullName || "Quelqu'un"} a réagi avec ${emoji} à votre message`,
          null, null, null,
          message.conversationId
        );
      }
    }

    // Émettre en temps réel à tous les participants de la conversation
    if (message) {
      io.to(`conv_${message.conversationId}`).emit('message_reaction_updated', {
        messageId: messageId,
        userId: parseInt(userId),
        reactionType: reactionType,
        action: action,
        reaction: reaction
      });
    }

    // Récupérer toutes les réactions du message pour la réponse
    const allReactions = await prisma.messageReaction.findMany({
      where: { messageId: messageId },
      include: {
        user: {
          select: { id: true, fullName: true, avatarUrl: true }
        }
      }
    });

    res.json({
      success: true,
      action: action,
      reaction: reaction,
      reactions: allReactions
    });

  } catch (error) {
    console.error("Erreur réaction message:", error);
    res.status(500).json({ error: "Erreur lors de l'ajout de la réaction" });
  }
});



