app.get('/users/:id/mentions', async (req, res) => {
  const userId = parseInt(req.params.id);

  if (isNaN(userId)) {
    return res.status(400).json({ error: "ID utilisateur invalide" });
  }

  try {
    const mentions = await prisma.postMention.findMany({
      where: { 
        userId: userId,
        post: { isArchived: false } // 🟢 On n'affiche que les posts qui ne sont pas archivés
      },
      include: {
        post: {
          include: {
            user: { include: { certification: true } },
            media: true,
            _count: { select: { likes: true, ratings: true, votes: true } },
            likes: {
              take: 5,
              include: { user: { select: { avatarUrl: true } } }
            }
          }
        }
      },
      orderBy: { post: { createdAt: 'desc' } }
    });

    // 🟢 MAGIE DU CTO : On formate les URLs pour que ce soit ultra rapide (CDN)
    const formattedPosts = mentions.map(m => {
      const p = m.post;
      if (!p) return null;

      return {
        ...p,
        imageUrl: toCdnUrl(p.imageUrl),
        media: p.media?.map(med => ({ ...med, url: toCdnUrl(med.url) })) || [],
        user: {
          ...p.user,
          avatarUrl: toCdnUrl(p.user.avatarUrl)
        }
      };
    }).filter(Boolean); // On enlève les éventuels nuls

    res.json(formattedPosts);
  } catch (e) {
    console.error("❌ Erreur lors de la récupération des mentions:", e);
    res.status(500).json([]);
  }
});

