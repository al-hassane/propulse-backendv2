            role: true,
            position: true,
            certification: { select: { status: true } }
          }
        }
      },
      orderBy: { id: 'desc' }, // Les plus récents en premier
      take: limit,
      skip: skip
    });

    res.json({
      data: votes,
      pagination: {
        page,
        limit,
        total: totalCount,
        hasMore: skip + votes.length < totalCount
      }
    });
  } catch (error) {
    console.error("❌ Erreur serveur lors de la récupération des votants:", error);
