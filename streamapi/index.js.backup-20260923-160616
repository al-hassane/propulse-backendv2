app.get('/products/weekly-count', async (req, res) => {
  const { lastViewed } = req.query; // On récupère la date envoyée par le téléphone

  try {
    const now = new Date();
    
    // Date de référence : soit la date envoyée par le tel, soit le début de la semaine
    let referenceDate;

    if (lastViewed && lastViewed !== 'null') {
      referenceDate = new Date(lastViewed);
    } else {
      // Ton calcul de début de semaine actuel (Lundi 00:00)
      const day = now.getDay();
      const diff = now.getDate() - day + (day === 0 ? -6 : 1);
      referenceDate = new Date(now.setDate(diff));
      referenceDate.setHours(0, 0, 0, 0);
    }

    const count = await prisma.product.count({
      where: {
        createdAt: { gte: referenceDate }, // On compte DEPUIS la dernière vue
        isSold: false
      }
    });

    res.json({ count });
  } catch (error) {
    console.error("Erreur badge:", error);
    res.status(500).json({ count: 0 });
  }
});


