app.post('/posts/:id/view', async (req, res) => {
  const { id } = req.params;
  const postId = parseInt(id);
  const userId = req.body?.userId;

  if (isNaN(postId)) return res.status(400).json({ error: "ID invalide" });

  try {
    // 1. Incrémenter les vues globales du post
    const post = await prisma.post.update({
      where: { id: postId },
      data: { views: { increment: 1 } }
    });

    // 2. Enregistrer l'historique pour l'utilisateur
    if (userId && !isNaN(parseInt(userId))) {
      const uId = parseInt(userId);

      // On vérifie si il existe déjà une interaction forte
      const existingAction = await prisma.userPostView.findUnique({
        where: { userId_postId: { userId: uId, postId } }
      });

      // 🟢 ON N'ÉCRASE PAS SI C'EST UN LIKE OU UN SAVE
      if (!existingAction || (existingAction.action !== 'LIKE' && existingAction.action !== 'SAVE' && existingAction.action !== 'WATCH_FULL')) {
        await prisma.userPostView.upsert({
          where: { userId_postId: { userId: uId, postId } },
          update: { seenAt: new Date(), action: 'VIEW' },
          create: { userId: uId, postId, action: 'VIEW' }
        });
      }
    }

    res.json({ success: true, views: post.views });
  } catch (error) {
    res.status(500).json({ error: "Erreur serveur" });
  }
});


