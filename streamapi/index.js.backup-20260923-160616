cron.schedule('0 3 * * *', async () => {
  console.log("🌙 [CRON NUIT] Pré-calcul des feeds personnalisés...");

  try {
    // Utilisateurs actifs ces 48h en priorité
    const activeUsers = await prisma.user.findMany({
      where: {
        lastActiveAt: { gt: new Date(Date.now() - 48 * 60 * 60 * 1000) },
        OR: [{ suspendedUntil: null }, { suspendedUntil: { lt: new Date() } }]
      },
      select: { id: true },
      take: 1000,
      orderBy: { lastActiveAt: 'desc' }
    });

    console.log(`📊 [CRON] ${activeUsers.length} utilisateurs à pré-calculer`);

    const BATCH_SIZE = 5;
    const DELAY_MS = 1500;
    let success = 0;

    for (let i = 0; i < activeUsers.length; i += BATCH_SIZE) {
      const chunk = activeUsers.slice(i, i + BATCH_SIZE);

      await Promise.all(chunk.map(async ({ id }) => {
        try {
          const resp = await axios.get(`${AI_ENGINE_URL}/ai/feed/${id}`, { timeout: 25000 });
          if (resp.data?.post_ids?.length > 0 && redisClient) {
            await redisClient.setEx(`ai:user:${id}`, 43200, JSON.stringify(resp.data.post_ids));
            await redisClient.del(`cursor:user:${id}`); // Reset curseur pour la nouvelle liste
            success++;
          }
        } catch (e) {
          // On skip silencieusement
        }
      }));

      await new Promise(r => setTimeout(r, DELAY_MS));

      if (i % 50 === 0 && i > 0) {
        console.log(`⏳ [CRON] ${i}/${activeUsers.length} traités, ${success} succès`);
      }
    }

    console.log(`✅ [CRON NUIT] Terminé: ${success}/${activeUsers.length} feeds pré-calculés`);
  } catch (e) {
    console.error("❌ [CRON NUIT] Erreur:", e.message);
  }
});



