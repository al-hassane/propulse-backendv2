// Assure-toi que ce dossier existe au sommet de ton server.js
const audioTempDir = path.join(__dirname, 'temp_audio');
if (!fs.existsSync(audioTempDir)) fs.mkdirSync(audioTempDir, { recursive: true });

const tempUpload = multer({ 
  dest: 'temp_audio/',
  limits: { fileSize: 50 * 1024 * 1024 } 
});

app.post('/admin/story-audios', tempUpload.single('audio'), async (req, res) => {
  const { title, startTime } = req.body;
  const start = parseFloat(startTime) || 0;

  try {
    // 1. VÉRIFICATION SÉCURITÉ (Middleware JWT)
    if (!req.user) {
      return res.status(401).json({ error: "Authentification requise." });
    }

    if (req.user.role.toLowerCase() !== 'admin') {
      return res.status(403).json({ error: "Accès réservé aux administrateurs." });
    }

    if (!req.file) return res.status(400).json({ error: "Fichier audio manquant." });

    const tempPath = req.file.path;
    const outFileName = `cut_${Date.now()}.mp3`;
    const outputPath = path.join(audioTempDir, outFileName);

    // 2. DÉCOUPAGE VIA FFMPEG (30 secondes max)
    ffmpeg(tempPath)
      .setStartTime(start)
      .setDuration(30)
      .output(outputPath)
      .on('end', async () => {
        try {
          // 3. DÉTECTION DU TYPE DE CONTENU
          const extension = path.extname(req.file.originalname).toLowerCase();
          const contentType = extension === '.mp3' ? 'audio/mpeg' : 
                              extension === '.m4a' ? 'audio/mp4' : 'audio/wav';

          const fileContent = fs.readFileSync(outputPath);
          const s3Key = `propulse_stories_audio/official_${Date.now()}.mp3`;
          
          // 4. UPLOAD VERS S3
          const { PutObjectCommand } = require('@aws-sdk/client-s3');
          await s3.send(new PutObjectCommand({
            Bucket: 'propulse-media-final-storage',
            Key: s3Key,
            Body: fileContent,
            ContentType: contentType
          }));

          // 🟢 FIX : CONSTRUCTION DE L'URL AVEC LA RÉGION (Pour que la regex CDN de l'app fonctionne)
          // On ajoute .us-east-1 car c'est la région configurée dans ton S3Client
          const finalS3Url = `https://propulse-media-final-storage.s3.us-east-1.amazonaws.com/${s3Key}`;

          // 5. ENREGISTREMENT EN BASE DE DONNÉES
          const audio = await prisma.storyAudio.create({
            data: {
              title: title || "Son Officiel",
              audioUrl: finalS3Url, 
              duration: 30,
              authorId: req.user.userId,
              isPublic: true,
              isOfficial: true,
            },
            include: {
              author: { select: { id: true, fullName: true, avatarUrl: true } }
            }
          });

          // 6. NETTOYAGE
          if (fs.existsSync(tempPath)) fs.unlinkSync(tempPath);
          if (fs.existsSync(outputPath)) fs.unlinkSync(outputPath);

          console.log(`✅ Son officiel ${audio.title} prêt et compatible CDN.`);
          res.status(201).json(audio);

        } catch (s3Err) {
          console.error("❌ Erreur S3:", s3Err);
          res.status(500).json({ error: "Erreur lors de l'upload final." });
        }
      })
      .on('error', (err) => {
        console.error("❌ Erreur FFmpeg:", err);
        res.status(500).json({ error: "Erreur lors du découpage audio." });
      })
      .run();

  } catch (e) {
    console.error("❌ Erreur critique:", e);
    res.status(500).json({ error: e.message });
  }
});

