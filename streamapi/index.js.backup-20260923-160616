app.get('/communities/:id/events', async (req, res) => {
  const communityId = parseInt(req.params.id);
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 10;
  const skip = (page - 1) * limit;

  try {
    // Compte du total pour la pagination
    const totalCount = await prisma.event.count({
      where: { communityId: communityId }
    });

    const events = await prisma.event.findMany({
      where: { communityId: communityId },
      orderBy: { date: 'asc' }, // Trie par date (les événements les plus proches d'abord)
      skip: skip,
      take: limit,
      include: {
        user: { select: { id: true, fullName: true, avatarUrl: true } }, // Infos du créateur
        participants: {
          include: {
            user: {
              select: {
                id: true,
                fullName: true,
                avatarUrl: true,
                position: true,
                club: true
              }
            }
          }
        },
        _count: {
          select: { participants: true }
        }
      }
    });

    res.json({
      data: events,
      pagination: {
        page,
        limit,
        total: totalCount,
        hasMore: skip + events.length < totalCount
      }
    });
  } catch (error) {
    console.error("❌ Erreur lors de la récupération des événements du club :", error);
    res.status(500).json({ error: "Erreur serveur lors de la récupération des événements." });
  }
});

