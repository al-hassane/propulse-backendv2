    const existingPost = await prisma.post.findUnique({
      where: { id: postId }
    });
    
    if (!existingPost) {
      return res.status(404).json({ error: "Post introuvable" });
    }
    
    // Mettre à jour le post avec les tags IA
    const updatedPost = await prisma.post.update({
      where: { id: postId },
      data: { aiTags: aiTags }
    });
    
