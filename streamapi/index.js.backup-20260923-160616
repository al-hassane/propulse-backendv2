            avatarUrl: true,
            role: true,
            sport: true
          }
        }
      },
      take: 200 // On limite pour garder de la performance
    });

    // 2. Calculer les totaux par type d'action (Résumé pour les graphiques)
    const stats = await prisma.careerTeaserInteraction.groupBy({
      by: ['action'],
      _count: {
        action: true
      }
    });

