app.get('/duels/:id/details', async (req, res) => {
  const duelId = parseInt(req.params.id);

  try {
    const duel = await prisma.duel.findUnique({
      where: { id: duelId },
      include: {
        post1: { include: { user: { include: { certification: true } } } },
        post2: { include: { user: { include: { certification: true } } } },
        // On récupère les votes avec les infos des votants
        votes: {
          include: {
            user: {
              select: { id: true, fullName: true, avatarUrl: true, certification: true }
            }
          },
          orderBy: { id: 'desc' }, // Les plus récents en premier
          take: 50 // On limite à 50 pour ne pas surcharger
        }
      }
    });

    if (!duel) return res.status(404).json({ error: "Duel introuvable" });

    // Calcul des stats
    const votesP1 = duel.votes.filter(v => v.votedFor === duel.post1.userId);
    const votesP2 = duel.votes.filter(v => v.votedFor === duel.post2.userId);

    const countP1 = votesP1.length;
    const countP2 = votesP2.length;
    const total = countP1 + countP2;

    const percentP1 = total > 0 ? Math.round((countP1 / total) * 100) : 0;
    const percentP2 = total > 0 ? Math.round((countP2 / total) * 100) : 0;

    res.json({
      ...duel,
      stats: {
        p1: { count: countP1, percent: percentP1, voters: votesP1.map(v => v.user) },
        p2: { count: countP2, percent: percentP2, voters: votesP2.map(v => v.user) },
        total
      }
    });

  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur détails duel" });
  }
});


