// 🚀 [HUB ESPORT] EXPLORE : POSTS TENDANCES FILTRÉS PAR SPORT
// =========================================================================
app.get('/organizations/posts/explore', async (req, res) => {
  const userId = req.query.userId ? parseInt(req.query.userId) : null;
  const sport = req.query.sport;
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 20;
  const skip = (page - 1) * limit;

  try {
    let hiddenPostIds = [];
    if (userId) {
      const hidden = await prisma.hiddenOrganizationPost.findMany({
        where: { userId: userId },
        select: { postId: true }
      });
      hiddenPostIds = hidden.map(h => h.postId);
    }

    const whereCondition = {
      id: { notIn: hiddenPostIds }
    };

    if (sport && sport !== 'all' && sport !== 'Tous') {
      whereCondition.organization = {
        sportCategory: { equals: sport, mode: 'insensitive' }
      };
    }
    // 🟢 Ajout pour filtrer par type dans le Hub Esport
    if (req.query.mediaType) {
      whereCondition.mediaType = req.query.mediaType.toLowerCase(); // 'video' ou 'image'
    }

    const posts = await prisma.organizationPost.findMany({
      where: whereCondition,
      include: {
        author: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true } },
        organization: { select: { id: true, name: true, logo: true, sportCategory: true } },
        _count: { select: { likes: true, comments: true, votes: true } },
        likes: userId ? { where: { userId: userId } } : false,
        reactions: true,
        votes: true
      },
      orderBy: { createdAt: 'desc' },
      take: 200 
    });

    const scoredPosts = posts.map(p => {
      const likes = p._count.likes || 0;
      const comments = p._count.comments || 0;
      const views = p.views || 0;
      const ageInHours = (new Date() - new Date(p.createdAt)) / (1000 * 60 * 60);
      
      const score = (likes * 3 + comments * 5 + views * 0.5) / Math.pow(ageInHours + 2, 1.5);
      return { ...p, trendScore: score };
    });

    const sortedPosts = scoredPosts
      .sort((a, b) => b.trendScore - a.trendScore)
      .slice(skip, skip + limit);

    const formatted = sortedPosts.map(p => {
      // 🟢 Logique Polls — supporte N options
      const options = p.pollOptions || null;
      const myVote = p.votes?.find(v => v.userId === userId);
      let pollStats = [0, 0];
      let pollData = null;

      if (options && options.length > 0) {
        pollStats = new Array(options.length).fill(0);
        p.votes?.forEach(v => { if (v.option >= 0 && v.option < options.length) pollStats[v.option]++; });

        pollData = {
          options,
          counts: pollStats,
          totalVotes: pollStats.reduce((a, b) => a + b, 0),
          userVote: myVote ? myVote.option : null,
          endsAt: p.pollEndsAt || null,
        };
      }

      return {
        ...p,
        isLiked: p.likes?.length > 0,
        likesCount: p._count.likes,
        commentsCount: p._count.comments,
        userVote: myVote ? myVote.option : null,
        pollResults: pollStats,
        poll: pollData, // 🟢 NOUVEAU
        mediaUrl: toCdnUrl(p.mediaUrl),
