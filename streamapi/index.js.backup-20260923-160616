        case 'NEW_STORY':
          body = message || `${senderName} a ajouté une nouvelle story ! 📸`; break;
        case 'LIKE': 
          body = message || `${senderName} a aimé votre publication.`; break;
        case 'POLL_VOTE':
          body = message ? `${senderName} ${message}` : `${senderName} a répondu à votre sondage.`; break; 
