app.post('/organizations/posts/:id/vote', async (req, res) => {
  const postId = parseInt(req.params.id);
  const { userId, optionIndex } = req.body;
  const uId = parseInt(userId);

  try {
    // 1. On récupère le post et le nom de l'organisation pour la notification
    const post = await prisma.organizationPost.findUnique({ 
      where: { id: postId },
      include: { organization: { select: { name: true } } } 
    });

    if (!post || !post.pollOptions || optionIndex < 0 || optionIndex >= post.pollOptions.length) {
      return res.status(400).json({ error: "Sondage ou option invalide" });
    }

    // 2. Enregistrement du vote (Upsert : crée si n'existe pas, met à jour sinon)
    await prisma.organizationPostVote.upsert({
      where: { postId_userId: { postId, userId: uId } },
      update: { option: parseInt(optionIndex) },
      create: { postId, userId: uId, option: parseInt(optionIndex) }
    });

    // 3. 🟢 NOTIFICATION AU CRÉATEUR (Si ce n'est pas lui qui vote)
    if (post.authorId !== uId) {
      const options = post.pollOptions; // Tableau JSON ["Choix 1", "Choix 2"]
      const voteLabel = options[optionIndex] || "une option";

      await createNotification(
        "POLL_VOTE",      // type
        uId,              // senderId
        post.authorId,    // receiverId
        null, null, null, // postId, ratingId, eventId
        `a voté "${voteLabel}" à ton sondage sur ${post.organization.name} 🗳️`, // message
        null,             // storyId
        null,             // newsId
        null,             // communityId
        null,             // conversationId
        null,             // trainingId
        postId            // orgPostId (13ème position pour le clic)
      ).catch(e => console.log("Erreur envoi notif vote org:", e.message));
    }

    // 4. Calcul des nouveaux totaux pour renvoyer au mobile
    const votes = await prisma.organizationPostVote.findMany({ where: { postId } });
    const counts = new Array(post.pollOptions.length).fill(0);
    votes.forEach(v => { if (v.option < counts.length) counts[v.option]++; });

    res.json({
      counts,
      totalVotes: votes.length,
      userVote: parseInt(optionIndex)
    });
  } catch (e) {
    console.error("Erreur lors du vote:", e);
    res.status(500).json({ error: "Erreur lors du vote" });
  }
});


