// --- 2. RÉCUPÉRER MA BOUTIQUE (DASHBOARD) ---
app.get('/shops/my-shop/:userId', async (req, res) => {
  const { userId } = req.params;
  try {
    const shop = await prisma.shop.findUnique({
      where: { ownerId: parseInt(userId) },
      include: {
        products: { orderBy: { createdAt: 'desc' }, include: { images: true } },
        members: {
          include: {
            user: {
              select: { id: true, fullName: true, avatarUrl: true }
            }
          }
        },
        _count: { select: { orders: true, products: true, shopLikes: true } } 
      }
    });
    
    if (!shop) return res.json(null);

    // --- CALCUL DES ANALYTICS (Dernières 4 semaines) ---
    const now = new Date();
    const weeklyLikes = [];
    let currentWeekLikes = 0;
    let previousWeekLikes = 0;

    for (let i = 3; i >= 0; i--) {
        const start = new Date();
        start.setDate(now.getDate() - (i + 1) * 7);
        const end = new Date();
        end.setDate(now.getDate() - i * 7);

        const count = await prisma.shopLike.count({
            where: {
                shopId: shop.id,
                createdAt: { gte: start, lte: end }
            }
        });

        weeklyLikes.push({
            label: i === 0 ? "Sém. 4" : `Sém. ${4 - i}`,
            count: count
        });

        // On capture les deux dernières semaines pour le calcul du pourcentage
        if (i === 0) currentWeekLikes = count;
        if (i === 1) previousWeekLikes = count;
    }

    // Calcul du pourcentage de croissance (%)
    let growth = 0;
    if (previousWeekLikes > 0) {
        growth = ((currentWeekLikes - previousWeekLikes) / previousWeekLikes) * 100;
    } else if (currentWeekLikes > 0) {
        growth = 100.0; // Premier pas vers le succès !
    }

    const totalViews = shop.products.reduce((acc, product) => acc + product.views, 0);

    res.json({ 
        ...shop, 
        totalViews,
        analytics: {
            weeklyLikes,
            growth: growth.toFixed(1) // On renvoie une string propre comme "15.5"
        }
    }); 

  } catch (e) {
    console.error("Erreur Analytics Shop:", e);
    res.status(500).json({ error: "Erreur récupération boutique" });
  }
});

