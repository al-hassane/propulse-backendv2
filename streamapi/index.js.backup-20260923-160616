// --- Calcule la série de jours consécutifs avec au moins un vote ---
function computeStreak(voteDates) {
  if (voteDates.length === 0) return 0;

  // Normalise chaque date en "jour" (YYYY-MM-DD), dédoublonne, trie décroissant
  const days = [...new Set(voteDates.map(d => d.toISOString().slice(0, 10)))]
    .sort()
    .reverse();

  const todayStr = new Date().toISOString().slice(0, 10);
  const yesterdayStr = new Date(Date.now() - 86400000).toISOString().slice(0, 10);

  // Le streak est "actif" seulement si le dernier vote date d'aujourd'hui ou hier
  if (days[0] !== todayStr && days[0] !== yesterdayStr) return 0;

  let streak = 1;
  let cursor = new Date(days[0]);

  for (let i = 1; i < days.length; i++) {
    const expected = new Date(cursor);
    expected.setDate(expected.getDate() - 1);
    const expectedStr = expected.toISOString().slice(0, 10);

    if (days[i] === expectedStr) {
      streak++;
      cursor = expected;
    } else {
      break;
    }
  }

  return streak;
}

