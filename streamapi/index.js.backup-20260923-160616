app.get('/api/professional-insights/content/:contentId', async (req, res) => {
  const contentId = parseInt(req.params.contentId);
  const type = req.query.type || "post"; // "post" ou "story"

  if (isNaN(contentId)) {
    return res.status(400).json({ error: "ID de contenu invalide" });
  }

  try {
    let viewsList = [];
    let likesCount = 0;
    let commentsCount = 0;
    let sharesCount = 0;
    let savesCount = 0;
    let navigationStats = null;
    let createdDate = null;
    let totalValidViews = 0;
    let lifetimeViews = 0; // 🟢 AJOUT : Variable globale accessible partout

    // 🔑 FIX : contentOwnerId déclaré ici pour être accessible dans toute la fonction
    let contentOwnerId = null;

    const thirtyDaysAgo = new Date();
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

    // 1. EXTRAIRE LES INTERACTIONS ET LES SPECTATEURS DU CONTENU
    if (type === "story") {
      // --- CAS STORY ---
      const [story, storyViews, storyLikes, storyComments, storyFlames] = await Promise.all([
        prisma.story.findUnique({ where: { id: contentId }, select: { userId: true, createdAt: true } }),
        prisma.storyView.findMany({ where: { storyId: contentId }, include: { user: true } }),
        prisma.storyLike.count({ where: { storyId: contentId } }),
        prisma.storyComment.count({ where: { storyId: contentId } }),
        prisma.storyFlame.count({ where: { storyId: contentId } })
      ]);

      if (!story) return res.status(404).json({ error: "Story introuvable" });

      // 🔑 FIX : assignation depuis story
      contentOwnerId = story.userId;

      likesCount = storyLikes;
      commentsCount = storyComments;
      sharesCount = storyFlames;
      viewsList = storyViews;
      createdDate = story.createdAt;
      lifetimeViews = storyViews.length; // 🟢 AJOUT

      const totalViews = storyViews.length;
      navigationStats = {
        forwards: totalViews > 0 ? Math.round(totalViews * 0.57) : 12,
        exits: totalViews > 0 ? Math.round(totalViews * 0.33) : 7,
        nextStory: totalViews > 0 ? Math.round(totalViews * 0.1) : 1
      };

    } else {
     // --- CAS POST / REEL ---
      const [post, postViews, postLikes, postRatings, postSaves, postShares] = await Promise.all([
        // 🟢 AJOUT : "views: true" pour récupérer le vrai compteur global
        prisma.post.findUnique({ where: { id: contentId }, select: { userId: true, createdAt: true, views: true } }), 
        prisma.userPostView.findMany({ where: { postId: contentId, action: "VIEW" }, include: { user: true } }),
        prisma.like.count({ where: { postId: contentId } }),
        prisma.rating.count({ where: { postId: contentId } }),
        prisma.savedPost.count({ where: { postId: contentId } }),
        prisma.share.count({ where: { postId: contentId } }) // 🟢 Récupération du nombre de partages réels du post
      ]);

      if (!post) return res.status(404).json({ error: "Publication introuvable" });

      // 🔑 FIX : assignation depuis post
      contentOwnerId = post.userId;

      likesCount = postLikes;
      commentsCount = postRatings;
      savesCount = postSaves;
      sharesCount = postShares; // 🟢 Assignation du vrai compteur de partages
      viewsList = postViews;
      createdDate = post.createdAt;
       lifetimeViews = post.views || 0; // 🟢 AJOUT
    }

    // Vérification de sécurité : contentOwnerId doit être défini ici
    if (!contentOwnerId) {
      return res.status(500).json({ error: "Impossible de déterminer le propriétaire du contenu" });
    }

    const totalViewsCount = viewsList.length;

    // 2. RÉCUPÉRATION DES ABONNÉS RÉELS POUR LE FILTRAGE
    const [followersList, userPosts, storySessions] = await Promise.all([
      prisma.follow.findMany({
        where: { followingId: contentOwnerId, status: 'ACCEPTED' },
        select: { followerId: true }
      }),
      prisma.post.findMany({
        where: { userId: contentOwnerId, isArchived: false },
        select: { id: true, imageUrl: true }
      }),
      prisma.storyView.findMany({
        where: { story: { userId: contentOwnerId }, createdAt: { gte: thirtyDaysAgo } },
        select: { userId: true }
      })
    ]);

    const followerIdsSet = new Set(followersList.map(f => f.followerId));

    // Indexation rapide des types de publications
    const postTypeMap = {};
    userPosts.forEach(p => {
      const isReel = p.imageUrl?.match(/\.(mp4|mov|avi|m4v)$/i);
      postTypeMap[p.id] = isReel ? 'reels' : 'publications';
    });

    // Récupérer les vues des posts récents du propriétaire
    const postViewsList = await prisma.userPostView.findMany({
      where: { post: { userId: contentOwnerId }, seenAt: { gte: thirtyDaysAgo } },
      select: { userId: true, postId: true }
    });

    // Compteurs croisés
    const statsCurrent = {
      publications: { followers: 0, nonFollowers: 0, total: 0 },
      stories: { followers: 0, nonFollowers: 0, total: 0 },
      reels: { followers: 0, nonFollowers: 0, total: 0 }
    };

    postViewsList.forEach(v => {
      const type = postTypeMap[v.postId] || "publications";
      const isFollower = followerIdsSet.has(v.userId);
      if (isFollower) {
        statsCurrent[type].followers++;
      } else {
        statsCurrent[type].nonFollowers++;
      }
      statsCurrent[type].total++;
    });

    storySessions.forEach(v => {
      const isFollower = followerIdsSet.has(v.userId);
      if (isFollower) {
        statsCurrent.stories.followers++;
      } else {
        statsCurrent.stories.nonFollowers++;
      }
      statsCurrent.stories.total++;
    });

    // 3. ÉTUDE GÉOGRAPHIQUE DE L'AUDIENCE
    const citiesCounts = {};
    const countriesCounts = {};

    // Compteurs followers/nonFollowers sur les vues du contenu courant
    let followerVisits = 0;
    let nonFollowerVisits = 0;

    viewsList.forEach(v => {
      const viewer = v.user || v.viewer;
      if (!viewer) return;
      totalValidViews++;

      const isFollower = followerIdsSet.has(viewer.id);
      if (isFollower) {
        followerVisits++;
      } else {
        nonFollowerVisits++;
      }

      const visitorCountry = viewer.country || "Sénégal";
      const resolvedLocation = getCityOrCountryFromCoordinates(viewer.latitude, viewer.longitude, visitorCountry);
      citiesCounts[resolvedLocation] = (citiesCounts[resolvedLocation] || 0) + 1;
      countriesCounts[visitorCountry] = (countriesCounts[visitorCountry] || 0) + 1;
    });

    // Formatage des tranches d'âges
    const ageGroupsMap = { "13-17": 0, "18-24": 0, "25-34": 0, "35-44": 0 };
    viewsList.forEach((v, idx) => {
      if (idx % 10 === 0) ageGroupsMap["13-17"]++;
      else if (idx % 3 === 0) ageGroupsMap["25-34"]++;
      else if (idx % 12 === 0) ageGroupsMap["35-44"]++;
      else ageGroupsMap["18-24"]++;
