// --- 2. TRAITER UN SIGNALEMENT (Action de suppression ou rejet) ---
app.post('/admin/reports/resolve', async (req, res) => {
  const { reportId, action } = req.body; // action: 'DELETE_CONTENT' ou 'DISMISS'

  try {
    // 1. On récupère les détails du signalement pour savoir si c'est un post ou une story
    const report = await prisma.report.findUnique({ 
      where: { id: parseInt(reportId) } 
    });

    if (!report) return res.status(404).json({ error: "Signalement introuvable" });

    if (action === 'DELETE_CONTENT') {
      
      // --- CAS A : C'EST UN POST ---
      if (report.postId) {
        const postId = report.postId;
        await prisma.$transaction([
          prisma.pollVote.deleteMany({ where: { postId } }),
          prisma.like.deleteMany({ where: { postId } }),
          prisma.ratingLike.deleteMany({ where: { rating: { postId } } }),
          prisma.rating.deleteMany({ where: { postId } }),
          prisma.notification.deleteMany({ where: { postId } }),
          prisma.savedPost.deleteMany({ where: { postId } }),
          prisma.hiddenPost.deleteMany({ where: { postId } }),
          prisma.report.deleteMany({ where: { postId } }),
          prisma.post.delete({ where: { id: postId } })
        ]);
        return res.json({ message: "Publication et données liées supprimées." });
      }

      if (report.organizationId && action === 'DELETE_CONTENT') {
    // Si l'admin décide de sévir suite au signalement
    await prisma.organization.update({
        where: { id: report.organizationId },
        data: { status: "REJECTED" } // On suspend/rejette l'organisation
    });
    
    // On met à jour le statut du rapport
    await prisma.report.update({
        where: { id: parseInt(reportId) },
        data: { status: "RESOLVED" }
    });

    return res.json({ message: "L'organisation a été sanctionnée et le rapport clôturé." });
}

      // --- CAS B : C'EST UNE STORY ---
      if (report.storyId) {
        const storyId = report.storyId;
        await prisma.$transaction([
          prisma.storyLike.deleteMany({ where: { storyId } }),
          prisma.storyFlame.deleteMany({ where: { storyId } }),
          prisma.storyComment.deleteMany({ where: { storyId } }),
          prisma.storyView.deleteMany({ where: { storyId } }),
          prisma.savedStory.deleteMany({ where: { storyId } }),
          prisma.notification.deleteMany({ where: { storyId } }),
          prisma.report.deleteMany({ where: { storyId } }), // Supprime tous les signalements de cette story
          prisma.story.delete({ where: { id: storyId } })
        ]);
        return res.json({ message: "Story et interactions supprimées." });
      }

    } else if (action === 'DISMISS') {
      // --- ACTION : IGNORER LE SIGNALEMENT (Faux signalement) ---
      await prisma.report.update({
        where: { id: parseInt(reportId) },
        data: { status: 'DISMISSED' }
      });

      return res.json({ message: "Signalement ignoré." });
    }

  } catch (e) {
    console.error("Erreur Modération :", e);
    res.status(500).json({ error: "Erreur lors du traitement", details: e.message });
  }
});

// --- [ADMIN] RÉCUPÉRER TOUS LES POSTS (MODIFIÉ POUR FILTRER PAR TYPE) ---
app.get('/admin/posts', async (req, res) => {
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 30;
  const skip = (page - 1) * limit;
  const search = req.query.search || "";
  const type = req.query.type || "all"; // 🟢 'user', 'club' ou 'all'

  try {
    const whereCondition = {};

    // 🟢 FILTRAGE PAR TYPE
    if (type === 'user') {
      whereCondition.communityId = null; // Uniquement les posts simples
    } else if (type === 'club') {
      whereCondition.communityId = { not: null }; // Uniquement les posts de clubs
    }

    if (search) {
      whereCondition.OR = [
        { description: { contains: search, mode: 'insensitive' } },
        { user: { fullName: { contains: search, mode: 'insensitive' } } }
      ];
    }

    const [posts, total] = await Promise.all([
      prisma.post.findMany({
        where: whereCondition,
        take: limit,
        skip: skip,
        orderBy: { createdAt: 'desc' },
        include: {
          user: true,
          media: true,
          community: true,
          _count: { select: { likes: true, ratings: true, reports: true } }
        }
      }),
      prisma.post.count({ where: whereCondition })
    ]);

    res.json({
      posts,
      pagination: { total, page, lastPage: Math.ceil(total / limit) }
    });
  } catch (e) {
    res.status(500).json({ error: "Erreur serveur" });
  }
});

