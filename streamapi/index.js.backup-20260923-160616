// GET /audio/:audioId/posts — Grille des publications utilisant ce son
app.get('/audio/:audioId/posts', async (req, res) => {
  const audioId = parseInt(req.params.audioId);
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 30;
  const sort = req.query.sort || 'popular'; // 👈 Récupère le tri (popular ou recent)
  const skip = (page - 1) * limit;

  try {

    const orderBy = sort === 'recent' 
      ? { createdAt: 'desc' } 
      : { views: 'desc' }; // 'popular' par défaut

    const posts = await prisma.post.findMany({
      where: { 
        audioId: audioId,
        isArchived: false 
      },
      include: {
        user: { select: { id: true, fullName: true, avatarUrl: true } },
        media: true,
        likes: true,
        ratings: true,
        votes: true,
        _count: { select: { ratings: true, votes: true, likes: true } }
      },
     orderBy: orderBy, // 👈 Applique le tri ici
      take: limit,
      skip: skip
    });

    const totalCount = await prisma.post.count({ where: { audioId } });

    // Formatage pour MediaViewer (important pour ton CTO)
    const formattedData = posts.map(p => {
      const validRatings = (p.ratings || []).filter(r => r.score > 0);
      const avg = validRatings.length > 0 ? validRatings.reduce((acc, r) => acc + r.score, 0) / validRatings.length : 0;
      
      return {
        ...p,
        imageUrl: toCdnUrl(p.imageUrl),
        media: p.media?.map(m => ({ ...m, url: toCdnUrl(m.url) })),
        averageRating: avg.toFixed(1),
        pollStats: {
          YES: (p.votes || []).filter(v => v.option === 'YES').length,
          NO: (p.votes || []).filter(v => v.option === 'NO').length
        }
      };
    });

    res.json({
      data: formattedData,
      pagination: {
        hasMore: skip + posts.length < totalCount,
        total: totalCount
      }
    });
  } catch (error) {
    res.status(500).json({ error: "Erreur serveur" });
  }
});


