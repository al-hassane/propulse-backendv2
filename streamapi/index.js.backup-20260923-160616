    const weeks = [];
    for (let i = 3; i >= 0; i--) {
      const start = new Date();
      start.setDate(now.getDate() - (i + 1) * 7);
      const end = new Date();
      end.setDate(now.getDate() - i * 7);

      const [likes, followers, views] = await Promise.all([
        prisma.like.count({ where: { post: { userId }, createdAt: { gte: start, lte: end } } }),
        prisma.follow.count({ where: { followingId: userId, createdAt: { gte: start, lte: end } } }),
        prisma.post.aggregate({ 
          where: { userId, createdAt: { gte: start, lte: end } },
          _sum: { views: true }
        })
      ]);

      weeks.push({
        label: i === 0 ? "Cette sem." : `S-${i}`,
        likes,
        followers,
        views: views._sum.views || 0
      });
    }

    const postsPerformance = await prisma.post.findMany({
      where: { userId },
      include: { 
        media: true, // <--- ON UTILISE INCLUDE AU LIEU DE SELECT ICI
        _count: { select: { likes: true } } 
      },
      orderBy: { views: 'desc' },
      take: 5
