app.get('/scout/radar', async (req, res) => {
  // 🟢 On récupère les filtres envoyés par l'URL (ex: ?userId=1&sport=basketball&minLevel=3)
  const { userId, sport, minLevel } = req.query;
  const uId = parseInt(userId);

  if (isNaN(uId)) {
    return res.status(400).json({ error: "ID utilisateur invalide ou manquant." });
  }

  try {
    const me = await prisma.user.findUnique({ where: { id: uId } });

    if (!me || me.latitude === null || me.longitude === null) {
      return res.json([]);
    }

    const myLat = parseFloat(me.latitude);
    const myLng = parseFloat(me.longitude);
    const activeThreshold = new Date(Date.now() - 24 * 60 * 60 * 1000);

    // 🟢 Construction dynamique des filtres de recherche
    const whereCondition = {
      role: 'joueur',
      id: { not: uId },
      latitude: { not: null },
      longitude: { not: null },
      lastLocUpdate: { gte: activeThreshold },
      blockedBy: { none: { blockerId: uId } },
      blockedUsers: { none: { blockedId: uId } }
    };

    // Si un sport est sélectionné, on filtre dessus
    if (sport && sport !== 'null' && sport !== 'undefined' && sport !== 'all') {
      whereCondition.sport = sport;
    }

    // Si un niveau minimum est demandé, on filtre (gte = Greater Than or Equal)
    if (minLevel && !isNaN(parseInt(minLevel))) {
      whereCondition.level = { gte: parseInt(minLevel) };
    }

    const users = await prisma.user.findMany({
      where: whereCondition,
      select: {
        id: true, fullName: true, avatarUrl: true, level: true, sport: true, role: true,
        latitude: true, longitude: true, lastLocUpdate: true,
        batteryLevel: true,
        position: true
      }
    });

    const toRad = (v) => (v * Math.PI) / 180;
    const nearby = users
  .map(user => {
    const uLat = parseFloat(user.latitude);
    const uLng = parseFloat(user.longitude);

    if (isNaN(uLat) || isNaN(uLng)) return null; // 🛡️ sécurité

    const R = 6371;
    const dLat = toRad(uLat - myLat);
    const dLon = toRad(uLng - myLng);
    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
              Math.cos(toRad(myLat)) * Math.cos(toRad(uLat)) *
              Math.sin(dLon / 2) * Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    const distance = R * c;

    return {
      ...user,
      avatarUrl: user.avatarUrl ? toCdnUrl(user.avatarUrl) : user.avatarUrl,
      distance: parseFloat(distance.toFixed(2))
    };
  })
  .filter(user => user !== null && user.distance < 15)
  .sort((a, b) => a.distance - b.distance)
  .slice(0, 20);

    res.json(nearby);
  } catch (e) {
    console.error("❌ Erreur Radar JS:", e);
    res.status(500).json({ error: "Erreur serveur radar" });
  }
});


