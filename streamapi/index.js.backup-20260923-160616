// [ADMIN] Supprimer une ASC (Équipe) - NETTOYAGE TOTAL
app.delete('/admin/ascs/:id', async (req, res) => {
  const ascId = parseInt(req.params.id);
  try {
    // 1. On trouve d'abord les IDs des matchs où cette équipe a joué
    const teamMatches = await prisma.match.findMany({
      where: { OR: [{ homeTeamId: ascId }, { awayTeamId: ascId }] },
      select: { id: true }
    });
    const matchIds = teamMatches.map(m => m.id);

    await prisma.$transaction([
      // Nettoyage des joueurs (on les libère, on ne les tue pas)
      prisma.user.updateMany({ where: { ascId: ascId }, data: { ascId: null } }),
      // Nettoyage des données de matchs liés à cette équipe
      prisma.matchEvent.deleteMany({ where: { matchId: { in: matchIds } } }),
      prisma.matchComment.deleteMany({ where: { matchId: { in: matchIds } } }),
      prisma.matchLineup.deleteMany({ where: { matchId: { in: matchIds } } }),
      prisma.matchStats.deleteMany({ where: { matchId: { in: matchIds } } }),
      // Nettoyage de l'équipe elle-même
      prisma.standing.deleteMany({ where: { ascId: ascId } }),
      prisma.match.deleteMany({ where: { id: { in: matchIds } } }),
      prisma.asc.delete({ where: { id: ascId } })
    ]);

    res.json({ message: "Équipe et son historique supprimés." });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur lors de la suppression de l'ASC" });
  }
});

// [ADMIN] Supprimer une Zone - NETTOYAGE TOTAL
app.delete('/admin/zones/:id', async (req, res) => {
  const zoneId = parseInt(req.params.id);
  try {
    // 1. On récupère les IDs des équipes dans cette zone
    const ascsInZone = await prisma.asc.findMany({ where: { zoneId }, select: { id: true } });
    const ascIds = ascsInZone.map(a => a.id);

    // 2. On récupère les matchs de cette zone
    const matchesInZone = await prisma.match.findMany({ where: { zoneId }, select: { id: true } });
    const matchIds = matchesInZone.map(m => m.id);

    await prisma.$transaction([
      // On libère les joueurs des équipes de la zone
      prisma.user.updateMany({ where: { ascId: { in: ascIds } }, data: { ascId: null } }),
      // On vide les données des matchs
      prisma.matchEvent.deleteMany({ where: { matchId: { in: matchIds } } }),
      prisma.matchComment.deleteMany({ where: { matchId: { in: matchIds } } }),
      prisma.matchLineup.deleteMany({ where: { matchId: { in: matchIds } } }),
      prisma.matchStats.deleteMany({ where: { matchId: { in: matchIds } } }),
      // On vide les équipes et les matchs
      prisma.standing.deleteMany({ where: { zoneId: zoneId } }),
      prisma.match.deleteMany({ where: { zoneId: zoneId } }),
      prisma.asc.deleteMany({ where: { zoneId: zoneId } }),
      // Enfin la zone Pour faire en dotre aue sa marhche bieen 
      prisma.zone.delete({ where: { id: zoneId } })
    ]);

    res.json({ message: "Zone et tout son contenu supprimés." });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "Erreur lors de la suppression de la Zone" });
  }
});


// DANS SERVER.JS - Route de suppression d'événement
app.delete('/admin/matches/:matchId/events/:eventId', async (req, res) => {
  const { matchId, eventId } = req.params;

  try {
    // 1. Trouver l'événement avant de le supprimer
    const event = await prisma.matchEvent.findUnique({ where: { id: parseInt(eventId) } });
    if (!event) return res.status(404).json({ error: "Événement introuvable" });

    // 2. Si c'est un BUT, on décrémente le score du match
    if (event.type === 'GOAL') {
      const match = await prisma.match.findUnique({ where: { id: parseInt(matchId) } });
      
      if (match.homeTeamId === event.teamId) {
        await prisma.match.update({
          where: { id: parseInt(matchId) },
          data: { homeScore: { decrement: 1 } }
        });
      } else {
        await prisma.match.update({
          where: { id: parseInt(matchId) },
          data: { awayScore: { decrement: 1 } }
        });
      }
    }

    // 3. Supprimer l'événement
    await prisma.matchEvent.delete({ where: { id: parseInt(eventId) } });

    res.json({ message: "Événement supprimé et score mis à jour" });
  } catch (e) {
    res.status(500).json({ error: "Erreur lors de la suppression" });
  }
});

