// --- 4. ROUTE ADMIN : ACCEPTER OU REJETER (Pour tes tests) ---
app.put('/admin/certifications/:id/review', async (req, res) => {
  const { status, reason } = req.body; // "APPROVED" ou "REJECTED" + motif
  const certId = parseInt(req.params.id);

  try {
    const certRequest = await prisma.playerCertification.findUnique({
      where: { id: certId }
    });

    if (!certRequest) {
      return res.status(404).json({ error: "Demande de certification introuvable." });
    }

    if (status === "REJECTED") {
      await prisma.playerCertification.update({
        where: { id: certId },
        data: { status: "REJECTED", reason: reason }
      });
      
      const adminUser = await prisma.user.findFirst({ where: { role: 'admin' } });
      const senderId = adminUser ? adminUser.id : certRequest.userId;

      await createNotification(
        "ADMIN", 
        senderId, 
        certRequest.userId, 
        null, null, null, 
        `Votre demande de certification ${certRequest.tier} a été refusée. Motif : ${reason || 'Dossier non conforme'}`
      );
      
      return res.json({ message: "Dossier refusé et archivé." });
    }

    if (status === "APPROVED") {
      const now = new Date();
      const expiry = new Date();
      expiry.setDate(now.getDate() + 30); // Validité de 30 jours

      // 🟢 TRANSACTION SÉCURISÉE : Tout est mis à jour simultanément
      const result = await prisma.$transaction([
        prisma.playerCertification.update({
          where: { id: certId },
          data: { 
            status: "APPROVED",       
            paymentStatus: true,      
            paymentDate: now,         
            expiryDate: expiry
          }
        }),
        // 🌟 Mise à jour de l'utilisateur avec son palier spécifique !
        prisma.user.update({
          where: { id: certRequest.userId },
          data: { 
            isVerified: true,
            certifTier: certRequest.tier // PREMIUM, GOLD ou ELITE
          }
        })
      ]);

      const adminUser = await prisma.user.findFirst({ where: { role: 'admin' } });
      const senderId = adminUser ? adminUser.id : certRequest.userId;

      await createNotification(
        "ADMIN", 
        senderId,
        certRequest.userId, 
        null, null, null, 
        `Félicitations ! Votre demande de certification ${certRequest.tier} a été approuvée avec succès ! 🏆`
      );

      return res.json({ message: `Certification ${certRequest.tier} approuvée avec succès !`, data: result[0] });
    }
  } catch (e) {
    console.error("Erreur Review Certif:", e);
    res.status(500).json({ error: "Erreur lors du traitement du dossier." });
  }
});

