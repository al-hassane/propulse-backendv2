// 1. RÉCUPÉRER UNE PUB ACTIVE POUR LE FEED (Mobile) - ALTERNANCE SANS LIMITE
app.get('/api/propulse-ads/active', async (req, res) => {
  const { userId, sport, role } = req.query;
  const now = new Date();

  // Si pas d'userId, on ne peut pas tracker les impressions
  if (!userId || userId === 'null' || userId === 'undefined') {
    return res.json(null);
  }

  try {
    const userIdInt = parseInt(userId);
    
    // Récupérer uniquement la dernière pub vue
    const lastSeenAd = await prisma.propulseAdImpression.findFirst({
      where: { userId: userIdInt },
      orderBy: { viewedAt: 'desc' },
      select: { adId: true }
    });
    
    // Exclure la dernière pub vue
    const excludedAdIds = lastSeenAd ? [lastSeenAd.adId] : [0];

    // 🟢 CONSTRUIRE LE FILTRE DE CIBLAGE INTELLIGENT
    const adFilter = {
      isActive: true,
      startDate: { lte: now },
      endDate: { gte: now },
      id: { notIn: excludedAdIds }
    };

    const andConditions = [];

    // Filtre de Rôle (uniquement si ce n'est pas ALL/vide)
    if (role && role !== 'ALL' && role !== 'undefined' && role !== '') {
      andConditions.push({
        OR: [
          { targetRole: 'ALL' },
          { targetRole: { equals: String(role), mode: 'insensitive' } }
        ]
      });
    }

    // Filtre de Sport (uniquement si ce n'est pas ALL/vide)
    if (sport && sport !== 'ALL' && sport !== 'undefined' && sport !== '') {
      andConditions.push({
        OR: [
          { targetSport: 'ALL' },
          { targetSport: { equals: String(sport), mode: 'insensitive' } }
        ]
      });
    }

    if (andConditions.length > 0) {
      adFilter.AND = andConditions;
    }

    // Récupérer la publicité correspondante
    let ad = await prisma.propulseAd.findFirst({
      where: adFilter,
      include: { images: true },
      orderBy: { priority: 'asc' }
    });

    // S'il n'y a qu'une seule pub disponible au total, on l'affiche quand même (Fallback)
    if (!ad && lastSeenAd) {
      const fallbackFilter = {
        isActive: true,
        startDate: { lte: now },
        endDate: { gte: now }
      };

      if (andConditions.length > 0) {
        fallbackFilter.AND = andConditions;
      }

      const onlyAd = await prisma.propulseAd.findFirst({
        where: fallbackFilter,
        include: { images: true },
        orderBy: { priority: 'asc' }
      });
      
      if (onlyAd) {
        await prisma.propulseAdImpression.upsert({
          where: { adId_userId: { adId: onlyAd.id, userId: userIdInt } },
          update: { viewedAt: now },
          create: { adId: onlyAd.id, userId: userIdInt, viewedAt: now }
        });
        
        await prisma.propulseAd.update({
          where: { id: onlyAd.id },
          data: { impressions: { increment: 1 } }
        });
        
        // Formater les URLs du fallback
        if (onlyAd.mediaUrl) {
          onlyAd.mediaUrl = toCdnUrl(onlyAd.mediaUrl);
        }
        
        if (onlyAd.images && onlyAd.images.length > 0) {
          onlyAd.images = onlyAd.images.map(img => ({
            ...img,
            url: toCdnUrl(img.url)
          }));
        }
        
        console.log(`📢 Une seule pub disponible (Fallback): ${onlyAd.title}`);
        return res.json(onlyAd);
      }
    }

    // Enregistrer l'impression si une pub a été trouvée
    if (ad && userIdInt) {
      await prisma.propulseAdImpression.upsert({
        where: { adId_userId: { adId: ad.id, userId: userIdInt } },
        update: { viewedAt: now },
        create: { adId: ad.id, userId: userIdInt, viewedAt: now }
      });
      
      await prisma.propulseAd.update({
        where: { id: ad.id },
        data: { impressions: { increment: 1 } }
      });
    }

    // Formater les URLs de la pub principale
    if (ad) {
      if (ad.mediaUrl) {
        ad.mediaUrl = toCdnUrl(ad.mediaUrl);
      }
      
      if (ad.images && ad.images.length > 0) {
        ad.images = ad.images.map(img => ({
          ...img,
          url: toCdnUrl(img.url)
        }));
      }
    }

    console.log(`📢 Pub active affichée: ${ad?.title || 'aucune'}`);
    res.json(ad);
  } catch (error) {
    console.error("❌ Erreur récupération pub active:", error);
    res.status(500).json(null);
  }
});

// 2. RÉCUPÉRER LA SÉQUENCE DES PUBS ACTIVES POUR LES REELS (RÉARRANGÉE PAR HISTORIQUE VUE)
app.get('/api/propulse-ads/list', async (req, res) => {
  const { userId, sport, role } = req.query;
  const now = new Date();

  try {
    // 🟢 CONSTRUIRE LE FILTRE DE CIBLAGE INTELLIGENT POUR LA LISTE
    const listFilter = {
      isActive: true,
      startDate: { lte: now },
      endDate: { gte: now }
    };

    const andConditions = [];

    if (role && role !== 'ALL' && role !== 'undefined' && role !== '') {
      andConditions.push({
        OR: [
          { targetRole: 'ALL' },
          { targetRole: { equals: String(role), mode: 'insensitive' } }
        ]
      });
    }

    if (sport && sport !== 'ALL' && sport !== 'undefined' && sport !== '') {
      andConditions.push({
        OR: [
          { targetSport: 'ALL' },
          { targetSport: { equals: String(sport), mode: 'insensitive' } }
        ]
      });
    }

    if (andConditions.length > 0) {
      listFilter.AND = andConditions;
    }

    // Récupérer l'ensemble des publicités ciblées actives
    const ads = await prisma.propulseAd.findMany({
      where: listFilter,
      include: { images: true },
      orderBy: { priority: 'asc' }
    });

    if (ads.length === 0) return res.json([]);

    let orderedAds = ads;
    const userIdInt = parseInt(userId);

    // Faire tourner la liste pour que la dernière vue glisse à la fin
    if (userIdInt && !isNaN(userIdInt)) {
      const lastSeenAd = await prisma.propulseAdImpression.findFirst({
        where: { userId: userIdInt },
        orderBy: { viewedAt: 'desc' },
        select: { adId: true }
      });

      if (lastSeenAd) {
        const lastIndex = ads.findIndex(a => a.id === lastSeenAd.adId);
        if (lastIndex !== -1) {
          orderedAds = [
            ...ads.slice(lastIndex + 1),
            ...ads.slice(0, lastIndex + 1)
          ];
        }
      }
