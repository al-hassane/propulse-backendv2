// --- DANS SERVER.JS : PARTICIPER À UN ÉVÉNEMENT (CORRIGÉ PAR LE CTO) ---
app.post('/events/:id/participate', async (req, res) => {
  const eventId = parseInt(req.params.id);
  const { userId } = req.body; // ID de l'utilisateur qui clique

  try {
    // 1. Vérification de l'utilisateur
    const user = await prisma.user.findUnique({ where: { id: parseInt(userId) } });
    if (!user) return res.status(404).json({ error: "Utilisateur introuvable" });

    // Sécurité : Un manager ne s'inscrit pas à un événement de talent
    if (user.role === 'manager') {
      return res.status(403).json({ error: "Un manager ne peut pas participer à un événement." });
    }

    // 2. Vérifier si l'utilisateur participe déjà (Toggle)
    const existing = await prisma.eventParticipant.findUnique({
      where: { eventId_userId: { eventId, userId: parseInt(userId) } }
    });

    if (existing) {
      // DÉSINSCRIPTION
      await prisma.eventParticipant.delete({ where: { id: existing.id } });
      return res.json({ participating: false, message: "Participation annulée" });
    } else {
      // INSCRIPTION
      await prisma.eventParticipant.create({
        data: { eventId, userId: parseInt(userId) }
      });

      // 3. LOGIQUE DE NOTIFICATION (On prévient le créateur de l'évent)
      const event = await prisma.event.findUnique({ where: { id: eventId } });
      
      if (event && event.userId !== parseInt(userId)) {
        // On envoie une notif au manager (destinataire = event.userId)
        await createNotification(
            "PARTICIPANT", 
            userId,           // Sender (Le joueur ou coach)
            event.userId,     // Receiver (Le manager créateur)
            null,             // postId
            null,             // ratingId
            eventId,          // eventId (Pour que le manager puisse cliquer sur la notif)
            `${user.fullName} s'est inscrit à votre événement !`
        );
      }

      return res.json({ participating: true, message: "Inscription réussie" });
    }
  } catch (error) {
    console.error("Erreur Participation:", error);
    res.status(500).json({ error: "Erreur lors de la participation" });
  }
});

