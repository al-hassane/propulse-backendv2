app.get('/organizations/:id/posts', async (req, res) => {
  const orgId = parseInt(req.params.id);
  const userId = req.query.userId ? parseInt(req.query.userId) : null;
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 15;
  const skip = (page - 1) * limit;

  try {
    // 1. 🟢 RÉCUPÉRER LES IDS DES POSTS MASQUÉS PAR CET UTILISATEUR
    let hiddenPostIds = [];
    if (userId) {
      const hidden = await prisma.hiddenOrganizationPost.findMany({
        where: { userId: parseInt(userId) },
        select: { postId: true }
      });
      hiddenPostIds = hidden.map(h => h.postId);
    }

    // 🟢 Ajout pour filtrer par type dans le Hub Esport
if (req.query.mediaType) {
  whereCondition.mediaType = req.query.mediaType.toLowerCase(); // 'video' ou 'image'
}

    // 2. RÉCUPÉRER LES POSTS EN EXCLUANT LES MASQUÉS
    const posts = await prisma.organizationPost.findMany({
      where: { 
        organizationId: orgId,
        id: hiddenPostIds.length > 0 ? { notIn: hiddenPostIds } : undefined 
      },
      include: {
        author: { select: { id: true, fullName: true, avatarUrl: true, isVerified: true } },
        _count: { select: { likes: true, comments: true, votes: true } },
        likes: userId ? { where: { userId: parseInt(userId) } } : false,
        reactions: true,
        votes: true
      },
      orderBy: { createdAt: 'desc' },
      skip,
      take: limit
    });

    // 3. FORMATAGE POUR LE FRONTEND (CDN + STATS)
    const formatted = posts.map(p => {

      // 🟢 Logique Polls — supporte maintenant N options (pas juste 2)
      const options = p.pollOptions || null;
      const myVote = p.votes?.find(v => v.userId === parseInt(userId));
      let pollStats = [0, 0];
      let pollData = null;

      if (options && options.length > 0) {
        pollStats = new Array(options.length).fill(0);
        p.votes?.forEach(v => { if (v.option >= 0 && v.option < options.length) pollStats[v.option]++; });

        pollData = {
          options,
          counts: pollStats,
          totalVotes: pollStats.reduce((a, b) => a + b, 0),
          userVote: myVote ? myVote.option : null,
          endsAt: p.pollEndsAt || null,
        };
      }

      // Optionnel : Calculer le topReactions ici si ton app en a besoin
      const emojiMap = {};
      p.reactions.forEach(r => emojiMap[r.emoji] = (emojiMap[r.emoji] || 0) + 1);
      const topReactions = Object.entries(emojiMap)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 3)
        .map(e => e[0]);

      return {
        ...p,
        isLiked: p.likes?.length > 0,
        likesCount: p._count.likes,
        commentsCount: p._count.comments,
        userVote: myVote ? myVote.option : null,   // conservé (compat)
        pollResults: pollStats,                     // conservé (compat)
        poll: pollData,                              // 🟢 NOUVEAU : à utiliser dans PollCard
        reactionsCount: p.reactions.length,
        topReactions,
        mediaUrl: toCdnUrl(p.mediaUrl),
        thumbnailUrl: toCdnUrl(p.thumbnailUrl),
        author: {
          ...p.author,
          avatarUrl: toCdnUrl(p.author.avatarUrl)
        },
        votes: undefined
      };
    });

    res.json(formatted);
  } catch (error) {
    console.error("Erreur chargement posts organisation:", error);
    res.status(500).json([]);
  }
});

