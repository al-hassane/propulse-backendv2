// Route : Charger les messages avec filtre de suppression et pagination par curseur
app.get('/conversations/:id/messages', async (req, res) => {
  const { id } = req.params;
  const userId = req.query.userId ? parseInt(req.query.userId) : null;
  const cursor = req.query.cursor ? parseInt(req.query.cursor) : null;
  const limit = parseInt(req.query.limit) || 20;

  try {
    const messages = await prisma.message.findMany({
      where: { 
        conversationId: parseInt(id),
        ...(userId ? {
          deletions: {
            none: { userId: userId }
          }
        } : {})
      },
      orderBy: { createdAt: 'desc' }, 
      take: limit,
      ...(cursor && {
        cursor: { id: cursor },
        skip: 1,
      }),
      include: { 
        sender: { select: { id: true, fullName: true, certifTier: true, avatarUrl: true, certification: { select: { status: true } } } },
        reactions: {
          include: {
            user: { select: { id: true, fullName: true, avatarUrl: true } }
          }
        },
        sharedPost: {
          include: {
            user: { select: { id: true, fullName: true, avatarUrl: true, username: true } }
          }
        },
        sharedAudio: { 
          include: { 
            author: { select: { id: true, fullName: true, avatarUrl: true } },
            posts: { 
              where: { isArchived: false },
              take: 6, 
              select: { imageUrl: true } 
            },
            _count: { select: { posts: true } } 
          } 
        },
        // 1. L'inclusion Prisma (Déjà là)
        sharedOrgPost: {
        include: {
          author: { select: { id: true, fullName: true, avatarUrl: true } },
          organization: { select: { id: true, name: true, logo: true } },
          votes: true,  // 🟢 AJOUT : pour récupérer les votes du sondage
          _count: { select: { likes: true, comments: true, votes: true } }  // 🟢 AJOUT
        }
      },
        replyTo: {
          include: {
            sender: { select: { id: true, fullName: true } },
            sharedPost: true 
          }
        },
        // 🟢🟢🟢 NOUVEAU : Inclusion de la story partagée 🟢🟢🟢
        sharedStory: {
          include: {
            user: { select: { id: true, fullName: true, avatarUrl: true } },
            sharedPost: { select: { id: true, imageUrl: true, mediaType: true } }
          }
        }
        // 🟢🟢🟢 FIN DU NOUVEAU 🟢🟢🟢
      }
    });

    const formattedMessages = messages.map(m => {
      // 🟢🟢🟢 NOUVEAU : Déterminer l'état de la story (active / expired / deleted) 🟢🟢🟢
      let storyState = 'active'; // 'active' | 'expired' | 'deleted'
      let effectiveStory = m.sharedStory;

      if (!effectiveStory) {
        // La story a été supprimée → on tombe sur le snapshot
        storyState = 'deleted';
      } else if (new Date(effectiveStory.expiresAt) < new Date()) {
        // La story est expirée (mais existe encore en BDD)
        storyState = 'expired';
      }
      // 🟢🟢🟢 FIN DU NOUVEAU 🟢🟢🟢

      return {
        ...m,
        mediaUrl: m.mediaUrl ? toCdnUrl(m.mediaUrl) : null,

        // 🟢 AJOUT DU FORMATTAGE CDN POUR LE POST D'ORGANISATION ICI :
        sharedOrgPost: m.sharedOrgPost ? (() => {
        // 🟢 Calcul des stats du sondage
        const options = m.sharedOrgPost.pollOptions || null;
        const myVote = m.sharedOrgPost.votes?.find(v => Number(v.userId) === Number(userId));
        let pollStats = [0, 0];
        let pollData = null;

        if (options && options.length > 0) {
          pollStats = new Array(options.length).fill(0);
          m.sharedOrgPost.votes?.forEach(v => {
            if (v.option >= 0 && v.option < options.length) pollStats[v.option]++;
          });

          pollData = {
            options,
            counts: pollStats,
            totalVotes: pollStats.reduce((a, b) => a + b, 0),
            userVote: myVote ? myVote.option : null,
            endsAt: m.sharedOrgPost.pollEndsAt || null,
          };
        }

        return {
          ...m.sharedOrgPost,
          mediaUrl: m.sharedOrgPost.mediaUrl ? toCdnUrl(m.sharedOrgPost.mediaUrl) : null,
          thumbnailUrl: m.sharedOrgPost.thumbnailUrl ? toCdnUrl(m.sharedOrgPost.thumbnailUrl) : null,
          author: {
            ...m.sharedOrgPost.author,
            avatarUrl: toCdnUrl(m.sharedOrgPost.author.avatarUrl)
          },
          organization: {
            ...m.sharedOrgPost.organization,
            logo: toCdnUrl(m.sharedOrgPost.organization.logo)
          },
          // 🟢 ENRICHISSEMENT SONDAGE
          userVote: myVote ? myVote.option : null,
          pollResults: pollStats,
          poll: pollData,
          votes: undefined,  // on nettoie le tableau brut
          isLiked: m.sharedOrgPost.likes?.length > 0,
          likesCount: m.sharedOrgPost._count?.likes ?? 0,
          commentsCount: m.sharedOrgPost._count?.comments ?? 0,
        };
      })() : null,

        replyTo: m.replyTo ? {
          ...m.replyTo,
          mediaUrl: m.replyTo.mediaUrl ? toCdnUrl(m.replyTo.mediaUrl) : null
        } : null,

        sharedAudio: m.sharedAudio ? {
          ...m.sharedAudio,
          postsCount: m.sharedAudio._count?.posts || 0 
        } : null,

        // 🟢🟢🟢 NOUVEAU : Enrichir la story avec son état + CDN 🟢🟢🟢
        sharedStory: effectiveStory ? {
          ...effectiveStory,
          mediaUrl: effectiveStory.mediaUrl ? toCdnUrl(effectiveStory.mediaUrl) : null,
          owner: effectiveStory.user,   // On renomme 'user' en 'owner' pour le front
          user: undefined,               // On nettoie le champ original
          state: storyState
        } : null,
        storyState: storyState,          // Exposé au niveau racine aussi pour simplicité
        storySnapshot: m.storySnapshot || null
        // 🟢🟢🟢 FIN DU NOUVEAU 🟢🟢🟢
      };
    });

    res.json({
      messages: formattedMessages,
      nextCursor: messages.length === limit
        ? messages[messages.length - 1].id
        : null
    });
  } catch (e) { 
    console.error("Erreur serveur messages:", e);
    res.status(500).json({ messages: [], nextCursor: null }); 
  }
});

