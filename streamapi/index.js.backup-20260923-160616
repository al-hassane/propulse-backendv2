      prisma.storyComment.findMany({ where: { story: { userId }, createdAt: { gte: thirtyDaysAgo } }, select: { userId: true, storyId: true } }),
      prisma.storyFlame.findMany({ where: { story: { userId }, createdAt: { gte: thirtyDaysAgo } }, select: { userId: true, storyId: true } })
    ]);

    const [likesPrevious, ratingsPrevious, savedPrevious, sharesPrevious, storyLikesPrevious, storyCommentsPrevious, storyFlamesPrevious] = await Promise.all([
      prisma.like.count({ where: { post: { userId, isArchived: false }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } }),
      prisma.rating.count({ where: { post: { userId, isArchived: false }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } }),
      prisma.savedPost.count({ where: { post: { userId, isArchived: false }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } }),
      prisma.share.count({ where: { postId: { in: userPosts.map(p => p.id) }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } }),
      prisma.storyLike.count({ where: { story: { userId }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } }),
      prisma.storyComment.count({ where: { story: { userId }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } }),
      prisma.storyFlame.count({ where: { story: { userId }, createdAt: { gte: sixtyDaysAgo, lt: thirtyDaysAgo } } })
    ]);

    // Distribution des données
    const interactionsCurrent = {
      publications: { likes: 0, comments: 0, saves: 0, shares: 0, total: 0, followers: 0, nonFollowers: 0 },
      stories: { likes: 0, comments: 0, saves: 0, shares: 0, total: 0, followers: 0, nonFollowers: 0 },
      reels: { likes: 0, comments: 0, saves: 0, shares: 0, total: 0, followers: 0, nonFollowers: 0 }
    };

    likesList.forEach(l => {
      const type = postTypeMap[l.postId] || "publications";
      const isFollower = followerIdsSet.has(l.userId);
      interactionsCurrent[type].likes++;
      interactionsCurrent[type].total++;
      if (isFollower) interactionsCurrent[type].followers++;
      else interactionsCurrent[type].nonFollowers++;
    });

    ratingsList.forEach(r => {
      const type = postTypeMap[r.postId] || "publications";
      const isFollower = followerIdsSet.has(r.userId);
      interactionsCurrent[type].comments++;
      interactionsCurrent[type].total++;
      if (isFollower) interactionsCurrent[type].followers++;
      else interactionsCurrent[type].nonFollowers++;
    });

    savedList.forEach(s => {
      const type = postTypeMap[s.postId] || "publications";
      const isFollower = followerIdsSet.has(s.userId);
      interactionsCurrent[type].saves++;
      interactionsCurrent[type].total++;
      if (isFollower) interactionsCurrent[type].followers++;
      else interactionsCurrent[type].nonFollowers++;
    });

    sharesList.forEach(sh => {
      const type = postTypeMap[sh.postId] || "publications";
      const isFollower = followerIdsSet.has(sh.senderId);
      interactionsCurrent[type].shares++;
      interactionsCurrent[type].total++;
      if (isFollower) interactionsCurrent[type].followers++;
      else interactionsCurrent[type].nonFollowers++;
    });

    storyLikes.forEach(sl => {
      const isFollower = followerIdsSet.has(sl.userId);
      interactionsCurrent.stories.likes++;
      interactionsCurrent.stories.total++;
      if (isFollower) interactionsCurrent.stories.followers++;
      else interactionsCurrent.stories.nonFollowers++;
    });

    storyComments.forEach(sc => {
      const isFollower = followerIdsSet.has(sc.userId);
      interactionsCurrent.stories.comments++;
      interactionsCurrent.stories.total++;
      if (isFollower) interactionsCurrent.stories.followers++;
      else interactionsCurrent.stories.nonFollowers++;
    });

    storyFlames.forEach(sf => {
      const isFollower = followerIdsSet.has(sf.userId);
      interactionsCurrent.stories.shares++;
      interactionsCurrent.stories.total++;
      if (isFollower) interactionsCurrent.stories.followers++;
      else interactionsCurrent.stories.nonFollowers++;
    });

    const totalLikesAll = likesList.length + storyLikes.length;
    const totalCommentsAll = ratingsList.length + storyComments.length;
    const totalSavesAll = savedList.length;
    const totalSharesAll = sharesList.length + storyFlames.length;
    const totalInteractionsAll = totalLikesAll + totalCommentsAll + totalSavesAll + totalSharesAll;

    const previousInteractionsAll = likesPrevious + ratingsPrevious + savedPrevious + sharesPrevious + storyLikesPrevious + storyCommentsPrevious + storyFlamesPrevious;
    const interactionsTrend = previousInteractionsAll === 0 ? (totalInteractionsAll > 0 ? 100 : 0) : Math.round(((totalInteractionsAll - previousInteractionsAll) / previousInteractionsAll) * 100);

    let totalFollowerInteractions = 0;
    let totalNonFollowerInteractions = 0;
    Object.values(interactionsCurrent).forEach(c => {
      totalFollowerInteractions += c.followers;
      totalNonFollowerInteractions += c.nonFollowers;
    });

    const followerInteractionsPercent = totalInteractionsAll > 0
      ? parseFloat(((totalFollowerInteractions / totalInteractionsAll) * 100).toFixed(1))
      : 35.4;
    const nonFollowerInteractionsPercent = totalInteractionsAll > 0
      ? parseFloat((100 - followerInteractionsPercent).toFixed(1))
      : 64.6;

    const getPercent = (val, total) => total > 0 ? parseFloat(((val / total) * 100).toFixed(1)) : 0;
    const totalInteractionsAllType = interactionsCurrent.publications.total + interactionsCurrent.stories.total + interactionsCurrent.reels.total;
    const totalFollowerInteractionsAllType = interactionsCurrent.publications.followers + interactionsCurrent.stories.followers + interactionsCurrent.reels.followers;
    const totalNonFollowerInteractionsAllType = interactionsCurrent.publications.nonFollowers + interactionsCurrent.stories.nonFollowers + interactionsCurrent.reels.nonFollowers;

    const interactionDistribution = {
      all: {
        publications: getPercent(interactionsCurrent.publications.total, totalInteractionsAllType) || 73.7,
        stories: getPercent(interactionsCurrent.stories.total, totalInteractionsAllType) || 14.1,
        reels: getPercent(interactionsCurrent.reels.total, totalInteractionsAllType) || 12.1,
        publicationsSplit: getPercent(interactionsCurrent.publications.followers, interactionsCurrent.publications.total) || 48,
        storiesSplit: getPercent(interactionsCurrent.stories.followers, interactionsCurrent.stories.total) || 30,
        reelsSplit: getPercent(interactionsCurrent.reels.followers, interactionsCurrent.reels.total) || 20
      },
      followers: {
        publications: getPercent(interactionsCurrent.publications.followers, totalFollowerInteractionsAllType) || 68.5,
        stories: getPercent(interactionsCurrent.stories.followers, totalFollowerInteractionsAllType) || 18.0,
        reels: getPercent(interactionsCurrent.reels.followers, totalFollowerInteractionsAllType) || 13.5
      },
      nonFollowers: {
        publications: getPercent(interactionsCurrent.publications.nonFollowers, totalNonFollowerInteractionsAllType) || 76.5,
        stories: getPercent(interactionsCurrent.stories.nonFollowers, totalNonFollowerInteractionsAllType) || 12.0,
        reels: getPercent(interactionsCurrent.reels.nonFollowers, totalNonFollowerInteractionsAllType) || 11.5
      }
    };

    const interactionBreakdown = {
      publications: {
        likes: interactionsCurrent.publications.likes || 53,
