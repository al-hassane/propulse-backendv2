// Dans server.js - Remplacer la route GET /users/:id/profile-viewers

app.get('/users/:id/profile-viewers', async (req, res) => {
    const userId = parseInt(req.params.id);
    const page = parseInt(req.query.page) || 1;
    const limit = parseInt(req.query.limit) || 15;
    const skip = (page - 1) * limit;
    const thirtyDaysAgo = new Date();
    thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);

    if (isNaN(userId)) {
        return res.status(400).json({ error: "ID invalide" });
    }

    try {
        // 1. Compter le total des vues
        const totalCount = await prisma.profileView.count({
            where: {
                profileOwnerId: userId,
                viewedAt: { gte: thirtyDaysAgo }
            }
        });

        // 2. Récupérer la page demandée
        const views = await prisma.profileView.findMany({
            where: {
                profileOwnerId: userId,
                viewedAt: { gte: thirtyDaysAgo }
            },
            include: {
                viewer: {
                    select: {
                        id: true,
                        fullName: true,
                        avatarUrl: true,
                        role: true,
                        isVerified: true,
                        followedBy: { where: { followerId: userId } }
                    }
                }
            },
            orderBy: { viewedAt: 'desc' },
            take: limit,
            skip: skip
        });

        // 3. Formatage des données
        const results = views.map(v => ({
            id: v.viewer.id,
            name: v.viewer.fullName,
            role: v.viewer.role,
            avatar: v.viewer.avatarUrl,
            isVerified: v.viewer.isVerified,
            followed: v.viewer.followedBy.length > 0,
            viewedAt: v.viewedAt
        }));

        // 4. Renvoyer avec les infos de pagination
        res.json({
            data: results,
            pagination: {
                page: page,
                limit: limit,
                total: totalCount,
                hasMore: skip + results.length < totalCount
            }
        });

    } catch (e) {
        console.error("Erreur profile-viewers paginé:", e);
        res.status(500).json({ 
            data: [],
            pagination: { page: 1, limit: 15, total: 0, hasMore: false }
        });
    }
});

