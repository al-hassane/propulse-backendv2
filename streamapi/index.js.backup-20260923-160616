// --- RÉCUPÉRER LES SUGGESTIONS (ALGORITHME SÉCURISÉ ANTI-BLOCAGE) ---
// --- RÉCUPÉRER LES SUGGESTIONS (ALGORITHME SÉCURISÉ ANTI-BLOCAGE + GÉOLOCALISÉ) ---
app.get('/users/:id/suggestions', async (req, res) => {
  const userId = parseInt(req.params.id);

  try {
    // 1. Récupérer l'utilisateur courant avec TOUTES ses relations de blocage et sa position
    const currentUser = await prisma.user.findUnique({
      where: { id: userId },
      include: {
        following: { select: { followingId: true } },
        dismissedSuggestions: { select: { targetId: true } },
        blockedUsers: { select: { blockedId: true } }, 
        blockedBy: { select: { blockerId: true } }     
      }
    });

    if (!currentUser) return res.json([]);

    // 2. Préparation de la "Liste Noire"
    const alreadyFollowingIds = currentUser.following.map(f => f.followingId);
    const dismissedIds = currentUser.dismissedSuggestions.map(d => d.targetId);
    const blockedIds = currentUser.blockedUsers.map(b => b.blockedId);
    const whoBlockedMeIds = currentUser.blockedBy.map(b => b.blockerId);

    const excludedIds = [
      userId, 
      ...alreadyFollowingIds, 
      ...dismissedIds, 
      ...blockedIds, 
      ...whoBlockedMeIds
    ].filter(Boolean);

    const userSport = currentUser.sport || 'football';
    let suggestions = [];

    // 3. TENTATIVE 1 : "Amis d'amis" (En excluant la liste noire)
    const friendsOfFriends = await prisma.user.findMany({
      where: {
        id: { notIn: excludedIds },
        sport: userSport,
        role: 'joueur',
        followedBy: { some: { followerId: { in: alreadyFollowingIds } } }
      },
      take: 10,
      include: {
        followedBy: {
          where: { followerId: { in: alreadyFollowingIds } },
          take: 2,
          include: {
            follower: {
              select: {
                id: true,
                avatarUrl: true,
                fullName: true
              }
            }
          }
        },
        certification: true
      }
    });
    suggestions.push(...friendsOfFriends);

    // 🟢 TENTATIVE 2 : LES JOUEURS DU MÊME SPORT À PROXIMITÉ (GÉOLOCALISATION)
    if (currentUser.latitude !== null && currentUser.longitude !== null && suggestions.length < 10) {
      const myLat = parseFloat(currentUser.latitude);
      const myLng = parseFloat(currentUser.longitude);
      const currentSuggIds = suggestions.map(s => s.id);

      // On récupère les profils du même sport ayant une position mise à jour
      const nearbyPlayers = await prisma.user.findMany({
        where: {
          id: { notIn: [...excludedIds, ...currentSuggIds] },
          role: 'joueur',
          latitude: { not: null },
          longitude: { not: null }
        },
        take: 20,
        include: { certification: true }
      });

      const toRad = (value) => (value * Math.PI) / 180;
      const R = 6371; // Rayon de la Terre en km
      const nearbyFiltered = [];

      for (const player of nearbyPlayers) {
        const userLat = parseFloat(player.latitude);
        const userLng = parseFloat(player.longitude);
        if (isNaN(userLat) || isNaN(userLng)) continue;

        const dLat = toRad(userLat - myLat);
        const dLon = toRad(userLng - myLng);
        const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                  Math.cos(toRad(myLat)) * Math.cos(toRad(userLat)) *
                  Math.sin(dLon / 2) * Math.sin(dLon / 2);
        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        const distance = R * c;

        if (distance <= 15) { // Filtrage dans un rayon de 15 km
          nearbyFiltered.push({
            ...player,
            distance: parseFloat(distance.toFixed(1)) // Arrondi à 1 chiffre après la virgule
          });
        }
      }

      // Trier du plus proche au plus éloigné et injecter dans les suggestions
      nearbyFiltered.sort((a, b) => a.distance - b.distance);
      suggestions.push(...nearbyFiltered.slice(0, 10 - suggestions.length));
    }

    // 5. TENTATIVE 3 : Populaires du même sport (En excluant la liste noire + déjà suggérés)
    if (suggestions.length < 5) {
        const currentSuggestionIds = suggestions.map(s => s.id);
        const randomPlayers = await prisma.user.findMany({
            where: {
                id: { notIn: [...excludedIds, ...currentSuggestionIds] },
                
                role: 'joueur'
            },
            take: 10 - suggestions.length,
            orderBy: { followedBy: { _count: 'desc' } },
            include: { followedBy: { take: 0 }, certification: true } 
        });
        suggestions.push(...randomPlayers);
    }

    console.log(`🛡️ Suggestions générées pour ${userId} : ${suggestions.length} profils (Géoloc & Bloqués inclus)`);
    res.json(suggestions);

  } catch (e) {
    console.error("❌ Erreur Algorithme Suggestions:", e);
    res.status(500).json({ error: "Erreur suggestions" });
  }
});

