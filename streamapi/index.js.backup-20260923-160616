app.get('/users/:id/posts', async (req, res) => {
  const authorId = parseInt(req.params.id);
  const mediaType = req.query.mediaType;
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 15;
  const skip = (page - 1) * limit;
  const currentUserId = req.query.userId ? parseInt(req.query.userId) : null; // 🟢 Ajout de l'ID pour le suivi

  try {
    // 🟢 CHANGEMENT UNIQUE : filtre direct sur la colonne indexée "mediaType"
    // au lieu de faire un contains/endsWith sur imageUrl (qui ne peut pas utiliser l'index)
    // 🟢 On utilise l'étiquette mediaType au lieu de scanner l'URL
    const typeFilter = mediaType === 'video' ? 'VIDEO' : 'IMAGE';

    const posts = await prisma.post.findMany({
      where: {
        userId: authorId,
        isArchived: false,
        communityId: null,
        mediaType: typeFilter, // 🟢 utilise l'index composite [userId, isArchived, communityId, mediaType, createdAt]
      },
      include: {
        user: { include: { certification: true, followedBy: { where: { followerId: currentUserId || 0 } } } },
        media: true,
        audio: { include: { author: true } }, // 🟢 Modifie ici
        likes: { include: { user: { select: { id: true, fullName: true, avatarUrl: true } } } }, // 🟢 INDISPENSABLE
        ratings: true, // 🟢 INDISPENSABLE
        votes: true,
        _count: { select: { likes: true, ratings: true, votes: true } }
      },
      orderBy: { createdAt: 'desc' },
      take: limit,
      skip: skip,
    });

    const responseData = posts.map(p => {
      // Sécurité : on s'assure que ratings et likes sont des tableaux vides au lieu de undefined
      const currentRatings = Array.isArray(p.ratings) ? p.ratings : [];
      const currentLikes = Array.isArray(p.likes) ? p.likes : [];
      
      const validRatings = currentRatings.filter(r => r.score > 0);
      const avg = validRatings.length > 0 ? validRatings.reduce((acc, r) => acc + r.score, 0) / validRatings.length : 0;
      
      return {
        ...p,
        ratings: currentRatings, // 🟢 On renvoie le tableau complet
        likes: currentLikes,     // 🟢 On renvoie le tableau complet
        imageUrl: toCdnUrl(p.imageUrl),
        audio: p.audio ? { ...p.audio, audioUrl: p.audio.audioUrl } : null,  
        averageRating: avg.toFixed(1),
        pollStats: {
          YES: p.votes?.filter(v => v.option === 'YES').length || 0,
          NO: p.votes?.filter(v => v.option === 'NO').length || 0
        }
      };
    });

    res.json(responseData);
  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Erreur serveur profil" });
  }
});

