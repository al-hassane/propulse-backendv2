// 🟢 ROUTE UNIFIÉE /products AVEC SUPPORT DE SHOP_ID, FILTRES ET PAGINATION ÉLITE
// =========================================================================
app.get('/products', async (req, res) => {
  const { category, search, minPrice, maxPrice, shopId, page, limit } = req.query;

  try {
    const whereClause = {
      isSold: false, // On n'affiche pas les vendus dans le feed principal
      shop: { isActive: true } // Seulement les boutiques ouvertes
    };

    // 🟢 1. FILTRE PAR BOUTIQUE SI SHOP_ID EST FOURNI
    if (shopId) {
      whereClause.shopId = parseInt(shopId);
    }

    if (category && category !== 'ALL') whereClause.category = category;
    
    // Recherche par titre ou marque
    if (search) {
      whereClause.OR = [
        { title: { contains: search, mode: 'insensitive' } }, 
        { brand: { contains: search, mode: 'insensitive' } }
      ];
    }

    if (minPrice || maxPrice) {
        whereClause.price = {};
        if (minPrice) whereClause.price.gte = parseFloat(minPrice);
        if (maxPrice) whereClause.price.lte = parseFloat(maxPrice);
    }

    // 🟢 2. PAGINATION DYNAMIQUE (Si page et limit sont fournis)
    const pageNum = parseInt(page);
    const limitNum = parseInt(limit);
    const usePagination = !isNaN(pageNum) && !isNaN(limitNum);
    const skip = usePagination ? (pageNum - 1) * limitNum : 0;

    const [products, totalCount] = await Promise.all([
      prisma.product.findMany({
        where: whereClause,
        include: {
          images: true,
          shop: { include: { owner: { select: { avatarUrl: true, fullName: true, isVerified: true } } } },
          _count: { select: { likes: true } }
        },
        orderBy: { createdAt: 'desc' },
        take: usePagination ? limitNum : undefined,
        skip: usePagination ? skip : undefined
      }),
      usePagination ? prisma.product.count({ where: whereClause }) : Promise.resolve(0)
    ]);

    const formattedProducts = products.map(p => ({
      ...p,
      imageUrl: toCdnUrl(p.imageUrl),
      images: p.images.map(img => ({ ...img, url: toCdnUrl(img.url) })),
      shop: p.shop ? {
        ...p.shop,
        logo: toCdnUrl(p.shop.logo),
        cover: toCdnUrl(p.shop.cover),
        owner: p.shop.owner ? {
          ...p.shop.owner,
          avatarUrl: toCdnUrl(p.shop.owner.avatarUrl)
        } : p.shop.owner
      } : p.shop
    }));

    if (usePagination) {
      res.json({
        data: formattedProducts,
        pagination: {
          page: pageNum,
          limit: limitNum,
          total: totalCount,
          hasMore: skip + formattedProducts.length < totalCount
        }
      });
    } else {
      res.json(formattedProducts);
    }

  } catch (e) {
    console.error("❌ Erreur unifiée /products:", e);
    res.status(500).json({ error: "Erreur feed shopping" });
  }
});


