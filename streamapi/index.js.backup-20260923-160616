      select: { id: true, userId: true } // On récupère l'id de l'auteur en même temps
    });

    if (!post) {
      return res.status(404).json({ error: "Cette publication n'existe plus." });
    }
    // -----------------------------------------------------------------------

    // On crée la note seulement maintenant qu'on est sûr que le post existe
    const rating = await prisma.rating.create({
      data: { 
        userId: parseInt(userId), 
        postId, 
        score: parseInt(score), 
        comment, 
        parentId: parentId ? parseInt(parentId) : null 
      }
    });

    // Gestion des réponses à un commentaire
    if (parentId) {
      const parentComment = await prisma.rating.findUnique({ where: { id: parseInt(parentId) } });
      if (parentComment) {
        await createNotification("REPLY", userId, parentComment.userId, postId, rating.id, null, comment);
      }
    }

    // Notification à l'auteur du post
    // On ajoute le score pour que la personne sache quelle note elle a reçue
    const messageWithScore = score > 0 ? `(${score}/10) ${comment}` : comment;
    
    await createNotification(
      "COMMENT", 
      parseInt(userId), 
      post.userId, // On utilise post.userId récupéré plus haut
      postId, 
      rating.id, 
      null, 
      messageWithScore
    );

    // Invalider le cache pour que l'IA sache que l'utilisateur a interagi
    if (userId) {
      await invalidateUserCache(userId);
    }

    res.json({ message: "Avis ajouté", rating });

  } catch (error) {
    // --- 🟢 CAPTURE DE L'ERREUR SI LE POST EST SUPPRIMÉ PILE AU MAUVAIS MOMENT ---
    if (error.code === 'P2003') {
      return res.status(404).json({ error: "Publication introuvable." });
    }
    
    console.error("Erreur critique notation:", error);
    res.status(500).json({ error: "Erreur lors de l'envoi de l'avis." });
  }
});
// --- ROUTE PAGINÉE POUR LES COMMENTAIRES (RATINGS) ---
// --- ROUTE OPTIMISÉE : Chargement rapide des commentaires (V2) ---
app.get('/posts/:id/ratings', async (req, res) => {
  const postId = parseInt(req.params.id);
  const page = parseInt(req.query.page) || 1;
  const limit = parseInt(req.query.limit) || 20;
  const skip = (page - 1) * limit;

  try {
    // 🟢 ÉTAPE 1 : Compter le total des commentaires PARENTS (1 requête)
    const totalCount = await prisma.rating.count({
      where: { postId: postId, parentId: null }
    });

    // 🟢 ÉTAPE 2 : Charger les commentaires PARENTS (1 requête)
    const parentRatings = await prisma.rating.findMany({
      where: { postId: postId, parentId: null },
      select: {
        id: true,
        comment: true,
        score: true,
        createdAt: true,
        userId: true,
        postId: true,
        parentId: true,
        // Auteur du commentaire
        user: {
          select: {
            id: true,
            fullName: true,
            avatarUrl: true
          }
        },
        // Likes du commentaire parent
        // (on garde userId pour que le mobile sache si MOI j'ai liké)
        likes: {
          select: {
            id: true,
            userId: true
          }
        }
      },
      orderBy: { createdAt: 'desc' },
      take: limit,
      skip: skip
    });

    const parentIds = parentRatings.map(r => r.id);

    // 🟢 ÉTAPE 3 : Charger TOUTES les réponses en 1 seule requête (1 requête)
    let replies = [];
    if (parentIds.length > 0) {
      replies = await prisma.rating.findMany({
        where: { parentId: { in: parentIds } },
        select: {
          id: true,
          comment: true,
          score: true,
          createdAt: true,
          userId: true,
          postId: true,
          parentId: true,
          user: {
            select: {
              id: true,
              fullName: true,
              avatarUrl: true
            }
          },
          likes: {
            select: {
              id: true,
              userId: true
            }
          }
        },
        orderBy: { createdAt: 'asc' }
      });
    }

    // 🟢 ÉTAPE 4 : Grouper les réponses par parentId (côté Node, pas SQL)
    const repliesByParent = replies.reduce((acc, reply) => {
      if (!acc[reply.parentId]) acc[reply.parentId] = [];
      acc[reply.parentId].push(reply);
      return acc;
    }, {});

    // 🟢 ÉTAPE 5 : Assembler la réponse finale au format exact attendu par le mobile
    const formatted = parentRatings.map(parent => ({
      ...parent,
      likes: parent.likes || [],
      replies: (repliesByParent[parent.id] || []).map(reply => ({
        ...reply,
        likes: reply.likes || []
      }))
    }));

    // 🟢 ÉTAPE 6 : Renvoyer avec la pagination
    res.json({
      data: formatted,
      pagination: {
        page: page,
        limit: limit,
        total: totalCount,
        hasMore: skip + formatted.length < totalCount
      }
    });

  } catch (error) {
    console.error("❌ Erreur récupération ratings paginés:", error);
    res.status(500).json({ error: "Erreur lors de la récupération" });
  }
});

