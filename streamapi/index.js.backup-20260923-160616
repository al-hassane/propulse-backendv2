// --- MISE À JOUR DU MOT DE PASSE ---
app.put('/users/:id/password', async (req, res) => {
  const { id } = req.params;
  const { currentPassword, newPassword } = req.body;

  try {
    // 1. On récupère l'utilisateur pour avoir son mot de passe actuel crypté
    const user = await prisma.user.findUnique({ where: { id: parseInt(id) } });

    if (!user) return res.status(404).json({ error: "Utilisateur introuvable" });

    // 2. On compare le mot de passe tapé avec celui en base
    const isMatch = await bcrypt.compare(currentPassword, user.password);

    if (!isMatch) {
      return res.status(401).json({ error: "L'ancien mot de passe est incorrect." });
    }

    // 3. On crypte le NOUVEAU mot de passe
    const hashedNewPassword = await bcrypt.hash(newPassword, 10);

    // 4. On met à jour
    await prisma.user.update({
      where: { id: parseInt(id) },
      data: { password: hashedNewPassword }
    });

    res.json({ message: "Mot de passe modifié avec succès !" });

  } catch (error) {
    console.error(error);
    res.status(500).json({ error: "Erreur serveur" });
  }
});


