// 🔔 WEBHOOK APPLE : NOTIFICATIONS SERVEUR (V2)
// ============================================================
const APPLE_BUNDLE_ID = 'com.tonnom.propulse';
const APPLE_APP_ID = 6760557228; // Ton ASC App ID
const appleRootCAs = [fs.readFileSync(path.join(__dirname, 'certs', 'AppleRootCA-G3.cer'))];

const prodVerifier = new SignedDataVerifier(appleRootCAs, true, Environment.PRODUCTION, APPLE_BUNDLE_ID, APPLE_APP_ID);
const sandboxVerifier = new SignedDataVerifier(appleRootCAs, true, Environment.SANDBOX, APPLE_BUNDLE_ID);

async function verifyNotification(signedPayload) {
  try {
    return { notification: await prodVerifier.verifyAndDecodeNotification(signedPayload), isProd: true };
  } catch (e) {
    return { notification: await sandboxVerifier.verifyAndDecodeNotification(signedPayload), isProd: false };
  }
}

app.post('/api/payment/apple-notifications', async (req, res) => {
  try {
    const { signedPayload } = req.body;
    if (!signedPayload) {
      return res.status(400).send('Missing signedPayload');
    }

    const { notification, isProd } = await verifyNotification(signedPayload);
    const notificationType = notification.notificationType;
    const subtype = notification.subtype;

    console.log(`🔔 [Apple] ${notificationType}${subtype ? ' / ' + subtype : ''} (${isProd ? 'PROD' : 'SANDBOX'})`);

    const data = notification.data;
    if (!data || !data.signedTransactionInfo) {
      console.log('⚠️ [Apple] Pas de transactionInfo dans la notification, ignorée.');
      return res.status(200).send('OK');
    }

    const verifier = isProd ? prodVerifier : sandboxVerifier;
    const transactionInfo = await verifier.verifyAndDecodeTransaction(data.signedTransactionInfo);

    const originalTransactionId = String(transactionInfo.originalTransactionId);
    const newExpiryDate = transactionInfo.expiresDate ? new Date(transactionInfo.expiresDate) : null;

    const cert = await prisma.playerCertification.findFirst({
      where: { originalTransactionId }
    });

    if (!cert) {
      console.log(`⚠️ [Apple] Aucun utilisateur trouvé pour originalTransactionId=${originalTransactionId}`);
      return res.status(200).send('OK');
    }

    switch (notificationType) {
      case 'DID_RENEW':
        await prisma.playerCertification.update({
          where: { userId: cert.userId },
          data: { status: 'APPROVED', paymentStatus: true, expiryDate: newExpiryDate }
        });
        await prisma.user.update({
          where: { id: cert.userId },
          data: { isVerified: true }
        });
        console.log(`✅ [Apple] Renouvellement OK - user ${cert.userId}, expire le ${newExpiryDate}`);
        break;

      case 'EXPIRED':
      case 'DID_FAIL_TO_RENEW':
      case 'GRACE_PERIOD_EXPIRED':
        await prisma.playerCertification.update({
          where: { userId: cert.userId },
          data: { status: 'EXPIRED', paymentStatus: false }
        });
        await prisma.user.update({
          where: { id: cert.userId },
          data: { isVerified: false, certifTier: null }
        });
        console.log(`⛔ [Apple] Abonnement expiré/non renouvelé - user ${cert.userId}`);
        break;

      case 'REFUND':
      case 'REVOKE':
        await prisma.playerCertification.update({
          where: { userId: cert.userId },
          data: { status: 'REVOKED', paymentStatus: false }
        });
        await prisma.user.update({
          where: { id: cert.userId },
          data: { isVerified: false, certifTier: null }
        });
        console.log(`↩️ [Apple] Remboursement/révocation - user ${cert.userId}`);
        break;

      default:
        console.log(`ℹ️ [Apple] Type non géré: ${notificationType}`);
    }

    res.status(200).send('Notification received');
  } catch (error) {
    console.error("❌ [Apple] Erreur Webhook:", error.message);
    res.status(200).send('OK');
  }
});


