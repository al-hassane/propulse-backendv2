// Cache des posts populaires pour les nouveaux utilisateurs (Cold Start instantané)
let globalPopularCache = null;
let lastPopularCacheUpdate = 0;
const POPULAR_CACHE_TTL = 300; // 5 minutes

async function getGlobalPopularPosts(sport = null, limit = 15) {
  const now = Date.now();
  
  // Rafraîchir le cache toutes les 5 minutes
  if (!globalPopularCache || (now - lastPopularCacheUpdate) > POPULAR_CACHE_TTL * 1000) {
    try {
      const sevenDaysAgo = new Date();
      sevenDaysAgo.setDate(sevenDaysAgo.getDate() - 7);
      
      const popularPosts = await prisma.post.findMany({
        where: {
          createdAt: { gte: sevenDaysAgo },
          isArchived: false,
          communityId: null,
          ...(sport && sport !== 'ALL' ? { sport } : {})
        },
        orderBy: { likes: { _count: 'desc' } },
        take: 100,
        select: { id: true }
      });
      
      globalPopularCache = popularPosts.map(p => p.id);
      lastPopularCacheUpdate = now;
      console.log(`📊 Cache populaire global mis à jour: ${globalPopularCache.length} posts`);
    } catch (err) {
      console.log("⚠️ Erreur cache populaire:", err.message);
      if (!globalPopularCache) globalPopularCache = [];
    }
  }
  
  // Retourner les premiers 'limit' posts
  return globalPopularCache.slice(0, limit);
}

