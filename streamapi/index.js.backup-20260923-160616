// --- [ADMIN] SUPPRESSION TOTALE ET PROPRE D'UN POST (FIXÉ PAR LE CTO) ---
app.delete('/admin/posts/:id', async (req, res) => {
  const { id } = req.params;
  const postId = parseInt(id);

  try {
    // 1. On vérifie si le post existe (Utile pour renvoyer un 404 propre en temps normal)
    const post = await prisma.post.findUnique({ where: { id: postId } });
    if (!post) return res.status(404).json({ error: "Post introuvable" });

    // 2. TRANSACTION ATOMIQUE : On nettoie toutes les dépendances
    await prisma.$transaction([
      prisma.pollVote.deleteMany({ where: { postId } }),
      prisma.like.deleteMany({ where: { postId } }),
      prisma.savedPost.deleteMany({ where: { postId } }),
      prisma.hiddenPost.deleteMany({ where: { postId } }),
      prisma.report.deleteMany({ where: { postId } }),
      prisma.notification.deleteMany({ where: { postId } }),
      prisma.ratingLike.deleteMany({ where: { rating: { postId: postId } } }),
      prisma.rating.deleteMany({ where: { postId } }),
      prisma.duel.deleteMany({ where: { OR: [{ post1Id: postId }, { post2Id: postId }] } }),

      // 🟢 LE FIX : On utilise deleteMany au lieu de delete. 
      // Si le post a disparu entre temps, cette ligne ne fera rien au lieu de faire planter le serveur.
      prisma.post.deleteMany({ where: { id: postId } }),
    ]);

    console.log(`🗑️ Post ${postId} supprimé ou déjà absent.`);
    res.json({ message: "La publication et toutes ses données liées ont été supprimées." });

  } catch (error) {
    console.error("ERREUR SUPPRESSION POST ADMIN:", error);
    res.status(500).json({ 
      error: "Erreur serveur lors de la suppression.",
      details: error.message 
    });
  }
});

