app.put('/chat-tabs/:id', async (req, res) => {
  const tabId = parseInt(req.params.id);
  const { userId, name, addConversationIds, removeConversationIds } = req.body;

  try {
    // 🛡️ Vérifier que l'onglet appartient bien à l'utilisateur
    const tab = await prisma.chatTab.findUnique({
      where: { id: tabId }
    });

    if (!tab) return res.status(404).json({ error: "Onglet introuvable" });
    if (tab.userId !== parseInt(userId)) {
      return res.status(403).json({ error: "Non autorisé" });
    }

    // 🟢 Construction dynamique de l'update
    let updateData = {};
    
    // Renommer
    if (name && name.trim() !== "") {
      updateData.name = name.trim();
    }

    // Ajouter des conversations
    if (Array.isArray(addConversationIds) && addConversationIds.length > 0) {
      updateData.conversations = {
        connect: addConversationIds.map(id => ({ id: parseInt(id) }))
      };
    }

    // Retirer des conversations
    if (Array.isArray(removeConversationIds) && removeConversationIds.length > 0) {
      updateData.conversations = {
        ...(updateData.conversations || {}),
        disconnect: removeConversationIds.map(id => ({ id: parseInt(id) }))
      };
    }

    const updatedTab = await prisma.chatTab.update({
      where: { id: tabId },
      data: updateData,
      include: {
        conversations: {
          select: { id: true }
        }
      }
    });

    console.log(`✏️ Onglet #${tabId} modifié par user ${userId}`);
    res.json(updatedTab);

  } catch (error) {
    console.error("❌ Erreur modification onglet:", error);
    res.status(500).json({ error: "Erreur lors de la modification" });
  }
});

