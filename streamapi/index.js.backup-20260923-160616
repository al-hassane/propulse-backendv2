// [ADMIN] ROUTE UNIQUE : Mise à jour infos + Chrono + Classement
app.post('/admin/matches/:id/finish', async (req, res) => {
  const matchId = parseInt(req.params.id);
  const { homeScore, awayScore, status, stadium, homeTeamId, awayTeamId } = req.body;

  try {
    // 1. On récupère l'état actuel du match en BDD pour le calcul du chrono
    const currentMatch = await prisma.match.findUnique({ where: { id: matchId } });
    if (!currentMatch) return res.status(404).json({ error: "Match non trouvé" });

    // 2. Préparation de l'objet de mise à jour
    const updateData = {};
    if (status) updateData.status = status;
    if (stadium) updateData.stadium = stadium;
    if (homeTeamId) updateData.homeTeamId = parseInt(homeTeamId);
    if (awayTeamId) updateData.awayTeamId = parseInt(awayTeamId);
    if (homeScore !== undefined) updateData.homeScore = parseInt(homeScore);
    if (awayScore !== undefined) updateData.awayScore = parseInt(awayScore);

    // 3. LOGIQUE DU CHRONOMÈTRE PERSISTANT
    if (status === 'LIVE') {
      // On démarre ou on reprend : on enregistre le nouveau point de départ
      updateData.startTime = new Date();
    } 
    else if (status === 'HALF_TIME' || status === 'FINISHED') {
      // On met en pause ou on termine : on calcule le temps écoulé depuis le dernier "LIVE"
      if (currentMatch.startTime) {
        const sessionSeconds = Math.floor((new Date() - new Date(currentMatch.startTime)) / 1000);
        // On ajoute ce temps au cumul déjà existant
        updateData.elapsedSeconds = currentMatch.elapsedSeconds + sessionSeconds;
      }
      updateData.startTime = null; // On arrête le décompte
    }

    // 4. Exécution de la mise à jour
    const match = await prisma.match.update({
      where: { id: matchId },
      data: updateData,
      include: { homeTeam: true, awayTeam: true }
    });

    // 5. LOGIQUE DE CALCUL DES POINTS (Uniquement si le statut passe à FINISHED)
    if (status === "FINISHED") {
      const hScore = match.homeScore;
      const aScore = match.awayScore;

      const updateStats = async (teamId, goalsFor, goalsAgainst, points) => {
        await prisma.standing.upsert({
          where: { ascId_zoneId: { ascId: teamId, zoneId: match.zoneId } },
          update: {
            played: { increment: 1 },
            won: { increment: points === 3 ? 1 : 0 },
            drawn: { increment: points === 1 ? 1 : 0 },
            lost: { increment: points === 0 ? 1 : 0 },
            goalsFor: { increment: goalsFor },
            goalsAgainst: { increment: goalsAgainst },
            points: { increment: points }
          },
          create: {
            ascId: teamId, zoneId: match.zoneId, played: 1,
            won: points === 3 ? 1 : 0, drawn: points === 1 ? 1 : 0, lost: points === 0 ? 1 : 0,
            goalsFor, goalsAgainst, points
          }
        });
      };

      if (hScore > aScore) {
        await updateStats(match.homeTeamId, hScore, aScore, 3);
        await updateStats(match.awayTeamId, aScore, hScore, 0);
      } else if (aScore > hScore) {
        await updateStats(match.homeTeamId, hScore, aScore, 0);
        await updateStats(match.awayTeamId, aScore, hScore, 3);
      } else {
        await updateStats(match.homeTeamId, hScore, aScore, 1);
        await updateStats(match.awayTeamId, aScore, hScore, 1);
      }
      return res.json({ message: "Match clôturé et classement mis à jour !", match });
    }

    // Réponse pour LIVE ou HALF_TIME
    res.json({ message: "Match mis à jour !", match });

  } catch (e) {
    console.error("Erreur serveur finish route:", e);
    res.status(500).json({ error: "Erreur lors de la mise à jour." });
  }
});

