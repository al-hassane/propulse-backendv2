async function invalidateUserCache(userId) {
  if (redisClient && userId) {
    try {
      await redisClient.del(`ai:user:${userId}`);
      await redisClient.del(`cursor:user:${userId}`); // NOUVEAU
      console.log(`🗑️ Cache + curseur réinitialisés pour user ${userId}`);
    } catch (err) {
      console.log(`⚠️ Erreur invalidation cache user ${userId}:`, err.message);
    }
  }
}


async function createNotification(type, senderId, receiverId, postId = null, ratingId = null, eventId = null, message = null, storyId = null, newsId = null, communityId = null, conversationId = null, trainingId = null, orgPostId = null, organizationId = null) {
  // 1. SÉCURITÉ : On ne s'envoie pas de notification à soi-même (sauf pour les victoires de Duels)
  if (type !== "DUEL_WIN" && parseInt(senderId) === parseInt(receiverId)) return; 

  try {
    // 2. ENREGISTREMENT EN BASE DE DONNÉES (PRISMA)
    let notification = null;
   if (type !== 'MESSAGE') {
    notification = await prisma.notification.create({
       data: { 
        type, 
        senderId: parseInt(senderId), 
        receiverId: parseInt(receiverId), 
        postId: postId ? parseInt(postId) : null, 
        orgPostId: orgPostId ? parseInt(orgPostId) : null, // 🟢 NOUVEAU CHAMP
        ratingId: ratingId ? parseInt(ratingId) : null,
        eventId: eventId ? parseInt(eventId) : null,
        storyId: storyId ? parseInt(storyId) : null,
        newsId: newsId ? parseInt(newsId) : null, 
        communityId: communityId ? parseInt(communityId) : null, 
         organizationId: organizationId ? parseInt(organizationId) : null, // 🟢 NOUVEAU CHAMP
        trainingId: trainingId ? parseInt(trainingId) : null, // 🟢 ON ENREGISTRE L'ID ICI
        message: message
      },
      include: { 
        sender: true,
        post: true,
        orgPost: true, // 🟢 On l'inclut pour l'image push
        event: true,
        story: true,
        community: true,
        organization: true, // 🟢 On l'inclut
        training: true // 🟢 On l'inclut aussi ici 
      }
    });
}

    // 3. RÉCUPÉRATION DU TOKEN PUSH DE L'UTILISATEUR
    const receiver = await prisma.user.findUnique({
      where: { id: parseInt(receiverId) },
      select: { pushToken: true }
    });

     // --- 🟢 AJOUT DU CTO : COMPTER LES NOTIFS NON LUES POUR LE BADGE IOS ---
      // --- 🟢 COMPTER NOTIFS + MESSAGES POUR LE BADGE ---
    const [unreadNotifs, unreadMessages] = await Promise.all([
      prisma.notification.count({ where: { receiverId: parseInt(receiverId), isRead: false } }),
      prisma.message.count({ 
        where: { 
          conversation: { OR: [{ user1Id: parseInt(receiverId) }, { user2Id: parseInt(receiverId) }] },
          senderId: { not: parseInt(receiverId) },
          isRead: false, isDeleted: false
        } 
      })
    ]);
    const totalBadgeCount = unreadNotifs + unreadMessages;
    // -----------------------------------------------------------------------

    // 4. SI L'UTILISATEUR A UN TOKEN VALIDE, ON ENVOIE LE PUSH (EXPO)
    if (receiver?.pushToken && Expo.isExpoPushToken(receiver.pushToken)) {
      let body = "";

      // Juste avant le switch (type)
      const sender = await prisma.user.findUnique({ where: { id: parseInt(senderId) } });
      const senderName = sender?.fullName || "ProPulse";

      // --- LOGIQUE DES MESSAGES (SWITCH POUR PLUS DE PROPRETÉ) ---
